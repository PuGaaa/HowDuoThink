<template>
  <view :class="locked ? 'cubecube cubecube--locked' : 'cubecube cubecube--' + accent" @click="$emit('tap')">
    <view class="cubecube__head">
      <view class="cubecube__no">
        <text :class="locked ? 'cubecube__no-text cubecube__no-text--locked' : 'cubecube__no-text cubecube__no-text--' + accent">{{ chapterNo }}</text>
      </view>
      <view class="cubecube__deco">
        <image v-if="!locked" class="cubecube__spark" :src="sparkSrc" mode="aspectFit"></image>
        <image v-if="!locked" class="cubecube__mag" :src="magSrc" mode="aspectFit"></image>
        <image v-else class="cubecube__lock" src="/static/icons/v4/lock-muted-diy.png" mode="aspectFit"></image>
      </view>
    </view>
    <text class="cubecube__name" max-lines="1">{{ name }}</text>
    <view v-if="!locked" class="cubecube__foot">
      <view class="cubecube__track">
        <view :class="'cubecube__fill cubecube__fill--' + accent" :style="'width:' + fillPct + '%'"></view>
      </view>
      <text class="cubecube__count">{{ solved }}/{{ total }}</text>
    </view>
    <image v-else class="cubecube__orbit" src="/static/icons/v4/orbit-muted.png" mode="aspectFit"></image>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'

const props = defineProps({
  /** 章 id */
  id: { type: String, default: '' },
  chapterNo: { type: String, default: '' },
  name: { type: String, default: '' },
  solved: { type: Number, default: 0 },
  total: { type: Number, default: 0 },
  /** 篇 id：决定积木色系 apprentice/engineer/master，图标与进度条随篇色 */
  accent: { type: String, default: 'apprentice' },
  /** 锁定态：置灰 + 锁图标 + 虚线轨道装饰 */
  locked: { type: Boolean, default: false },
})

const fillPct = computed((): number => {
  if (props.total <= 0) return 0
  return Math.round((props.solved * 100) / props.total)
})

/** 激活块装饰图标随篇色：apprentice 橙 / engineer 绿 / master 蓝 */
const magSrc = computed((): string => {
  if (props.accent === 'engineer') return '/static/icons/v4/magnifier-green-diy.png'
  if (props.accent === 'master') return '/static/icons/v4/magnifier-blue-diy.png'
  return '/static/icons/v4/magnifier-orange-diy.png'
})
const sparkSrc = computed((): string => {
  if (props.accent === 'engineer') return '/static/icons/v4/sparkles-green-diy.png'
  if (props.accent === 'master') return '/static/icons/v4/sparkles-blue-diy.png'
  return '/static/icons/v4/magic-sparkles.png'
})
</script>

<style>
/* 章积木组件：激活态 = 篇色浅底 + 随篇色的图标/进度条；锁定态 = 浅灰 + 锁 + 角落虚线轨道。
   定高保证同行/跨篇方块尺寸一致。 */
.cubecube {
  position: relative;
  display: flex;
  flex-direction: column;
  /* 一行两块：part__body 是 space-between + wrap，用百分比自适应 */
  width: 46%;
  height: 190rpx;
  border-radius: 24rpx;
  border-width: 2rpx;
  border-style: solid;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.cubecube--apprentice {
  background-color: #FFF3E9;
  border-color: #FFD9BC;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #F5C79C;
}
.cubecube--engineer {
  background-color: #EFF9F3;
  border-color: #BFE8D2;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #ABDFC5;
}
.cubecube--master {
  background-color: #EDF5FD;
  border-color: #C6DEF4;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #B9D7F0;
}
.cubecube--locked {
  background-color: #F4F0EC;
  border-color: #EFE9E4;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #E0D7CE;
}
.cubecube__head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.cubecube__no {
  background-color: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  align-self: flex-start;
}
.cubecube__no-text {
  font-size: 20rpx;
  font-weight: bold;
}
.cubecube__no-text--apprentice {
  color: #FF7047;
}
.cubecube__no-text--engineer {
  color: #2FA97C;
}
.cubecube__no-text--master {
  color: #4A90D9;
}
.cubecube__no-text--locked {
  color: #A29EAC;
}
.cubecube__deco {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.cubecube__spark {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}
.cubecube__mag {
  width: 40rpx;
  height: 40rpx;
}
.cubecube__lock {
  width: 36rpx;
  height: 36rpx;
}
.cubecube__name {
  font-size: 32rpx;
  font-weight: bold;
  color: #303343;
  margin-top: 16rpx;
  text-overflow: ellipsis;
  overflow: hidden;
}
.cubecube__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: auto;
}
.cubecube__track {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background-color: rgba(255, 255, 255, 0.85);
}
.cubecube__fill--apprentice {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #FF7047;
}
.cubecube__fill--engineer {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #2FA97C;
}
.cubecube__fill--master {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #4A90D9;
}
.cubecube__count {
  font-size: 22rpx;
  font-weight: bold;
  color: #303343;
  margin-left: 12rpx;
}
.cubecube__orbit {
  position: absolute;
  right: 14rpx;
  bottom: 10rpx;
  width: 64rpx;
  height: 40rpx;
}
</style>
