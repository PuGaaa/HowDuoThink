<template>
  <view class="actwrap">
    <view :class="done ? 'act act--done' : 'act'" @click="$emit('tap')">
      <view class="act__main">
        <view class="act__headrow">
          <text :class="done ? 'act__name act__name--done' : 'act__name'">{{ name }}</text>
          <view v-if="danger" class="act__danger">
            <text class="act__danger-text">变更</text>
          </view>
        </view>
        <text class="act__desc">{{ desc }}</text>
      </view>
      <view class="act__cost">
        <image class="act__bolt" src="/static/icons/bolt-coral.png" mode="aspectFit"></image>
        <text class="act__cost-num">{{ cost }}</text>
        <text v-if="done" class="act__done">已执行 ✓</text>
      </view>
    </view>
    <evidence-card v-if="done && ev != null" variant="inline" :type="ev!.type" :title="ev!.title" :text="ev!.text"></evidence-card>
  </view>
</template>

<script setup lang="uts">
const props = defineProps({
  name: { type: String, default: '' },
  desc: { type: String, default: '' },
  cost: { type: Number, default: 1 },
  danger: { type: Boolean, default: false },
  /** 已执行：整行降透明度并内嵌证据 */
  done: { type: Boolean, default: false },
  /** 执行后产生的证据（未执行时为 null） */
  ev: { type: Object as any, default: null },
})

defineEmits(['tap'])
</script>

