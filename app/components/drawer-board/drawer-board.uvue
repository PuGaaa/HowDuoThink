  display: flex;
  flex-direction: row;
  background-color: #FBF3EB;
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 16rpx;
}
.danchor__text {
  font-size: 20rpx;
  color: #7A7290;
  flex: 1;
}
.dscroll {
  flex: 1;
}
.hyp {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  background-color: #FFFFFF;
  border-bottom-width: 5rpx; border-bottom-style: solid; border-bottom-color: #EFE5D6;
}
.hyp--on {
  border-color: #FF8A5C;
  background-color: #FFF1E7;
}
.hyp__box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #E3E6EB;
  margin-right: 18rpx;
}
.hyp__box--on {
  background-color: #FF8A5C;
  border-color: #FF8A5C;
}
.hyp__check {
  width: 34rpx;
  height: 34rpx;
}
.hyp__text {
  font-size: 25rpx;
  color: #7A7290;
  line-height: 38rpx;
  flex: 1;
}
.hyp__text--on {
  color: #4A4458;
  font-weight: 500;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 22rpx;
  margin-top: 18rpx;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
</style>
