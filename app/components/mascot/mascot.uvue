<template>
  <view :class="cls" @click="$emit('dismiss')">
    <view class="mascot__badge">
      <image v-if="imgUrl.length > 0" class="mascot__avatar" :src="imgUrl" mode="aspectFit"></image>
      <text v-else class="mascot__emoji">{{ emoji }}</text>
    </view>
    <text class="mascot__line">{{ line }}</text>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { getMascotUrl } from '../../utils/remote-assets'

defineEmits(['dismiss'])

const props = defineProps({
  show: { type: Boolean, default: false },
  who: { type: String, default: 'frog' },
  line: { type: String, default: '' },
  /** 抽屉打开时抬升，避免压住抽屉底部确认按钮 */
  raised: { type: Boolean, default: false },
})

// 资源未派发时的 emoji 降级（吉祥物图走后端派发，包内不再带图）
const EMOJI: Record<string, string> = {
  frog: '🐸',
  snail: '🐌',
  otter: '🦦',
  rabbit: '🐰',
  dino: '🦖',
}

const imgUrl = computed((): string => {
  return getMascotUrl(props.who)
})

const emoji = computed((): string => {
  const e = EMOJI[props.who]
  return e == null ? '🐸' : e
})

const visible = computed((): boolean => {
  return props.show && props.who.length > 0
})

const cls = computed((): string => {
  let c = visible.value ? 'mascot' : 'mascot mascot--hidden'
  if (props.raised) c = c + ' mascot--raised'
  return c
})
</script>

<style>
/* 内心小动物气泡：悬浮弹窗（动效规范第 3 条），不占内容流 */
.mascot {
  position: fixed;
  bottom: 140rpx;
  left: 24rpx;
  right: 24rpx;
  margin-left: auto;
  margin-right: auto;
  max-width: 432rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFF6DE;
  border-radius: 24rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #F2D98C;
  padding: 16rpx 22rpx;
  opacity: 1;
  /* 动画暂移除：蒸汽模式 @keyframes/transition 为 HBuilderX 5.33 新特性，
     iOS 真机在 mascot 显示→隐藏切换时 UNIAPP_DOM 线程 SIGSEGV（见 unpackage/logs），
     待引擎修复后再恢复弹出动效 */
  /* 高于抽屉(97)/遮罩(96)：选错反馈从抽屉上方弹出（低于 confirm-dialog 998） */
  z-index: 98;
  border-bottom-width: 8rpx; border-bottom-style: solid; border-bottom-color: #E8D49A;
}
.mascot--hidden {
  opacity: 0;
  pointer-events: none;
}
.mascot--raised {
  /* 抽屉打开时抬升：越过抽屉底部确认按钮顶缘（约 266rpx），压在列表区上方 */
  bottom: 300rpx;
}
.mascot__badge {
  width: 72rpx;
  height: 72rpx;
  /* border-radius: 36rpx; */
  /* background-color: #FFFFFF; */
  /* border-width: 1rpx; */
  /* border-style: solid; */
  /* border-color: #F2D98C; */
  margin-right: 18rpx;
}
.mascot__avatar {
  width: 72rpx;
  height: 72rpx;
}
.mascot__emoji {
  width: 72rpx;
  height: 72rpx;
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
}
.mascot__line {
  font-size: 26rpx;
  color: #8A6D1F;
  font-weight: 500;
  flex: 1;
  line-height: 38rpx;
}
</style>
