<template>
  <view class="navbar" :style="{ top: topStyle }">
    <!-- #ifdef APP-IOS -->
    <!-- 真玻璃返回键：iOS 26 液态玻璃，26 以下自动降级系统毛玻璃（glass-effect-view 仅 iOS 支持） -->
    <view class="navbar__shadowwrap">
      <glass-effect-view class="navbar__glass" glass-style="regular" :interactive="true" @click="back">
        <view class="navbar__center">
          <image class="navbar__chevron" src="/static/icons/chevl-ink.png" mode="aspectFit"></image>
        </view>
      </glass-effect-view>
    </view>
    <!-- #endif -->
    <!-- #ifndef APP-IOS -->
    <!-- CSS 降级胶囊：Web/Android 用 backdrop-filter 模拟玻璃（官方认可的降级方案） -->
    <view class="navbar__shadowpad">
      <view class="navbar__capsule" @click="back">
        <image class="navbar__chevron" src="/static/icons/chevl-ink.png" mode="aspectFit"></image>
      </view>
    </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
// uvue 原生端不支持 var(--status-bar-height)：top 用 JS 取状态栏高度绑定（16rpx≈8px 间距）
const topStyle = uni.getWindowInfo().statusBarHeight + 8 + 'px'

function back() {
  const depth = getCurrentPages().length
  if (depth > 1) {
    uni.navigateBack({ delta: 1, fail: () => uni.reLaunch({ url: '/pages/index/index' }) })
  } else {
    uni.reLaunch({ url: '/pages/index/index' })
  }
}
</script>

<style>
.navbar {
  position: fixed;
  left: 24rpx;
  z-index: 100;
}
.navbar__chevron {
  width: 36rpx;
  height: 36rpx;
}
/* #ifdef APP-IOS */
/* 返回键无阴影：玻璃容器等形外层仅承担布局 */
.navbar__shadowwrap {
  width: 80rpx;
  border-radius: 40rpx;
}
.navbar__glass {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}
.navbar__center {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
/* #endif */
/* #ifndef APP-IOS */
.navbar__capsule {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.72);
  border-width: 1rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(20rpx);
}
/* #endif */
</style>
