<template>
  <view class="dbody">
    <scroll-view class="dscroll" direction="vertical">
      <view class="checklist">
        <view class="checklist__head" @click="$emit('toggle-check')">
          <text class="checklist__title">指认前核对：我的检查单（{{ collected.length }}）</text>
          <text class="checklist__chev">{{ checklistOpen ? '⌃' : '⌄' }}</text>
        </view>
        <view v-if="checklistOpen">
          <view v-for="(cl, i) in collected" :key="'cl' + i" class="checklist__item">
            <text class="checklist__item-text">✓ {{ cl.text }}</text>
            <text class="checklist__item-src">{{ cl.src }}</text>
          </view>
          <view v-if="collected.length == 0" class="checklist__empty">
            <text class="checklist__empty-text">还没有收集的检查单——破案后会在这里积累</text>
          </view>
        </view>
      </view>
      <view v-if="wrongCount > 0" class="reguide">
        <text class="reguide__text">垂耳兔：你的证据链指向了别处。回假设板重新推演，或者再看一遍证据。</text>
        <view class="reguide__btn" @click="$emit('go-board')">
          <text class="reguide__btn-text">回假设板</text>
        </view>
      </view>
      <view v-for="(c, i) in causes" :key="c.id" class="cause" @click="$emit('pick', c.id)">
        <view :class="picked === c.id ? 'cause__dot cause__dot--on' : 'cause__dot'"></view>
        <text class="cause__text">{{ c.text }}</text>
      </view>
      <text class="dnote">垂耳兔提醒：咬合的证据链比答案本身值钱</text>
    </scroll-view>
    <view class="primarybtn" @click="$emit('submit')">
      <text class="primarybtn__text">就是它！</text>
    </view>
  </view>
</template>

<script setup lang="uts">
const props = defineProps({
  /** 根因池（已乱序，RootCauseOption[]） */
  causes: { type: Array as any, default: (): any[] => [] },
  /** 当前圈选的根因 id */
  picked: { type: String, default: '' },
  /** 已收集检查单（CollectedLesson[]） */
  collected: { type: Array as any, default: (): any[] => [] },
  checklistOpen: { type: Boolean, default: false },
  wrongCount: { type: Number, default: 0 },
})

defineEmits(['pick', 'toggle-check', 'submit', 'go-board'])
</script>

