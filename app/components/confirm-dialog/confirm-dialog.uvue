  margin-top: 18rpx;
}
.cdlg__row {
  display: flex;
  flex-direction: row;
  margin-top: 32rpx;
  /* 硬边阴影缓冲 */
  padding-bottom: 8rpx;
}
.cdlg__btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 46rpx;
  padding: 20rpx;
}
.cdlg__btn--main {
  background-color: #FF8A5C;
  box-shadow: 0 8rpx 0 0 #E06B38;
  margin-left: 16rpx;
}
.cdlg__btn--danger {
  background-color: #E86A6A;
  box-shadow: 0 8rpx 0 0 #C24E4E;
  margin-left: 16rpx;
}
.cdlg__btn--ghost {
  background-color: #FFFFFF;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
}
.cdlg__main-text {
  font-size: 27rpx;
