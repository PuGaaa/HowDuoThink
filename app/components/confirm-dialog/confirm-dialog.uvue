<template>
  <view v-if="show" class="cdlg-mask" @click="$emit('cancel')"></view>
  <view v-if="show" class="cdlg-wrap">
    <view class="cdlg">
      <text class="cdlg__title">{{ title }}</text>
      <text class="cdlg__msg">{{ message }}</text>
      <view class="cdlg__row">
        <view class="cdlg__btn cdlg__btn--ghost" @click="$emit('cancel')">
          <text class="cdlg__ghost-text">{{ cancelText }}</text>
        </view>
        <view :class="danger ? 'cdlg__btn cdlg__btn--danger' : 'cdlg__btn cdlg__btn--main'" @click="$emit('confirm')">
          <text class="cdlg__main-text">{{ confirmText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
const props = defineProps({
  show: { type: Boolean, default: false },
  title: { type: String, default: '' },
  message: { type: String, default: '' },
  confirmText: { type: String, default: '确定' },
  cancelText: { type: String, default: '取消' },
  /** 危险操作：确定键变红 */
  danger: { type: Boolean, default: false },
})

defineEmits(['confirm', 'cancel'])
</script>

