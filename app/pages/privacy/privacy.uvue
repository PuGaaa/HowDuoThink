  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.content {
  padding-top: 112rpx;
  padding-bottom: 60rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
}
.meta {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}
.meta__text {
  font-size: 20rpx;
  color: #AFA8BD;
}
.doccard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border-bottom-width: 6rpx;
  border-bottom-style: solid;
  border-bottom-color: #EFE5D6;
}
.blk {
  display: flex;
  flex-direction: column;
}
.blk__h1 {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A4458;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
}
.blk__h2 {
  font-size: 26rpx;
  font-weight: bold;
  color: #4A4458;
  margin-top: 22rpx;
  margin-bottom: 8rpx;
}
.blk__p {
  font-size: 23rpx;
  color: #7A7290;
  line-height: 38rpx;
  margin-top: 6rpx;
}
.blk__li {
  font-size: 23rpx;
  color: #7A7290;
  line-height: 38rpx;
  margin-top: 6rpx;
  padding-left: 10rpx;
}
.failcard {
  display: flex;
  flex-direction: row;
  justify-content: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-top: 24rpx;
  border-bottom-width: 6rpx;
  border-bottom-style: solid;
  border-bottom-color: #EFE5D6;
}
.failcard__text {
  font-size: 23rpx;
  color: #FF8A5C;
}
.foot {
  font-size: 19rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 26rpx;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
