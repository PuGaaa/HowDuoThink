<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
      <view class="content">
        <view v-if="updatedAt.length > 0" class="meta">
          <text class="meta__text">更新于 {{ updatedAt }}</text>
        </view>
        <view v-if="blocks.length > 0" class="doccard">
          <view v-for="(b, i) in blocks" :key="'b' + i" class="blk">
            <text v-if="b.kind == 'h1'" class="blk__h1">{{ b.text }}</text>
            <text v-else-if="b.kind == 'h2'" class="blk__h2">{{ b.text }}</text>
            <text v-else-if="b.kind == 'li'" class="blk__li">{{ b.text }}</text>
            <text v-else class="blk__p">{{ b.text }}</text>
          </view>
        </view>
        <view v-if="loadFailed" class="failcard" @click="reload">
          <text class="failcard__text">加载失败，点击重试</text>
        </view>
        <text class="foot">—— 多想一步，星就多一颗 ——</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import navbar from '../../components/navbar/navbar.uvue'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { fetchPrivacyDoc, readCachedPrivacyDoc } from '../../utils/privacy-doc'

interface DocBlock {
  kind: string
  text: string
}

const blocks = ref<Array<DocBlock>>([])
const updatedAt = ref('')
const loadFailed = ref(false)

/** 纯文本块解析：'# '标题、'## '小节、'- '条目、空行分段；行内 ** 加粗标记直接去除 */
function parseBlocks(content: string): Array<DocBlock> {
  const lines = content.split('\n')
  const out: Array<DocBlock> = []
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim()
    if (line.length == 0) continue
    if (line.startsWith('## ')) {
      out.push({ kind: 'h2', text: line.substring(3) })
    } else if (line.startsWith('# ')) {
      out.push({ kind: 'h1', text: line.substring(2) })
    } else if (line.startsWith('- ')) {
      out.push({ kind: 'li', text: '· ' + line.substring(2).split('**').join('') })
    } else {
      out.push({ kind: 'p', text: line.split('**').join('') })
    }
  }
  return out
}

function render() {
  const doc = readCachedPrivacyDoc()
  if (doc != null) {
    blocks.value = parseBlocks(doc.content)
    updatedAt.value = doc.updatedAt
  }
}

function reload() {
  fetchPrivacyDoc((ok) => {
    render()
    loadFailed.value = !ok && blocks.value.length == 0
  })
}

onShow(() => {
  render()
  reload()
})
</script>

<style>
