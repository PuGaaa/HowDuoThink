<template>
  <view class="page">
    <view class="content">
      <text class="title">我的</text>

      <!-- 档案卡 -->
      <view class="profile">
        <image class="profile__avatar" src="/static/mascots/frog-96.png" mode="aspectFit"></image>
        <text class="profile__rank">{{ rankName }}</text>
        <text class="profile__meta">本地档案 · 第 {{ useDayN }} 天 · 累计破案 {{ solvedCount }} 关</text>
        <text class="profile__next">{{ rankNextTip }}</text>
      </view>

      <!-- 统计 -->
      <view class="stats">
        <view class="statcard">
          <text class="statcard__v">{{ streakCount }} 天</text>
          <text class="statcard__k">连续 streak</text>
        </view>
        <view class="statcard">
          <text class="statcard__v">{{ solvedCount }}</text>
          <text class="statcard__k">累计破案</text>
        </view>
        <view class="statcard">
          <text class="statcard__v">{{ lessonCount }}</text>
          <text class="statcard__k">检查单</text>
        </view>
      </view>

      <!-- 账号 -->
      <view class="account">
        <text class="account__title">账号</text>
        <text class="account__desc">v0 进度保存在本机。登录后可多端同步、\n参与排行榜与每日挑战。</text>
        <view class="account__btn" @click="onLogin">
          <text class="account__btn-text">登录 / 注册 · 即将开放</text>
        </view>
      </view>

      <!-- 手册 + 海报入口 -->
      <view class="entryrow" @click="goHandbook">
        <text class="entryrow__label">📘 我的手册</text>
        <text class="entryrow__v">{{ lessonCount }} 条检查单</text>
      </view>
      <view class="entryrow" @click="goPoster">
        <text class="entryrow__label">🖼 侦探档案海报</text>
        <text class="entryrow__v">生成分享</text>
      </view>

      <!-- 通用 -->
      <text class="sec">通用</text>
      <view v-for="(row, i) in rows" :key="'r' + i" class="row" @click="onRow(row.value)">
        <text class="row__label">{{ row.label }}</text>
        <text class="row__value">{{ row.value }}</text>
        <image class="row__chevron" src="/static/icons/arrowr-coral.png" mode="aspectFit"></image>
      </view>
    </view>
    <tabbar active="me"></tabbar>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { ALL_CASES } from '../../data/cases'
import { getCaseProgress, getStreak, useDay, getTotals } from '../../utils/storage'
import { rankOf } from '../../utils/scoring'
import tabbar from '../../components/tabbar/tabbar.uvue'

class RowVM {
  label: string = ''
  value: string = ''
}

const rankName = ref('')
const rankNextTip = ref('')
const useDayN = ref(1)
const solvedCount = ref(0)
const streakCount = ref(0)
const lessonCount = ref(0)
const rows = ref<RowVM[]>([])

const totals = getTotals(
  ALL_CASES.map((c) => c.id),
  ALL_CASES.map((c) => c.lessons.length)
)
solvedCount.value = totals.solved
lessonCount.value = totals.lessons
useDayN.value = useDay()
streakCount.value = getStreak().count
const rk = rankOf(totals.solved)
rankName.value = rk.name
rankNextTip.value = rk.remain > 0 ? '距「' + rk.nextName + '」还差 ' + rk.remain + ' 关' : '已是最高称号'

const r1 = new RowVM()
r1.label = '学习提醒'
r1.value = '每天 21:30'
const r2 = new RowVM()
r2.label = '每日一题'
r2.value = '即将上线'
const r3 = new RowVM()
r3.label = '检查单云同步'
r3.value = '即将上线'
const r4 = new RowVM()
r4.label = '关于排错推理训练场'
r4.value = 'v0.1'
rows.value = [r1, r2, r3, r4]

function goHandbook() {
  uni.navigateTo({ url: '/pages/handbook/handbook' })
}

function goPoster() {
  uni.navigateTo({ url: '/pages/post/post' })
}

function onLogin() {
  uni.showToast({ title: '登录功能即将开放', icon: 'none' })
}

function onRow(v: string) {
  uni.showToast({ title: v, icon: 'none' })
}
</script>

