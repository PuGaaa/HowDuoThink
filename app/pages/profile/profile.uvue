<template>
  <view class="page">
    <view class="content">

      <!-- 档案卡（横排 + 账号身份行）：个人信息为主，称号为次 -->
      <view class="profile">
        <view class="profile__toprow">
          <view class="profile__halo">
            <image class="profile__avatar" :src="avatarSrc" mode="aspectFill"></image>
          </view>
          <view class="profile__right">
            <view class="profile__namerow">
              <text class="profile__name">{{ displayName }}</text>
              <view class="profile__edit" @click="goEdit">
                <text class="profile__edit-text">编辑</text>
              </view>
            </view>
            <view class="profile__rankbadge">
              <text class="profile__rankbadge-text">{{ rankName }}</text>
            </view>
            <text class="profile__meta">本地档案 · 第 {{ useDayN }} 天 · 累计破案 {{ solvedCount }} 关</text>
            <view class="profile__track">
              <view class="profile__fill" :style="'width:' + profilePct + '%'"></view>
            </view>
            <text class="profile__next">{{ rankNextTip }}</text>
          </view>
        </view>
      </view>

      <!-- 统计 -->
      <view class="stats">
        <view class="statcard">
          <text class="statcard__v">{{ streakCount }} 天</text>
          <text class="statcard__k">连续 streak</text>
        </view>
        <view class="statcard">
          <text class="statcard__v">{{ solvedCount }}</text>
          <text class="statcard__k">累计破案</text>
        </view>
        <view class="statcard">
          <text class="statcard__v">{{ lessonCount }}</text>
          <text class="statcard__k">检查单</text>
        </view>
      </view>

      <!-- 手册 + 海报入口 -->
      <view class="entryrow" @click="goHandbook">
        <image class="entryrow__icon" src="/static/icons/book-coral.png" mode="aspectFit"></image>
        <text class="entryrow__label">我的手册</text>
        <text class="entryrow__v">{{ lessonCount }} 条检查单</text>
      </view>
      <view class="entryrow" @click="goPoster">
        <image class="entryrow__icon" src="/static/icons/pen-coral.png" mode="aspectFit"></image>
        <text class="entryrow__label">侦探档案海报</text>
        <text class="entryrow__v">生成分享</text>
      </view>

      <view class="entryrow" @click="goSubmit">
        <image class="entryrow__icon" src="/static/icons/star-lemon.png" mode="aspectFit"></image>
        <text class="entryrow__label">投稿出题</text>
        <text class="entryrow__v">把你的坑变成关卡</text>
      </view>
      <view class="entryrow" @click="goMySubmissions">
        <image class="entryrow__icon" src="/static/icons/pen-coral.png" mode="aspectFit"></image>
        <text class="entryrow__label">我的投稿</text>
        <text class="entryrow__v">查看状态</text>
      </view>

      <!-- 通用 -->
      <text class="sec">通用</text>
      <view v-for="(row, i) in rows" :key="'r' + i" class="row" @click="onRow(row.label, row.value)">
        <text class="row__label">{{ row.label }}</text>
        <text class="row__value">{{ row.value }}</text>
        <image class="row__chevron" src="/static/icons/arrowr-coral.png" mode="aspectFit"></image>
      </view>
      <!-- 账号操作：白色危险按钮 / 珊瑚主按钮，与设置行区分 -->
      <view v-if="user != null" class="authbtn authbtn--logout" @click="onLogout">
        <text class="authbtn__text authbtn__text--danger">退出登录</text>
      </view>
      <view v-else class="authbtn authbtn--login" @click="onLogin">
        <text class="authbtn__text authbtn__text--main">去登录</text>
      </view>
    </view>
    <confirm-dialog
      :show="showLogout"
      title="退出登录"
      message="确定退出当前账号？"
      confirm-text="退出"
      :danger="true"
      @confirm="doLogout"
      @cancel="showLogout = false"
    ></confirm-dialog>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { ALL_CASES } from '../../data/cases'
import { getCaseProgress, getStreak, useDay, getTotals } from '../../utils/storage'
import { rankOf } from '../../utils/scoring'
import { getStoredUser, logout, AppUser } from '../../utils/auth'
import confirmDialog from '../../components/confirm-dialog/confirm-dialog.uvue'
import { getAvatar as resolveAvatar, getDisplayName } from '../../utils/auth'
import { dailyCase, dailyDone, todayKey } from '../../utils/daily'
import { getReminder, setReminder, reminderLabel, startReminderPolling, requestNotifyPermission } from '../../utils/reminder'
import { manualSync, lastSyncLabel, pullServerProgress } from '../../utils/sync-progress'

class RowVM {
  label: string = ''
  value: string = ''
}

const rankName = ref('')
const rankNextTip = ref('')
const useDayN = ref(1)
const solvedCount = ref(0)
const streakCount = ref(0)
const lessonCount = ref(0)
const rows = ref<RowVM[]>([])
const user = ref<AppUser | null>(null)
const profilePct = ref(0)
const displayName = ref('')
const avatarSrc = ref('/static/images/default-avatar.png')
const dailyTitle = ref('')
const dailyIsDone = ref(false)

function refresh() {
  user.value = getStoredUser()
  displayName.value = getDisplayName()
  avatarSrc.value = resolveAvatar()
  const dc = dailyCase()
  dailyTitle.value = dc.title
  dailyIsDone.value = dailyDone()

  const totals = getTotals(
    ALL_CASES.map((c) => c.id),
    ALL_CASES.map((c) => c.lessons.length)
  )
  solvedCount.value = totals.solved
  lessonCount.value = totals.lessons
  useDayN.value = useDay()
  streakCount.value = getStreak().count
  const rk = rankOf(totals.solved)
  rankName.value = rk.name
  rankNextTip.value = rk.remain > 0 ? '距「' + rk.nextName + '」还差 ' + rk.remain + ' 关' : '已是最高称号'
  // 称号进度：按当前段与下一段阈值线性映射
  const RANKS: number[][] = [[0, 1], [1, 3], [3, 6], [6, 6]]
  const seg = RANKS[rk.index]
  const span = seg[1] - seg[0]
  profilePct.value = span > 0 ? Math.min(100, Math.round(((totals.solved - seg[0]) * 100) / span)) : 100

  const r1 = new RowVM()
  r1.label = '学习提醒'
  r1.value = reminderLabel()
  const r2 = new RowVM()
  r2.label = '每日一题'
  r2.value = dailyIsDone.value ? '✓ 已完成' : dailyTitle.value
  const r3 = new RowVM()
  r3.label = '检查单云同步'
  r3.value = user.value != null ? (lastSyncLabel().length > 0 ? lastSyncLabel() : '点击同步') : '登录后可用'
  const r4 = new RowVM()
  r4.label = '关于 好多星'
  r4.value = 'v0.1'
  rows.value = [r1, r2, r3, r4]
}

// onShow 首次显示也会触发：从子页返回时数据保持最新；提醒轮询随页面常驻
onShow(() => {
  refresh()
  startReminderPolling()
  // 登录态：后端为唯一事实源，回到档案页即拉取覆盖本地，再刷新显示
  pullServerProgress((r) => {
    if (r.error.length === 0) refresh()
  })
})

function goHandbook() {
  uni.navigateTo({ url: '/pages/handbook/handbook' })
}

function goPoster() {
  uni.navigateTo({ url: '/pages/post/post' })
}

function goSubmit() {
  uni.navigateTo({ url: '/pages/submit/submit' })
}

function goMySubmissions() {
  uni.navigateTo({ url: '/pages/mysubmissions/mysubmissions' })
}

function onLogin() {
  uni.navigateTo({ url: '/pages/login/login' })
}

function goEdit() {
  uni.navigateTo({ url: '/pages/profile-edit/profile-edit' })
}

function goAbout() {
  uni.navigateTo({ url: '/pages/about/about' })
}

function showReminderSheet() {
  const items = ['每天 20:00', '每天 21:00', '每天 21:30', '每天 22:00', '关闭提醒']
  uni.showActionSheet({
    itemList: items,
    success: (res) => {
      if (res.tapIndex === 4) {
        setReminder({ on: false, hh: 21, mm: 30 })
      } else {
        // #ifdef WEB
        const perm = requestNotifyPermission()
        if (perm === 'default') {
          const N = (window as any).Notification
          if (N) N.requestPermission()
        }
        // #endif
        const times: number[][] = [[20, 0], [21, 0], [21, 30], [22, 0]]
        const t = times[res.tapIndex]
        setReminder({ on: true, hh: t[0], mm: t[1] })
        startReminderPolling()
      }
      refresh()
      uni.showToast({ title: '学习提醒已更新', icon: 'none' })
    },
  })
}

const showLogout = ref(false)

function onLogout() {
  showLogout.value = true
}

function doLogout() {
  showLogout.value = false
  logout()
  refresh()
  uni.showToast({ title: '已退出', icon: 'none' })
}

function onRow(label: string, value: string) {
  if (label === '关于 好多星') {
    goAbout()
    return
  }
  if (label === '每日一题') {
    uni.navigateTo({ url: '/pages/play/play?id=' + dailyCase().id })
    return
  }
  if (label === '学习提醒') {
    showReminderSheet()
    return
  }
  if (label === '检查单云同步') {
    manualSync((r) => {
      if (r.error.length > 0) uni.showToast({ title: r.error, icon: 'none' })
      refresh()
    })
    return
  }
  uni.showToast({ title: value + ' · 即将上线', icon: 'none' })
}
</script>

