<template>
  <view class="page">
    <safe-top></safe-top>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">

      <!-- 档案卡（横排 + 账号身份行）：个人信息为主，称号为次 -->
      <view class="profile">
        <view class="profile__toprow">
          <view class="profile__halo">
            <image class="profile__avatar" :src="avatarSrc" mode="aspectFill"></image>
          </view>
          <view class="profile__right">
            <view class="profile__namerow">
              <text class="profile__name">{{ displayName }}</text>
              <view class="profile__edit" @click="goEdit">
                <text class="profile__edit-text">编辑</text>
              </view>
            </view>
            <view class="profile__rankbadge">
              <text class="profile__rankbadge-text">{{ rankName }}</text>
            </view>
            <text class="profile__meta">本地档案 · 第 {{ useDayN }} 天 · 累计破案 {{ solvedCount }} 关</text>
            <view class="profile__track">
              <view class="profile__fill" :style="'width:' + profilePct + '%'"></view>
            </view>
            <text class="profile__next">{{ rankNextTip }}</text>
          </view>
        </view>
      </view>

      <!-- 统计 -->
      <view class="stats">
        <view class="statcard">
          <text class="statcard__v">{{ streakCount }} 天</text>
          <text class="statcard__k">连续 streak</text>
        </view>
        <view class="statcard">
          <text class="statcard__v">{{ solvedCount }}</text>
          <text class="statcard__k">累计破案</text>
        </view>
        <view class="statcard">
          <text class="statcard__v">{{ lessonCount }}</text>
          <text class="statcard__k">检查单</text>
        </view>
      </view>

      <!-- 手册入口 -->
      <view class="entryrow" @click="goHandbook">
        <image class="entryrow__icon" src="/static/icons/book-coral.png" mode="aspectFit"></image>
        <text class="entryrow__label">我的手册</text>
        <text class="entryrow__v">{{ lessonCount }} 条检查单</text>
      </view>

      <!-- 通用 -->
      <text class="sec">通用</text>
      <!-- 学习提醒：点时间直接选（系统时间选择器），开关直接开/关 -->
      <view class="row">
        <picker class="row__pick" mode="time" :value="reminderTime" @change="onReminderTime">
          <view class="row__pickinner">
            <text class="row__label">学习提醒</text>
            <text class="row__value">{{ reminderValue }}</text>
          </view>
        </picker>
        <switch :checked="reminderOn" color="#FF8A5C" @change="onReminderToggle"></switch>
      </view>
      <view v-for="(row, i) in rows" :key="'r' + i" class="row" @click="onRow(row.label, row.value)">
        <text class="row__label">{{ row.label }}</text>
        <text class="row__value">{{ row.value }}</text>
        <image class="row__chevron" src="/static/icons/arrowr-coral.png" mode="aspectFit"></image>
      </view>
      <!-- 账号：账号设置入口（登录态；密码与注销账号在子页内） -->
      <view v-if="user != null" class="row" @click="goAccountSettings">
        <text class="row__label">账号设置</text>
        <text class="row__value"></text>
        <image class="row__chevron" src="/static/icons/arrowr-coral.png" mode="aspectFit"></image>
      </view>
      <!-- 账号操作：白色危险按钮 / 珊瑚主按钮，与设置行区分 -->
      <view v-if="user != null" class="authbtn authbtn--logout" @click="onLogout">
        <text class="authbtn__text authbtn__text--danger">退出登录</text>
      </view>
      <view v-else class="authbtn authbtn--login" @click="onLogin">
        <text class="authbtn__text authbtn__text--main">去登录</text>
      </view>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { getEffectiveCases } from '../../data/cases'
import { getCaseProgress, getStreak, useDay, getTotals } from '../../utils/storage'
import { rankOf } from '../../utils/scoring'
import { getStoredUser, logout, fetchProfile, AppUser } from '../../utils/auth'
import { openConfirmDialog, ConfirmDialogOptions } from '../../utils/confirm-dialog'
import { getAvatar as resolveAvatar, getDisplayName } from '../../utils/auth'
import { dailyCase, dailyDone, todayKey } from '../../utils/daily'
import { getReminder, setReminder, reminderLabel, startReminderPolling, requestNotifyPermission } from '../../utils/reminder'
import { scheduleDailyReminder, cancelDailyReminder } from '../../uni_modules/hduo-reminder'
import { pullServerProgress } from '../../utils/sync-progress'
import { APP_VERSION } from '../../utils/version'

class RowVM {
  label: string = ''
  value: string = ''
}

const rankName = ref('')
const rankNextTip = ref('')
const useDayN = ref(1)
const solvedCount = ref(0)
const streakCount = ref(0)
const lessonCount = ref(0)
const rows = ref<RowVM[]>([])
const user = ref<AppUser | null>(null)
const profilePct = ref(0)
const displayName = ref('')
const avatarSrc = ref('')
const dailyTitle = ref('')
const dailyIsDone = ref(false)
// 学习提醒：开关状态 / picker 初值（HH:mm）/ 行内展示文案
const reminderOn = ref(false)
const reminderTime = ref('21:30')
const reminderValue = ref('关闭')

function refresh() {
  const cases = getEffectiveCases()
  user.value = getStoredUser()
  displayName.value = getDisplayName()
  avatarSrc.value = resolveAvatar()
  const dc = dailyCase()
  dailyTitle.value = dc.title
  dailyIsDone.value = dailyDone()

  const totals = getTotals(
    cases.map((c) => c.id),
    cases.map((c) => c.lessons.length)
  )
  solvedCount.value = totals.solved
  lessonCount.value = totals.lessons
  useDayN.value = useDay()
  streakCount.value = getStreak().count
  const rk = rankOf(totals.solved)
  rankName.value = rk.name
  rankNextTip.value = rk.remain > 0 ? '距「' + rk.nextName + '」还差 ' + rk.remain + ' 关' : '已是最高称号'
  // 称号进度：按当前段与下一段阈值线性映射
  const RANKS: number[][] = [[0, 1], [1, 3], [3, 6], [6, 6]]
  const seg = RANKS[rk.index]
  const span = seg[1] - seg[0]
  profilePct.value = span > 0 ? Math.min(100, Math.round(((totals.solved - seg[0]) * 100) / span)) : 100

  const rp = getReminder()
  reminderOn.value = rp.on
  reminderTime.value = pad2(rp.hh) + ':' + pad2(rp.mm)
  reminderValue.value = reminderLabel()

  const r1 = new RowVM()
  r1.label = '每日一题'
  r1.value = dailyIsDone.value ? '✓ 已完成' : dailyTitle.value
  const r2 = new RowVM()
  r2.label = '分享海报'
  r2.value = '生成侦探档案'
  const r3 = new RowVM()
  r3.label = '关于 好多星'
  r3.value = APP_VERSION
  rows.value = [r1, r2, r3]
}

// onShow 首次显示也会触发：从子页返回时数据保持最新；提醒轮询随页面常驻
onShow(() => {
  refresh()
  startReminderPolling()
  // 登录态：后端为唯一事实源，回到档案页即拉取覆盖本地，再刷新显示
  pullServerProgress((r) => {
    if (r.error.length === 0) refresh()
  })
  // 刷新登录资料：会话在别端改动（昵称/头像/注销）回到本页即校正
  fetchProfile((r) => {
    if (r.error.length === 0) refresh()
  })
})

function goHandbook() {
  uni.navigateTo({ url: '/pages/handbook/handbook' })
}

function goPoster() {
  uni.navigateTo({ url: '/pages/post/post' })
}

function goSubmit() {
  uni.navigateTo({ url: '/pages/submit/submit' })
}

function goMySubmissions() {
  uni.navigateTo({ url: '/pages/mysubmissions/mysubmissions' })
}

function onLogin() {
  uni.navigateTo({ url: '/pages/login/login' })
}

function goEdit() {
  uni.navigateTo({ url: '/pages/profile-edit/profile-edit' })
}

function goAbout() {
  uni.navigateTo({ url: '/pages/about/about' })
}

function goAccountSettings() {
  uni.navigateTo({ url: '/pages/account-settings/account-settings' })
}

function pad2(n: number): string {
  return n < 10 ? '0' + n : String(n)
}

/** 开启提醒的共享逻辑：Web 走浏览器通知授权；App 注册系统每日本地通知（调度由 iOS 系统托管，app 被杀也弹） */
function applyReminder(hh: number, mm: number) {
  // #ifdef WEB
  requestNotifyPermission().then((permission: string) => {
    if (permission === 'granted') {
      setReminder({ on: true, hh: hh, mm: mm })
      startReminderPolling()
      refresh()
      uni.showToast({ title: '学习提醒已开启', icon: 'none' })
      return
    }
    setReminder({ on: false, hh: 21, mm: 30 })
    refresh()
    uni.showToast({
      title: permission === 'denied' ? '浏览器已拒绝通知权限，提醒未开启' : '当前环境不支持浏览器通知',
      icon: 'none',
    })
  })
  // #endif
  // #ifndef WEB
  scheduleDailyReminder(hh, mm, '好多星', '今天的学习时间到了，来破一案吧 🔍')
  setReminder({ on: true, hh: hh, mm: mm })
  refresh()
  uni.showToast({ title: '学习提醒已开启', icon: 'none' })
  // #endif
}

/** 点时间 → 系统时间选择器选定即开启 */
function onReminderTime(e: UniPickerChangeEvent) {
  const parts = (e.detail.value as string).split(':')
  if (parts.length !== 2) return
  applyReminder(parseInt(parts[0]), parseInt(parts[1]))
}

/** 开关：开 → 按当前时间开启；关 → 取消系统调度并保留时间（再开不用重选） */
function onReminderToggle(e: UniSwitchChangeEvent) {
  const rp = getReminder()
  if (e.detail.value) {
    applyReminder(rp.hh, rp.mm)
    return
  }
  cancelDailyReminder()
  setReminder({ on: false, hh: rp.hh, mm: rp.mm })
  refresh()
  uni.showToast({ title: '学习提醒已关闭', icon: 'none' })
}

function onLogout() {
  const opt = {
    title: '退出登录',
    message: '确定退出当前账号？',
    confirmText: '退出',
    cancelText: '取消',
    danger: true,
  } as ConfirmDialogOptions
  openConfirmDialog(opt, (confirm: boolean) => {
    if (confirm) {
      logout()
      refresh()
      uni.showToast({ title: '已退出', icon: 'none' })
    }
  })
}

function onRow(label: string, value: string) {
  if (label === '关于 好多星') {
    goAbout()
    return
  }
  if (label === '分享海报') {
    goPoster()
    return
  }
  if (label === '每日一题') {
    uni.navigateTo({ url: '/pages/play/play?id=' + dailyCase().id + '&source=daily' })
    return
  }
  uni.showToast({ title: value + ' · 即将上线', icon: 'none' })
}
</script>

