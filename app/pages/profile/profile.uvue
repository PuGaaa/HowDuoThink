  /* 硬边阴影缓冲：statcard 贴行底，uni-view 默认 overflow:hidden 会裁阴影 */
  padding-bottom: 6rpx;
  margin-bottom: 24rpx;
}

/* 账号操作按钮：白底危险钮 / 珊瑚主钮 */
.authbtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 46rpx;
