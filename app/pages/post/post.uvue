<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
      <view class="content">
        <!-- 传播海报卡（与导出 PNG 同构）：手账拼贴 · 吸引下载向 -->
        <view class="postcard" id="postcard">
          <view class="postcard__photo">
            <view class="postcard__tape postcard__tape--a"></view>
            <view class="postcard__tape postcard__tape--b"></view>
            <image class="postcard__hero" src="/static/post/stickers.png" mode="widthFix"></image>
          </view>
          <!-- 标题行：终端贴纸在左侧做装饰（微旋转手账质感），组合居中 -->
          <view class="postcard__titlerow">
            <image class="postcard__titlebadge" src="/static/post/terminal.png" mode="aspectFit"></image>
            <text class="postcard__title">这届 Bug 有点难抓</text>
          </view>
          <text class="postcard__sub">你的排错直觉该练练了</text>
          <view v-if="shareReady" class="postcard__qrrow">
            <view class="postcard__qrtext">
              <text class="postcard__cta">扫码来试试</text>
              <text class="postcard__brand">好多星 · 多想，多星。</text>
            </view>
            <view class="postcard__qrwrap">
              <view class="postcard__qrframe">
                <image class="postcard__qr" :src="qrDataUrl" mode="aspectFit"></image>
              </view>
            </view>
            <!-- 恐龙挂行容器正偏移定位（relative + top≥0），整只落在行边界内，原生端不会被裁剪 -->
            <image class="postcard__dino" src="/static/post/triceratops.png" mode="aspectFit"></image>
            <!-- 粉色和纸胶带斜贴码图左上角（正偏移在便签内，不越界裁剪；码图自带超宽静区不伤码） -->
            <view class="postcard__qrtape"></view>
            <!-- 星星压便签内左下角（正偏移不越界） -->
            <image class="postcard__spark" src="/static/icons/v4/magic-sparkles.png" mode="aspectFit"></image>
          </view>
        </view>

        <view class="btnrow">
          <view class="primarybtn" @click="downloadPoster">
            <text class="primarybtn__text">保存海报 PNG</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import navbar from '../../components/navbar/navbar.uvue'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { PUBLIC_H5_ORIGIN } from '../../config'
import { createPosterShareUrl, createQrDataUrl } from '../../utils/qr'

const qrDataUrl = ref('')
const shareUrl = PUBLIC_H5_ORIGIN.length > 0
  ? createPosterShareUrl(PUBLIC_H5_ORIGIN)
  : ''
const shareReady = shareUrl.length > 0

// onShow 首次显示也会触发：二维码随分享地址保持最新
onShow(() => {
  if (shareReady) qrDataUrl.value = createQrDataUrl(shareUrl)
})

function downloadPoster() {
  // #ifdef WEB
  // Canvas 逻辑尺寸 390×560，2x 导出 780×1120 —— 与页面海报卡（手账拼贴）同构
  const BW = 390
  const BH = 560
  const c = document.createElement('canvas') as any
  c.width = BW * 2
  c.height = BH * 2
  const ctx = c.getContext('2d') as any
  if (ctx == null) {
    uni.showToast({ title: '当前浏览器不支持导出', icon: 'none' })
    return
  }
  ctx.scale(2, 2)
  // 奶油卡底
  ctx.fillStyle = '#FFF8F0'
  ctx.fillRect(0, 0, BW, BH)
  ctx.textAlign = 'center'
  const rr = (x: number, y: number, w: number, h: number, r: number) => {
    ctx.beginPath()
    if (ctx.roundRect != null) ctx.roundRect(x, y, w, h, r)
    else ctx.rect(x, y, w, h)
  }
  const drawPoster = (heroImg: any, qrImg: any, dinoImg: any, termImg: any, sparkImg: any) => {
    // 贴纸图 = 微旋转白框照片（阴影 + 白边 + 圆角）
    ctx.save()
    ctx.translate(BW / 2, 165)
    ctx.rotate(-1.2 * Math.PI / 180)
    ctx.shadowColor = 'rgba(74, 68, 88, 0.18)'
    ctx.shadowBlur = 18
    ctx.shadowOffsetY = 8
    rr(-163.5, -125.5, 327, 251, 12)
    ctx.fillStyle = '#FFFFFF'
    ctx.fill()
    ctx.shadowColor = 'transparent'
    ctx.shadowBlur = 0
    ctx.shadowOffsetY = 0
    if (heroImg != null) {
      // 图 303×227 居中内嵌（白边 12）
      ctx.drawImage(heroImg, -151.5, -113.5, 303, 227)
    } else {
      ctx.fillStyle = '#FFF3E9'
      rr(-151.5, -113.5, 303, 227, 8)
      ctx.fill()
    }
    ctx.restore()
    // 和纸胶带：斜贴照片框上缘两角
    const tapes: any[][] = [[86, 46, -42, 'rgba(247, 226, 178, 0.92)'], [304, 47, 38, 'rgba(205, 233, 214, 0.92)']]
    for (let i = 0; i < tapes.length; i++) {
      ctx.save()
      ctx.translate(tapes[i][0] as number, tapes[i][1] as number)
      ctx.rotate((tapes[i][2] as number) * Math.PI / 180)
      ctx.fillStyle = tapes[i][3] as string
      rr(-29, -11, 58, 22, 3)
      ctx.fill()
      ctx.restore()
    }
    // 标题行：终端放大镜贴纸在左做装饰（微旋转），组合按文字实测宽度居中 —— 与页面标题行同构
    ctx.fillStyle = '#303343'
    ctx.font = 'bold 24px -apple-system, PingFang SC, sans-serif'
    const titleText = '这届 Bug 有点难抓'
    const titleW = ctx.measureText(titleText).width
    const termW = 44
    const termH = 33
    const titleGap = 10
    const titleLeft = (BW - termW - titleGap - titleW) / 2
    if (termImg != null) {
      ctx.save()
      ctx.translate(titleLeft + termW / 2, 341)
      ctx.rotate(8 * Math.PI / 180)
      ctx.drawImage(termImg, -22, -17, termW, termH)
      ctx.restore()
    }
    ctx.textAlign = 'left'
    ctx.fillText(titleText, titleLeft + termW + titleGap, 350)
    ctx.textAlign = 'center'
    // 副题
    ctx.fillStyle = '#858397'
    ctx.font = '13px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('你的排错直觉该练练了', BW / 2, 382)
    // 白色便签：与照片框同倾角（-1.2°）微旋转，码图直接贴纸面，按内容推导宽度并居中 —— 与页面扫码区同构
    if (qrImg != null) {
      ctx.font = '11px -apple-system, PingFang SC, sans-serif'
      const brandW = ctx.measureText('好多星 · 多想，多星。').width
      const panelW = brandW + 14 + 116 + 15 + 8 + 40
      const panelX = (BW - panelW) / 2
      const textX = panelX + 20
      const qrX = textX + brandW + 14
      ctx.save()
      ctx.translate(BW / 2, 454)
      ctx.rotate(-1.2 * Math.PI / 180)
      // 便签底色/投影暂由页面设计迭代决定（当前页面为无底透明），此处仅作旋转坐标系
      // 码图直接贴便签（数据源自带静区），恐龙右缘伸出码图右缘 15px —— 与页面卡同构
      ctx.drawImage(qrImg, qrX - BW / 2, -42, 116, 116)
      // 粉色和纸胶带（页面当前定在便签左缘 top75rpx）—— 与页面同构
      ctx.save()
      ctx.translate(panelX - BW / 2 + 19, -40)
      ctx.rotate(-30 * Math.PI / 180)
      ctx.fillStyle = 'rgba(248, 205, 214, 0.9)'
      rr(-18.5, -7, 37, 14, 3)
      ctx.fill()
      ctx.restore()
      if (dinoImg != null) {
        ctx.save()
        ctx.translate(qrX + 101 - BW / 2, -54)
        ctx.rotate(4 * Math.PI / 180)
        ctx.drawImage(dinoImg, -30, -30, 60, 60)
        ctx.restore()
      }
      ctx.textAlign = 'left'
      ctx.fillStyle = '#303343'
      ctx.font = 'bold 16px -apple-system, PingFang SC, sans-serif'
      ctx.fillText('扫码来试试', textX - BW / 2, 4)
      ctx.fillStyle = '#AFA8BD'
      ctx.font = '11px -apple-system, PingFang SC, sans-serif'
      ctx.fillText('好多星 · 多想，多星。', textX - BW / 2, 30)
      ctx.textAlign = 'center'
      // 星星压便签内左下角
      if (sparkImg != null) {
        ctx.drawImage(sparkImg, panelX + 3 - BW / 2, 51, 32, 32)
      }
      ctx.restore()
    } else {
      ctx.fillStyle = '#AFA8BD'
      ctx.font = '11px -apple-system, PingFang SC, sans-serif'
      ctx.fillText('H5 公开地址配置后，海报会显示可扫码的试玩入口', BW / 2, 470)
    }
    // 触发下载
    const url = c.toDataURL('image/png')
    const a = document.createElement('a') as any
    a.href = url
    a.download = 'share-poster-' + Date.now() + '.png'
    document.body.appendChild(a)
    a.click()
    a.remove()
    uni.showToast({ title: '海报已开始下载', icon: 'none' })
  }
  const load = (src: string) => {
    return new Promise((res: (v: any) => void) => {
      const im = document.createElement('img') as any
      im.onload = () => res(im)
      im.onerror = () => res(null)
      im.src = src
    })
  }
  Promise.all([
    load('/static/post/stickers.png'),
    shareReady ? load(qrDataUrl.value) : Promise.resolve(null),
    load('/static/post/triceratops.png'),
    load('/static/post/terminal.png'),
    load('/static/icons/v4/magic-sparkles.png'),
  ]).then((imgs) => {
    drawPoster(imgs[0], imgs[1], imgs[2], imgs[3], imgs[4])
  })
  // #endif
  // #ifndef WEB
  // App 端：直接对页面海报卡元素截图后存系统相册 —— 所见即所得，不维护第二套绘制代码。
  // 首次保存会触发相册写入权限弹窗；拒绝后再次保存走系统设置引导。
  const card = uni.getElementById('postcard')
  if (card == null) {
    uni.showToast({ title: '海报生成失败，请重试', icon: 'none' })
    return
  }
  card.takeSnapshot({
    format: 'png',
    success: (res) => {
      uni.saveImageToPhotosAlbum({
        filePath: res.tempFilePath,
        success: () => {
          uni.showToast({ title: '海报已保存到相册', icon: 'success' })
        },
        fail: () => {
          uni.showToast({ title: '保存失败，请允许访问相册后重试', icon: 'none' })
        },
      })
    },
    fail: () => {
      uni.showToast({ title: '海报生成失败，请重试', icon: 'none' })
    },
  })
  // #endif
}
</script>

<style>
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.pagesv {
  flex: 1;
}
.content {
  display: flex;
  flex-direction: column;
  /* 顶部留白盖过悬浮返回胶囊（约 96rpx），海报卡不顶到返回按钮 */
  padding-top: 120rpx;
  padding-bottom: 60rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
/* 手账拼贴海报：整卡奶油底，贴纸图 = 微旋转白框照片 + 胶带/恐龙/终端/星星点缀 */
.postcard {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 0 52rpx;
  box-shadow: 0 8rpx 24rpx 0 #F0DFD2;
}
.postcard__photo {
  position: relative;
  width: 654rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  transform: rotate(-1.2deg);
  box-shadow: 0 12rpx 32rpx 0 rgba(74, 68, 88, 0.16);
}
/* 和纸胶带：斜贴照片框上缘两角 */
.postcard__tape {
  position: absolute;
  width: 116rpx;
  height: 44rpx;
  border-radius: 6rpx;
}
.postcard__tape--a {
  top: -18rpx;
  left: 44rpx;
  background-color: rgba(247, 226, 178, 0.92);
  transform: rotate(-42deg);
  z-index: 22;
}
.postcard__tape--b {
  top: -16rpx;
  right: 44rpx;
  background-color: rgba(205, 233, 214, 0.92);
  transform: rotate(38deg);
  z-index: 22;
}
.postcard__hero {
  width: 100%;
  border-radius: 12rpx;
}
/* 标题行：终端放大镜贴纸在左做装饰；对称内边距容纳 8° 旋转角点外扩，内容居中位置不变 */
.postcard__titlerow {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx;
  margin-top: 36rpx;
}
.postcard__titlebadge {
  width: 68rpx;
  height: 51rpx;
  margin-right: 14rpx;
  transform: rotate(8deg);
}
.postcard__title {
  font-size: 38rpx;
  font-weight: bold;
  color: #303343;
}
.postcard__sub {
  font-size: 24rpx;
  color: #858397;
  margin-top: 12rpx;
}
.postcard__qrrow {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  /* 白色便签：与照片框同倾角（-1.2°）+ 同语言软投影，扫码行像贴在手账上的第二张拍立得；
     上内边距给趴框的三角龙留出整只空间（恐龙 top≥0，任何端都不越界裁剪）；
     左右对称内边距把恐龙伸出码图右缘的部分包进行边界框：内容绝对位置不变，任何端不裁剪 */
  /* background-color: #FFFFFF; */
  border-radius: 20rpx;
  transform: rotate(-1.2deg);
  /* box-shadow: 0 8rpx 20rpx 0 rgba(74, 68, 88, 0.10); */
  padding-top: 85rpx;
  padding-bottom: 28rpx;
  padding-left: 38rpx;
  padding-right: 38rpx;
  /* margin-top: 44rpx; */
}
.postcard__qrwrap {
  position: relative;
}
.postcard__qr {
  width: 148rpx;
  height: 148rpx;
}
/* 三角龙趴在二维码白框右上角（右缘伸出框外 30rpx，调定位置不变）：
   right 8rpx = 行右内边距 38rpx − 伸出 30rpx，视觉位置不变且整只落在行边界内不被裁剪 */
.postcard__dino {
  position: absolute;
  top: 0rpx;
  right: 8rpx;
  width: 120rpx;
  height: 120rpx;
  transform: rotate(4deg);
}
.postcard__qrtext {
  display: flex;
  flex-direction: column;
  margin-right: 26rpx;
}
.postcard__cta {
  font-size: 30rpx;
  font-weight: bold;
  color: #303343;
}
.postcard__brand {
  font-size: 22rpx;
  color: #AFA8BD;
  margin-top: 10rpx;
}
/* 粉色和纸胶带：斜贴码图左上角，把二维码"钉"在便签上（与照片的黄/绿胶带成三色拼贴）。
   从行右侧锚定（right 140 = 码图 148 − 压角 8），只盖码图自带静区，不随文字宽度漂移 */
.postcard__qrtape {
  position: absolute;
  top: 75rpx;
  left: 0rpx;
  width: 72rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background-color: rgba(248, 205, 214, 0.9);
  transform: rotate(-30deg);
}
/* 星星点缀：压在券面块内左下角（正偏移，不越界不裁剪） */
.postcard__spark {
  position: absolute;
  left: 6rpx;
  bottom: 6rpx;
  width: 32rpx;
  height: 32rpx;
}
.sharehint {
  font-size: 22rpx;
  color: #AFA8BD;
  margin-top: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  overflow: hidden;
}
.btnrow {
  margin-top: 36rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF7047;
  background-image: linear-gradient(to right, #FF8A5C, #FF5A3D);
  border-radius: 46rpx;
  padding: 26rpx;
  border-bottom-width: 8rpx;
  border-bottom-style: solid;
  border-bottom-color: #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.hint {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 18rpx;
}
</style>
