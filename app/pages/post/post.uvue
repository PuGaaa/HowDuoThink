<template>
  <view class="page">
    <navbar></navbar>
    <view class="content">
      <text class="pagetitle">侦探档案</text>

      <!-- 档案卡预览（海报同款视觉） -->
      <view class="postcard">
        <view class="deco">
          <view class="deco__b deco__b--a"></view>
          <view class="deco__b deco__b--e"></view>
          <view class="deco__b deco__b--m"></view>
        </view>
        <image class="postcard__avatar" src="/static/mascots/frog-96.png" mode="aspectFit"></image>
        <text class="postcard__brand">排错推理训练场 · 侦探档案</text>
        <text class="postcard__rank">{{ rankName }}</text>
        <view class="postcard__stats">
          <view class="pstat">
            <text class="pstat__v">{{ solvedCount }}</text>
            <text class="pstat__k">破案</text>
          </view>
          <view class="pstat">
            <text class="pstat__v">{{ streakCount }}</text>
            <text class="pstat__k">连续天数</text>
          </view>
          <view class="pstat">
            <text class="pstat__v">{{ lessonCount }}</text>
            <text class="pstat__k">检查单</text>
          </view>
        </view>
        <text class="postcard__slogan">看症状 · 立假设 · 算成本 · 定根因</text>
      </view>

      <view class="btnrow">
        <view class="primarybtn" @click="downloadPoster">
          <text class="primarybtn__text">保存海报 PNG</text>
        </view>
      </view>
      <text class="hint">H5 端下载 PNG 图片；App 端将支持保存到相册</text>

      <!-- 数据明细 -->
      <view class="card">
        <text class="card__title">档案数据</text>
        <view v-for="(row, i) in rows" :key="'r' + i" class="drow">
          <text class="drow__k">{{ row.k }}</text>
          <text class="drow__v">{{ row.v }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { ALL_CASES } from '../../data/cases'
import { getCaseProgress, getStreak, getChecklistUse, getTotals } from '../../utils/storage'
import { rankOf } from '../../utils/scoring'
import navbar from '../../components/navbar/navbar.uvue'

const rankName = ref('')
const solvedCount = ref(0)
const streakCount = ref(0)
const lessonCount = ref(0)
const rows = ref<{ k: string, v: string }[]>([])

function refresh() {
  const totals = getTotals(
    ALL_CASES.map((c) => c.id),
    ALL_CASES.map((c) => c.lessons.length)
  )
  solvedCount.value = totals.solved
  lessonCount.value = totals.lessons
  streakCount.value = getStreak().count
  const rk = rankOf(totals.solved)
  rankName.value = rk.name

  const list: { k: string, v: string }[] = []
  list.push({ k: '当前称号', v: rk.name })
  list.push({ k: '连续天数', v: String(streakCount.value) })
  list.push({ k: '累计破案', v: String(totals.solved) })
  list.push({ k: '检查单', v: String(totals.lessons) })
  list.push({ k: '已相遇吉祥物', v: totals.metMascots + ' / 5' })
  rows.value = list
}

// onShow 首次显示也会触发：海报数据随任务积累保持最新
onShow(() => refresh())

function downloadPoster() {
  // #ifdef WEB
  // Canvas 手绘同款海报 → toDataURL → 触发下载（无外部依赖；头像为同源静态资源不污染画布）
  const W = 750
  const H = 1000
  const c = document.createElement('canvas') as any
  c.width = W
  c.height = H
  const ctx = c.getContext('2d') as any
  if (ctx == null) {
    uni.showToast({ title: '当前浏览器不支持导出', icon: 'none' })
    return
  }
  // 奶油页底 + 深色档案卡
  ctx.fillStyle = '#FFF9F4'
  ctx.fillRect(0, 0, W, H)
  const cardX = 40
  const cardY = 40
  const cardW = W - 80
  const cardH = H - 80
  ctx.beginPath()
  if (ctx.roundRect != null) {
    ctx.roundRect(cardX, cardY, cardW, cardH, 28)
  } else {
    ctx.rect(cardX, cardY, cardW, cardH)
  }
  ctx.fillStyle = '#4A4458'
  ctx.fill()
  // 右上三色积木
  const bw = 22
  const gap = 8
  const colors = ['#FF8A5C', '#5FC9A5', '#6FB8E8']
  for (let i = 0; i < 3; i++) {
    ctx.fillStyle = colors[i]
    ctx.fillRect(cardX + cardW - 40 - (3 - i) * (bw + gap), cardY + 18, bw, bw)
  }
  const cx = W / 2
  const img = document.createElement('img') as any
  img.onload = () => {
    // 圆形头像
    const ay = 130
    const r = 80
    ctx.save()
    ctx.beginPath()
    ctx.arc(cx, ay + r, r, 0, Math.PI * 2)
    ctx.clip()
    ctx.fillStyle = '#5E5770'
    ctx.fillRect(cx - r, ay, r * 2, r * 2)
    ctx.drawImage(img, cx - r, ay, r * 2, r * 2)
    ctx.restore()
    // 文案
    ctx.textAlign = 'center'
    ctx.fillStyle = '#C9C2DA'
    ctx.font = '22px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('排错推理训练场 · 侦探档案', cx, ay + r * 2 + 56)
    ctx.fillStyle = '#FFC94D'
    ctx.font = 'bold 54px -apple-system, PingFang SC, sans-serif'
    ctx.fillText(rankName.value, cx, ay + r * 2 + 126)
    // 三列数据
    const stats: any[][] = [
      [String(solvedCount.value), '破案'],
      [String(streakCount.value), '连续天数'],
      [String(lessonCount.value), '检查单'],
    ]
    const colW = cardW / 3
    for (let i = 0; i < 3; i++) {
      const x = cardX + colW * i + colW / 2
      ctx.fillStyle = '#FFFFFF'
      ctx.font = 'bold 44px -apple-system, PingFang SC, sans-serif'
      ctx.fillText(stats[i][0], x, ay + r * 2 + 226)
      ctx.fillStyle = '#C9C2DA'
      ctx.font = '20px -apple-system, PingFang SC, sans-serif'
      ctx.fillText(stats[i][1], x, ay + r * 2 + 260)
    }
    ctx.fillStyle = '#9BD49B'
    ctx.font = '24px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('看症状 · 立假设 · 算成本 · 定根因', cx, ay + r * 2 + 340)
    // 触发下载
    const url = c.toDataURL('image/png')
    const a = document.createElement('a') as any
    a.href = url
    a.download = 'detective-card-' + Date.now() + '.png'
    document.body.appendChild(a)
    a.click()
    a.remove()
    uni.showToast({ title: '海报已开始下载', icon: 'none' })
  }
  img.onerror = () => {
    uni.showToast({ title: '头像加载失败', icon: 'none' })
  }
  img.src = '/static/mascots/frog-96.png'
  // #endif
  // #ifndef WEB
  uni.showToast({ title: 'App 端海报保存即将上线', icon: 'none' })
  // #endif
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  padding: 24rpx 32rpx 60rpx;
}
