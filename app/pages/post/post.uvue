<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <view class="content">
      <!-- 标题区（Figma：品牌行 / 大标题 / 英文小字） -->
      <text class="head__brand">好多星</text>
      <text class="head__title">侦 探 档 案</text>
      <text class="head__sub">AGENT-ERA DEBUGGER · DIAGNOSIS RECORD</text>

      <!-- 深色档案主卡（海报同款视觉） -->
      <view class="postcard">
        <view class="deco">
          <view class="deco__b deco__b--a"></view>
          <view class="deco__b deco__b--e"></view>
          <view class="deco__b deco__b--m"></view>
        </view>
        <view class="postcard__halo">
          <image class="postcard__avatar" :src="frogUrl" mode="aspectFit"></image>
        </view>
        <text class="postcard__rank">{{ rankName }}</text>
        <view class="postcard__divider"></view>
        <view class="postcard__stats">
          <view class="pstat">
            <text class="pstat__v">{{ solvedCount }}</text>
            <text class="pstat__k">破案</text>
          </view>
          <view class="pstat">
            <text class="pstat__v">{{ streakCount }}</text>
            <text class="pstat__k">连续天数</text>
          </view>
          <view class="pstat">
            <text class="pstat__v">{{ lessonCount }}</text>
            <text class="pstat__k">检查单</text>
          </view>
        </view>
        <text class="postcard__slogan">多想，多星。</text>
      </view>

      <!-- 层契约拼图条：每章一块，点亮 = 已破案 -->
      <view class="puzzle">
        <view class="puzzle__head">
          <text class="puzzle__title">层契约拼图</text>
          <text class="puzzle__count">{{ partSolved }} / {{ CHAPTERS.length }} 章</text>
        </view>
        <view class="puzzle__row">
          <view v-for="(ch, i) in CHAPTERS" :key="ch.id" :class="i < partSolved ? 'pblock pblock--lit' : 'pblock'">
            <text :class="i < partSolved ? 'pblock__text pblock__text--lit' : 'pblock__text'">章{{ i + 1 }}</text>
          </view>
        </view>
      </view>

      <!-- 扫码邀请卡 -->
      <view v-if="shareReady" class="qrcard">
        <image class="qrcard__qr" :src="qrDataUrl" mode="aspectFit"></image>
        <view class="qrcard__body">
          <text class="qrcard__title">扫码来挑战</text>
          <text class="qrcard__sub">把你的排错直觉，练成条件反射</text>
          <text class="qrcard__meta">{{ today }} · 侦探 No.0002</text>
        </view>
      </view>
      <text v-else class="sharehint">H5 公开地址配置后，海报会显示可扫码的试玩入口</text>

      <view class="btnrow">
        <view class="primarybtn" @click="downloadPoster">
          <text class="primarybtn__text">保存海报 PNG</text>
        </view>
      </view>
      <text class="hint">H5 端下载 PNG 图片；App 端将支持保存到相册</text>
      <text class="foot">—— 本档案由 好多星 生成 ——</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { getEffectiveCases } from '../../data/cases'
import { CHAPTERS, casesInChapter } from '../../data/chapters'
import { getCaseProgress, getStreak, getChecklistUse, getTotals } from '../../utils/storage'
import { rankOf } from '../../utils/scoring'
import { getMascotUrl } from '../../utils/remote-assets'
import { PUBLIC_H5_ORIGIN } from '../../config'
import { createPosterShareUrl, createQrDataUrl } from '../../utils/qr'

const frogUrl = getMascotUrl('frog')
import navbar from '../../components/navbar/navbar.uvue'

const rankName = ref('')
const solvedCount = ref(0)
const streakCount = ref(0)
const lessonCount = ref(0)
const partSolved = ref(0)
const qrDataUrl = ref('')
const today = ref('')
const shareUrl = PUBLIC_H5_ORIGIN.length > 0
  ? createPosterShareUrl(PUBLIC_H5_ORIGIN)
  : ''
const shareReady = shareUrl.length > 0

function refresh() {
  const cases = getEffectiveCases()
  const totals = getTotals(
    cases.map((c) => c.id),
    cases.map((c) => c.lessons.length)
  )
  solvedCount.value = totals.solved
  lessonCount.value = totals.lessons
  streakCount.value = getStreak().count
  const rk = rankOf(totals.solved)
  rankName.value = rk.name

  // 层契约拼图：已破案 ≥1 关的章数
  let lit = 0
  for (let i = 0; i < CHAPTERS.length; i++) {
    const list = casesInChapter(CHAPTERS[i].id)
    for (let j = 0; j < list.length; j++) {
      const p = getCaseProgress(list[j].id)
      if (p != null && p.solved) {
        lit++
        break
      }
    }
  }
  partSolved.value = lit

  if (shareReady) qrDataUrl.value = createQrDataUrl(shareUrl)

  const d = new Date()
  const mm = d.getMonth() + 1 < 10 ? '0' + (d.getMonth() + 1) : String(d.getMonth() + 1)
  const dd = d.getDate() < 10 ? '0' + d.getDate() : String(d.getDate())
  today.value = d.getFullYear() + '.' + mm + '.' + dd
}

// onShow 首次显示也会触发：海报数据随任务积累保持最新
onShow(() => refresh())

function downloadPoster() {
  // #ifdef WEB
  // Canvas 按 Figma 画板坐标（390×720）2x 手绘 → PNG 下载
  const BW = 390
  const BH = 720
  const c = document.createElement('canvas') as any
  c.width = BW * 2
  c.height = BH * 2
  const ctx = c.getContext('2d') as any
  if (ctx == null) {
    uni.showToast({ title: '当前浏览器不支持导出', icon: 'none' })
    return
  }
  ctx.scale(2, 2)
  // 奶油页底
  ctx.fillStyle = '#FFF9F4'
  ctx.fillRect(0, 0, BW, BH)
  ctx.textAlign = 'center'
  // 标题区
  ctx.fillStyle = '#FF8A5C'
  ctx.font = 'bold 13px -apple-system, PingFang SC, sans-serif'
  ctx.fillText('好多星', BW / 2, 40)
  ctx.fillStyle = '#4A4458'
  ctx.font = 'bold 26px -apple-system, PingFang SC, sans-serif'
  ctx.fillText('侦 探 档 案', BW / 2, 76)
  ctx.fillStyle = '#AFA8BD'
  ctx.font = '8px -apple-system, PingFang SC, sans-serif'
  ctx.fillText('AGENT-ERA DEBUGGER · DIAGNOSIS RECORD', BW / 2, 101)
  // 深色主卡
  const KX = 20, KY = 120, KW = 350, KH = 330
  ctx.beginPath()
  if (ctx.roundRect != null) ctx.roundRect(KX, KY, KW, KH, 24)
  else ctx.rect(KX, KY, KW, KH)
  ctx.fillStyle = '#4A4458'
  ctx.fill()
  const colors = ['#FF8A5C', '#5FC9A5', '#6FB8E8']
  for (let i = 0; i < 3; i++) {
    ctx.fillStyle = colors[i]
    ctx.fillRect(KX + KW - 26 - (3 - i) * 20, KY + 16, 14, 14)
  }
  const img = document.createElement('img') as any
  const drawPoster = (qrImg: any) => {
    // 吉祥物 + 光圈
    ctx.beginPath()
    ctx.arc(KX + KW / 2, KY + 92, 52, 0, Math.PI * 2)
    ctx.save()
    ctx.clip()
    const g = ctx.createLinearGradient(0, KY + 40, 0, KY + 144) as any
    g.addColorStop(0, '#5E5770')
    g.addColorStop(1, '#413B4D')
    ctx.fillStyle = g
    ctx.fillRect(KX + KW / 2 - 52, KY + 40, 104, 104)
    ctx.drawImage(img, KX + KW / 2 - 34, KY + 58, 68, 68)
    ctx.restore()
    // 称号 + 分隔虚线
    ctx.fillStyle = '#FFC94D'
    ctx.font = 'bold 26px -apple-system, PingFang SC, sans-serif'
    ctx.fillText(rankName.value, BW / 2, KY + 178)
    ctx.strokeStyle = '#5E5770'
    ctx.setLineDash([4, 4])
    ctx.beginPath()
    ctx.moveTo(KX + 90, KY + 202)
    ctx.lineTo(KX + KW - 90, KY + 202)
    ctx.stroke()
    ctx.setLineDash([])
    // 三列数据胶囊
    const stats: any[][] = [
      [String(solvedCount.value), '破案'],
      [String(streakCount.value), '连续天数'],
      [String(lessonCount.value), '检查单'],
    ]
    for (let i = 0; i < 3; i++) {
      const cw = 98
      const x = KX + 18 + i * (cw + 9)
      ctx.beginPath()
      if (ctx.roundRect != null) ctx.roundRect(x, KY + 220, cw, 64, 16)
      else ctx.rect(x, KY + 220, cw, 64)
      ctx.fillStyle = '#413B4D'
      ctx.fill()
      ctx.fillStyle = '#FFFFFF'
      ctx.font = 'bold 22px -apple-system, PingFang SC, sans-serif'
      ctx.fillText(stats[i][0], x + cw / 2, KY + 251)
      ctx.fillStyle = '#C9C2DA'
      ctx.font = '10px -apple-system, PingFang SC, sans-serif'
      ctx.fillText(stats[i][1], x + cw / 2, KY + 272)
    }
    ctx.fillStyle = '#9BD49B'
    ctx.font = 'bold 11px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('看症状 · 立假设 · 算成本 · 定根因', BW / 2, KY + 307)
    // 层契约拼图条
    ctx.textAlign = 'left'
    ctx.fillStyle = '#4A4458'
    ctx.font = 'bold 12px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('层契约拼图', 20, 483)
    ctx.textAlign = 'right'
    ctx.fillStyle = '#FF8A5C'
    ctx.fillText(partSolved.value + ' / ' + CHAPTERS.length + ' 章', 370, 483)
    ctx.textAlign = 'center'
    // 实体积木语言：点亮 = 章节色实心块 + 硬边投影 + 白字；未点亮 = 虚线空块
    const acc = ['#FF8A5C', '#FF8A5C', '#5FC9A5', '#6FB8E8', '#FFC94D', '#FFB5C8']
    const deep = ['#E06B38', '#E06B38', '#3FA885', '#4F93C4', '#D9A32E', '#E08AA6']
    for (let i = 0; i < 6; i++) {
      const x = 20 + i * 59
      if (i < partSolved.value) {
        ctx.beginPath()
        if (ctx.roundRect != null) ctx.roundRect(x + 1, 498, 51, 48, 12)
        else ctx.rect(x + 1, 498, 51, 48)
        ctx.fillStyle = deep[i]
        ctx.fill()
        ctx.beginPath()
        if (ctx.roundRect != null) ctx.roundRect(x, 494, 51, 48, 12)
        else ctx.rect(x, 494, 51, 48)
        ctx.fillStyle = acc[i]
        ctx.fill()
        ctx.fillStyle = '#FFFFFF'
      } else {
        ctx.beginPath()
        if (ctx.roundRect != null) ctx.roundRect(x, 494, 51, 48, 12)
        else ctx.rect(x, 494, 51, 48)
        ctx.fillStyle = '#FFFFFF'
        ctx.fill()
        ctx.strokeStyle = '#E3E6EB'
        ctx.lineWidth = 1.5
        ctx.setLineDash([4, 4])
        ctx.stroke()
        ctx.setLineDash([])
        ctx.fillStyle = '#AFA8BD'
      }
      ctx.font = 'bold 11px -apple-system, PingFang SC, sans-serif'
      ctx.fillText('章' + (i + 1), x + 25.5, 522)
    }
    if (shareReady) {
    // 扫码邀请卡
    ctx.beginPath()
    if (ctx.roundRect != null) ctx.roundRect(20, 556, 350, 120, 20)
    else ctx.rect(20, 556, 350, 120)
    ctx.fillStyle = '#FFFFFF'
    ctx.fill()
    ctx.strokeStyle = '#F5E6DA'
    ctx.lineWidth = 2
    ctx.stroke()
    ctx.drawImage(qrImg, 28, 564, 98, 98)
    ctx.textAlign = 'left'
    ctx.fillStyle = '#4A4458'
    ctx.font = 'bold 13px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('扫码来挑战', 140, 592)
    ctx.fillStyle = '#7A7290'
    ctx.font = '10px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('把你的排错直觉，练成条件反射', 140, 615)
    ctx.fillStyle = '#AFA8BD'
    ctx.font = '9px -apple-system, PingFang SC, sans-serif'
    ctx.fillText(today.value + ' · 侦探 No.0002', 140, 640)
    }
    ctx.textAlign = 'center'
    ctx.fillStyle = '#AFA8BD'
    ctx.font = '9px -apple-system, PingFang SC, sans-serif'
    ctx.fillText('—— 本档案由 好多星 生成 ——', BW / 2, 696)
    // 触发下载
    const url = c.toDataURL('image/png')
    const a = document.createElement('a') as any
    a.href = url
    a.download = 'detective-card-' + Date.now() + '.png'
    document.body.appendChild(a)
    a.click()
    a.remove()
    uni.showToast({ title: '海报已开始下载', icon: 'none' })
  }
  img.onload = () => {
    if (shareReady) {
      const qrImg = document.createElement('img') as any
      qrImg.onload = () => drawPoster(qrImg)
      qrImg.src = qrDataUrl.value
      return
    }
    drawPoster(null)
  }
  img.onerror = () => {
    uni.showToast({ title: '头像加载失败', icon: 'none' })
  }
  img.src = getMascotUrl('frog')
  // #endif
  // #ifndef WEB
  uni.showToast({ title: 'App 端海报保存即将上线', icon: 'none' })
  // #endif
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  min-height: 100vh;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  padding: 24rpx 32rpx 60rpx;
}
.content {
  display: flex;
  flex-direction: column;
  padding-top: 88rpx;
}
.head__brand {
  font-size: 24rpx;
  font-weight: bold;
  color: #FF8A5C;
  text-align: center;
}
.head__title {
  font-size: 50rpx;
  font-weight: bold;
  color: #4A4458;
  text-align: center;
  margin-top: 12rpx;
}
.head__sub {
  font-size: 17rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}
.postcard {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #4A4458;
  border-radius: 48rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #35303F;
  padding: 32rpx 30rpx 40rpx;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 0 0 #35303F;
}
.deco {
  position: absolute;
  top: 32rpx;
  right: 44rpx;
  display: flex;
  flex-direction: row;
}
.deco__b {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}
.deco__b--a { background-color: #FF8A5C; }
.deco__b--e { background-color: #5FC9A5; }
.deco__b--m { background-color: #6FB8E8; }
.postcard__halo {
  width: 208rpx;
  height: 208rpx;
  border-radius: 104rpx;
  background-color: #413B4D;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}
.postcard__avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 68rpx;
}
.postcard__rank {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFC94D;
  margin-top: 24rpx;
}
.postcard__divider {
  width: 336rpx;
  border-top-width: 2rpx;
  border-top-style: dashed;
  border-top-color: #5E5770;
  margin-top: 20rpx;
}
.postcard__stats {
  display: flex;
  flex-direction: row;
  width: 100%;
  margin-top: 36rpx;
}
.pstat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  background-color: #413B4D;
  border-radius: 32rpx;
  padding: 22rpx 0 18rpx;
  margin: 0 9rpx;
}
.pstat__v {
  font-size: 42rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.pstat__k {
  font-size: 19rpx;
  color: #C9C2DA;
  margin-top: 8rpx;
}
.postcard__slogan {
  font-size: 23rpx;
  font-weight: bold;
  color: #9BD49B;
  margin-top: 34rpx;
}
.puzzle {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
}
.puzzle__head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.puzzle__title {
  font-size: 25rpx;
  font-weight: bold;
  color: #4A4458;
}
.puzzle__count {
  font-size: 25rpx;
  font-weight: bold;
  color: #FF8A5C;
}
.puzzle__row {
  display: flex;
  flex-direction: row;
  /* 硬边阴影缓冲：pblock 贴行底，uni-view 默认 overflow:hidden 会裁阴影 */
  padding-bottom: 8rpx;
  margin-top: 18rpx;
}
.pblock {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: #FFFFFF;
  border-width: 2rpx;
  border-style: dashed;
  border-color: #E3E6EB;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pblock--lit {
  border-style: solid;
  border-color: rgba(0, 0, 0, 0);
}
.pblock--lit:nth-child(1) { box-shadow: 0 8rpx 0 0 #E06B38; background-color: #FF8A5C; }
.pblock--lit:nth-child(2) { box-shadow: 0 8rpx 0 0 #E06B38; background-color: #FF8A5C; }
.pblock--lit:nth-child(3) { box-shadow: 0 8rpx 0 0 #3FA885; background-color: #5FC9A5; }
.pblock--lit:nth-child(4) { box-shadow: 0 8rpx 0 0 #4F93C4; background-color: #6FB8E8; }
.pblock--lit:nth-child(5) { box-shadow: 0 8rpx 0 0 #D9A32E; background-color: #FFC94D; }
.pblock--lit:nth-child(6) { box-shadow: 0 8rpx 0 0 #E08AA6; background-color: #FFB5C8; }
.pblock__text {
  font-size: 21rpx;
  font-weight: bold;
  color: #AFA8BD;
}
.pblock__text--lit {
  color: #FFFFFF;
}
.qrcard {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  padding: 28rpx;
  margin-top: 36rpx;
  box-shadow: 0 6rpx 0 0 #EFE5D6;
}
.qrcard__box {
  width: 196rpx;
  height: 196rpx;
  margin-right: 24rpx;
}
.qrcard__qr { width: 100%; height: 100%; }
.qrcard__body {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
  flex: 1;
}
.qrcard__title {
  font-size: 27rpx;
  font-weight: bold;
  color: #4A4458;
}
.qrcard__sub {
  font-size: 21rpx;
  color: #7A7290;
  margin-top: 10rpx;
}
.qrcard__meta {
  font-size: 19rpx;
  color: #AFA8BD;
  margin-top: 14rpx;
}
.btnrow {
  display: flex;
  flex-direction: column;
  /* uni-view 运行时默认 overflow:hidden，给贴底按钮的硬边阴影留缓冲 */
  padding-bottom: 8rpx;
  margin-top: 36rpx;
  margin-bottom: 8rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 0 0 #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.hint {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 12rpx;
}
.sharehint {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 36rpx;
}
.foot {
  font-size: 19rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 30rpx;
}
</style>
