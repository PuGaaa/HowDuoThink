  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #4A4458;
  border-radius: 28rpx;
  padding: 40rpx 30rpx 34rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.deco {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  display: flex;
  flex-direction: row;
}
.deco__b {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.deco__b--a { background-color: #FF8A5C; }
.deco__b--e { background-color: #5FC9A5; }
.deco__b--m { background-color: #6FB8E8; }
.postcard__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background-color: #5E5770;
}
.postcard__brand {
  font-size: 20rpx;
  color: #C9C2DA;
  margin-top: 18rpx;
}
.postcard__rank {
  font-size: 44rpx;
  font-weight: bold;
  color: #FFC94D;
  margin-top: 10rpx;
}
.postcard__stats {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
  margin-top: 26rpx;
}
.pstat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.pstat__v {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.pstat__k {
  font-size: 19rpx;
  color: #C9C2DA;
  margin-top: 6rpx;
}
.postcard__slogan {
  font-size: 21rpx;
  color: #9BD49B;
  margin-top: 26rpx;
}
.btnrow {
  display: flex;
  flex-direction: column;
  /* uni-view 运行时默认 overflow:hidden，给贴底按钮的硬边阴影留缓冲 */
  padding-bottom: 8rpx;
  margin-bottom: 24rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 0 0 #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.hint {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-bottom: 26rpx;
}
.card {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F5E6DA;
  padding: 26rpx;
}
.card__title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 14rpx;
}
.drow {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 12rpx 0;
}
.drow__k {
  font-size: 24rpx;
  color: #7A7290;
}
.drow__v {
  font-size: 24rpx;
  font-weight: bold;
  color: #4A4458;
}
</style>
