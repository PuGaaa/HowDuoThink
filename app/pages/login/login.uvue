<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <view class="content">
      <text class="pagetitle">登录</text>

      <!-- 登录方式切换 -->
      <view class="seg">
        <view :class="tab === 'sms' ? 'seg__item seg__item--on' : 'seg__item'" @click="tab = 'sms'">
          <text :class="tab === 'sms' ? 'seg__text seg__text--on' : 'seg__text'">验证码登录</text>
        </view>
        <view :class="tab === 'pw' ? 'seg__item seg__item--on' : 'seg__item'" @click="tab = 'pw'">
          <text :class="tab === 'pw' ? 'seg__text seg__text--on' : 'seg__text'">密码登录</text>
        </view>
      </view>

      <view class="formcard">
        <!-- 验证码登录 -->
        <view v-if="tab === 'sms'">
          <view class="field">
            <text class="field__label">手机号</text>
            <input class="field__input" v-model="phone" type="number" maxlength="11" placeholder="11 位手机号" />
          </view>
          <view class="field">
            <text class="field__label">验证码</text>
            <view class="coderow">
              <input class="coderow__input" v-model="smsCode" type="number" maxlength="6" placeholder="6 位验证码" @confirm="doSmsLogin" />
              <view :class="countdown > 0 ? 'coderow__send coderow__send--dis' : 'coderow__send'" @click="sendCode">
                <text class="coderow__send-text">{{ countdown > 0 ? countdown + 's' : '获取验证码' }}</text>
              </view>
            </view>
          </view>
          <text v-if="errMsg.length > 0" class="formcard__err">{{ errMsg }}</text>
          <view class="btnpad">
            <view class="primarybtn" @click="doSmsLogin">
              <text class="primarybtn__text">{{ busy ? '登录中…' : '登录' }}</text>
            </view>
          </view>
        </view>

        <!-- 密码登录 -->
        <view v-else>
          <view class="field">
            <text class="field__label">账号</text>
            <input class="field__input" v-model="loginName" placeholder="账号" />
          </view>
          <view class="field">
            <text class="field__label">密码</text>
            <input class="field__input" v-model="password" :password="true" placeholder="密码" @confirm="doPwLogin" />
          </view>
          <text v-if="errMsg.length > 0" class="formcard__err">{{ errMsg }}</text>
          <view class="btnpad">
            <view class="primarybtn" @click="doPwLogin">
              <text class="primarybtn__text">{{ busy ? '登录中…' : '登录' }}</text>
            </view>
          </view>
        </view>
      </view>

      <text class="hint">Web 社区站注册的账号可直接登录 · 数据互通</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import navbar from '../../components/navbar/navbar.uvue'
import { getStoredUser, login, smsLogin, sendSmsCode, LoginResult } from '../../utils/auth'
import { prepareProgressIdentity, pullServerProgress, pushProgress } from '../../utils/sync-progress'

const tab = ref('sms')
const phone = ref('')
const smsCode = ref('')
const loginName = ref('')
const password = ref('')
const errMsg = ref('')
const busy = ref(false)
const countdown = ref(0)
let timer = 0
const returnCaseId = ref('')

onLoad((query: OnLoadOptions) => {
  const target = query['returnCaseId']
  returnCaseId.value = target == null ? '' : target as string
})

function startCountdown() {
  countdown.value = 60
  timer = setInterval(() => {
    countdown.value = countdown.value - 1
    if (countdown.value <= 0 && timer > 0) {
      clearInterval(timer)
      timer = 0
    }
  }, 1000)
}

function sendCode() {
  if (countdown.value > 0) return
  const p = phone.value.trim()
  if (p.length !== 11) {
    errMsg.value = '请输入 11 位手机号'
    return
  }
  errMsg.value = ''
  sendSmsCode(p, (r) => {
    if (r.error.length > 0) {
      errMsg.value = r.error
      return
    }
    if (r.devEcho.length > 0) {
      // dev 通道：验证码直接回显给联调
      smsCode.value = r.devEcho
      uni.showToast({ title: '验证码已自动填入（dev）', icon: 'none' })
    } else {
      uni.showToast({ title: '验证码已发送', icon: 'none' })
    }
    startCountdown()
  })
}

function finish(r: LoginResult) {
  busy.value = false
  if (r.error.length > 0) {
    errMsg.value = r.error
    return
  }
  uni.showToast({ title: '登录成功', icon: 'none' })
  const u = getStoredUser()
  if (u != null) prepareProgressIdentity(u.id)
  // 登录后：后端为唯一事实源，拉取账号的全量数据覆盖本地
  pushProgress((saved) => {
    if (saved.error.length > 0) {
      errMsg.value = '登录成功，但进度保存失败：' + saved.error
      return
    }
    pullServerProgress((pulled) => {
      if (pulled.error.length > 0) {
        errMsg.value = '登录成功，但账号进度拉取失败：' + pulled.error
        return
      }
      setTimeout(() => {
        if (returnCaseId.value.length > 0) {
          uni.navigateTo({ url: '/pages/play/play?id=' + returnCaseId.value })
        } else {
          uni.navigateBack({})
        }
      }, 600)
    })
  })
}

function doSmsLogin() {
  if (busy.value) return
  const p = phone.value.trim()
  if (p.length !== 11 || smsCode.value.length !== 6) {
    errMsg.value = '请输入手机号和 6 位验证码'
    return
  }
  errMsg.value = ''
  busy.value = true
  smsLogin(p, smsCode.value, (r) => finish(r))
}

function doPwLogin() {
  if (busy.value) return
  const name = loginName.value.trim()
  if (name.length === 0 || password.value.length === 0) {
    errMsg.value = '请输入账号和密码'
    return
  }
  errMsg.value = ''
  busy.value = true
  login(name, password.value, (r) => finish(r))
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  min-height: 100vh;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  padding: 24rpx 32rpx 60rpx;
}
.content {
  display: flex;
  flex-direction: column;
  padding-top: 88rpx;
}
.pagetitle {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 24rpx;
}
.seg {
  display: flex;
  flex-direction: row;
  background-color: #FBF3EB;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}
.seg__item {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  border-radius: 14rpx;
  padding: 14rpx;
}
.seg__item--on {
  background-color: #FF8A5C;
}
.seg__text {
  font-size: 25rpx;
  color: #7A7290;
}
.seg__text--on {
  color: #FFFFFF;
  font-weight: bold;
}
.formcard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  box-shadow: 0 6rpx 0 0 #EFE5D6;
}
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.field__label {
  font-size: 23rpx;
  font-weight: bold;
  color: #7A7290;
  margin-bottom: 10rpx;
}
.field__input {
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.coderow {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.coderow__input {
  flex: 1;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.coderow__send {
  margin-left: 14rpx;
  background-color: #FFF1E7;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}
.coderow__send--dis {
  opacity: 0.5;
}
.coderow__send-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF8A5C;
}
.formcard__err {
  font-size: 22rpx;
  color: #E86A6A;
  margin-top: 4rpx;
}
/* 硬边阴影缓冲：按钮贴卡片底，容器必须留出阴影高度 */
.btnpad {
  padding-bottom: 8rpx;
  margin-top: 16rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 0 0 #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.hint {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 18rpx;
  text-align: center;
  line-height: 32rpx;
}
</style>
