<template>
  <view class="page">
    <navbar></navbar>
    <view class="content">
      <text class="pagetitle">登录</text>

      <view class="formcard">
        <view class="field">
          <text class="field__label">账号</text>
          <input class="field__input" v-model="loginName" placeholder="账号" />
        </view>
        <view class="field">
          <text class="field__label">密码</text>
          <input class="field__input" v-model="password" :password="true" placeholder="密码" @confirm="doLogin" />
        </view>
        <text v-if="errMsg.length > 0" class="formcard__err">{{ errMsg }}</text>
        <view class="btnpad">
          <view class="primarybtn" @click="doLogin">
            <text class="primarybtn__text">{{ busy ? '登录中…' : '登录' }}</text>
          </view>
        </view>
      </view>

      <text class="hint">账号由团队发放，或在 Web 社区站用 GitHub 注册</text>
      <text class="hint">登录后可参与社区玩法；闯关进度仍保存在本机</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import navbar from '../../components/navbar/navbar.uvue'
import { login } from '../../utils/auth'

const loginName = ref('')
const password = ref('')
const errMsg = ref('')
const busy = ref(false)

function doLogin() {
  if (busy.value) return
  const name = loginName.value.trim()
  if (name.length === 0 || password.value.length === 0) {
    errMsg.value = '请输入账号和密码'
    return
  }
  errMsg.value = ''
  busy.value = true
  login(name, password.value, (r) => {
    busy.value = false
    if (r.error.length > 0) {
      errMsg.value = r.error
      return
    }
    uni.showToast({ title: '登录成功', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 600)
  })
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  padding: 24rpx 32rpx 60rpx;
}
.content {
  display: flex;
  flex-direction: column;
  padding-top: 110rpx;
}
.pagetitle {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 24rpx;
}
.formcard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  box-shadow: 0 6rpx 0 0 #EFE5D6;
}
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.field__label {
  font-size: 23rpx;
  font-weight: bold;
  color: #7A7290;
  margin-bottom: 10rpx;
}
.field__input {
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.formcard__err {
  font-size: 22rpx;
  color: #E86A6A;
  margin-top: 4rpx;
}
/* 硬边阴影缓冲：按钮贴卡片底，容器必须留出阴影高度 */
.btnpad {
  padding-bottom: 8rpx;
  margin-top: 16rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 0 0 #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.hint {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 18rpx;
  text-align: center;
  line-height: 32rpx;
}
</style>
