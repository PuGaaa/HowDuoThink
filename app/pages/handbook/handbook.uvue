<template>
  <view class="page">
    <view class="content">
      <text class="title">手册</text>

      <!-- 收集图鉴卡 -->
      <view class="rankcard">
        <image class="rankcard__avatar" src="/static/mascots/frog-96.png" mode="aspectFit"></image>
        <view class="rankcard__body">
          <text class="rankcard__label">收集图鉴</text>
          <text class="rankcard__name">已相遇 {{ met }} / 5 只</text>
          <view class="rankcard__track">
            <view class="rankcard__fill" :style="'width:' + metPct + '%'"></view>
          </view>
          <text class="rankcard__next">克服同一偏误 3 次，解锁它们的认可</text>
        </view>
      </view>

      <!-- 动物图鉴 -->
      <text class="sec">内心小动物图鉴</text>
      <view class="dex">
        <view v-for="(d, i) in dexList" :key="d.id" :class="d.met ? 'dexcard' : 'dexcard dexcard--off'">
          <view :class="d.met ? 'dexcard__badge' : 'dexcard__badge dexcard__badge--off'">
            <image class="dexcard__avatar" :src="'/static/mascots/' + d.id + '-96.png'" mode="aspectFit"></image>
          </view>
          <text :class="d.met ? 'dexcard__name' : 'dexcard__name dexcard__name--off'">{{ d.name }}</text>
          <text class="dexcard__trait">{{ d.trait }}</text>
          <text class="dexcard__quote">{{ d.quote }}</text>
          <text :class="d.met ? 'dexcard__count' : 'dexcard__count dexcard__count--off'">{{ d.count }}</text>
        </view>
      </view>

      <!-- 收集的检查单 -->
      <text class="sec">收集的检查单</text>
      <view v-if="lessonCards.length == 0" class="empty">
        <text class="empty__text">破案后，手册会开始变厚</text>
      </view>
      <view v-for="(lc, i) in lessonCards" :key="'lc' + i" class="lesson">
        <text class="lesson__text">☑ {{ lc.text }}</text>
        <text class="lesson__src">{{ lc.src }}</text>
      </view>

      <text class="footer">破案更多关卡，手册会越来越厚</text>
    </view>
    <tabbar active="handbook"></tabbar>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { ALL_CASES, getCaseById } from '../../data/cases'
import { getMascotStats, getCaseProgress } from '../../utils/storage'
import tabbar from '../../components/tabbar/tabbar.uvue'

class DexVM {
  id: string = ''
  name: string = ''
  trait: string = ''
  quote: string = ''
  count: string = ''
  met: boolean = false
}

class LessonCard {
  text: string = ''
  src: string = ''
}

const met = ref(0)
const metPct = ref(0)
const dexList = ref<DexVM[]>([])
const lessonCards = ref<LessonCard[]>([])

const stats = getMascotStats()
const defs = [
  { id: 'frog', name: '恐怖蛙', trait: '报错恐慌', quote: '呱——好多红色！完了完了要背锅了！', n: stats.frog },
  { id: 'otter', name: '惊讶濑', trait: '意外 = 信息', quote: '纳尼？！证据它自己说话了！', n: stats.otter },
  { id: 'snail', name: '不行蜗', trait: '盲扫', quote: '（慢慢探头）这两个动作，好像啥也没查出来。', n: stats.snail },
  { id: 'rabbit', name: '垂耳兔', trait: '过早锁定', quote: '（摇头）证据还不够，你只是想结束它。', n: stats.rabbit },
  { id: 'dino', name: '三角龙', trait: '挫败陪伴', quote: '（蹲下）这题是真难。坐一会儿。', n: stats.dino },
]
let metCount = 0
const list: DexVM[] = []
for (let i = 0; i < defs.length; i++) {
  const d = defs[i]
  const vm = new DexVM()
  vm.id = d.id
  vm.name = d.name
  vm.trait = d.trait
  vm.quote = d.quote
  vm.met = d.n > 0
  vm.count = d.n > 0 ? '出场 ' + d.n + ' 次' : '尚未相遇'
  if (vm.met) metCount++
  list.push(vm)
}
dexList.value = list
met.value = metCount
metPct.value = Math.round((metCount * 100) / 5)

// 收集的检查单：已破案案例的全部 lessons
const cards: LessonCard[] = []
for (let i = 0; i < ALL_CASES.length; i++) {
  const c = ALL_CASES[i]
  const p = getCaseProgress(c.id)
  if (p == null || !p.solved) continue
  for (let j = 0; j < c.lessons.length; j++) {
    const lc = new LessonCard()
    lc.text = c.lessons[j].text
    lc.src = '《' + c.title + '》 · ' + c.domain
    cards.push(lc)
  }
}
lessonCards.value = cards
</script>

