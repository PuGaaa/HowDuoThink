<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">

      <!-- 收集图鉴卡 -->
      <view class="rankcard">
        <image class="rankcard__avatar" :src="avatarSrc" mode="aspectFill"></image>
        <view class="rankcard__body">
          <text class="rankcard__label">诊断手册</text>
          <text class="rankcard__name">{{ lessonCount }} 条检查单</text>
          <text class="rankcard__next">来自 {{ solvedCount }} 次破案 · 累计查阅 {{ checkUse }} 次</text>
        </view>
      </view>

      <!-- 动物图鉴 -->
      <text class="sec">收集的检查单</text>
      <view v-if="lessonCards.length == 0" class="empty">
        <text class="empty__text">破案后，手册会开始变厚</text>
      </view>
      <view v-for="(lc, i) in lessonCards" :key="'lc' + i" :class="openIdx === i ? 'lesson lesson--open' : 'lesson'" @click="toggleLesson(i)">
        <view class="lesson__headrow">
        <image class="lesson__check" src="/static/icons/check-white.png" mode="aspectFit"></image>
        <text class="lesson__text">{{ lc.text }}</text>
      </view>
        <text class="lesson__src">{{ lc.src }}</text>
        <!-- 展开详情：层契约 + 原理注解（复盘室同款信息） -->
        <view v-if="openIdx === i" class="lesson__detail">
          <text class="lesson__layer">层契约 · {{ lc.layer }}</text>
          <text class="lesson__principle">{{ lc.principle }}</text>
        </view>
        <text class="lesson__hint">{{ openIdx === i ? '收起 ⌃' : '查看详解 ⌄' }}</text>
      </view>

      <text class="footer">破案更多关卡，手册会越来越厚</text>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { getEffectiveCases } from '../../data/cases'
import { getCaseProgress, getChecklistUse, bumpChecklistUse, bumpTask, getTaskDaily } from '../../utils/storage'
import { getAvatar as resolveAvatar } from '../../utils/auth'

class LessonCard {
  text: string = ''
  src: string = ''
  principle: string = ''
  layer: string = ''
}

const lessonCount = ref(0)
const solvedCount = ref(0)
const lessonCards = ref<LessonCard[]>([])
const checkUse = ref(0)
const avatarSrc = ref('')
const openIdx = ref(-1)

function refresh() {
  avatarSrc.value = resolveAvatar()
  const cards: LessonCard[] = []
  const cases = getEffectiveCases()
  let solvedCases = 0
  for (let i = 0; i < cases.length; i++) {
    const c = cases[i]
    const p = getCaseProgress(c.id)
    if (p == null || !p.solved) continue
    solvedCases++
    for (let j = 0; j < c.lessons.length; j++) {
      const lc = new LessonCard()
      lc.text = c.lessons[j].text
      lc.principle = c.lessons[j].principle
      lc.layer = c.layer
      lc.src = '《' + c.title + '》 · ' + c.domain
      cards.push(lc)
    }
  }
  lessonCards.value = cards
  checkUse.value = getChecklistUse()
  lessonCount.value = cards.length
  solvedCount.value = solvedCases
}

/** 展开检查单 = 复习一次：与局内核对走同一埋点链路（checklist_use），
 *  服务端投影同步计入每日/每周 checkuse，登录后进度不丢（见 utils/sync-progress.ts）。 */
function toggleLesson(i: number) {
  if (openIdx.value === i) {
    openIdx.value = -1
    return
  }
  openIdx.value = i
  const before = getTaskDaily('checkuse')
  bumpChecklistUse()
  bumpTask('checkuse', 1)
  if (before < 1) {
    uni.showToast({ title: '检查单复习 +1 · 已计入今日任务', icon: 'none' })
  }
}

// onShow 首次显示也会触发：新破案的检查单回到本页即可见
onShow(() => refresh())
</script>

