/* 遮罩 + 抽屉 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(42, 39, 51, 0.4);
  opacity: 0;
  z-index: 96;
  pointer-events: none;
}
.mask--show {
  opacity: 1;
  pointer-events: auto;
}
.drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  margin-left: auto;
  margin-right: auto;
  max-width: 480px;
  height: 90vh;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 32rpx 170rpx;
  transform: translateY(110%);
  transition-property: transform;
  transition-duration: 260ms;
  transition-timing-function: ease-out;
  z-index: 97;
  box-shadow: 0 -6rpx 0 0 #EFE5D6;;
}
.drawer--open {
  transform: translateY(0);
}
.drawer__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.drawer__handle {
  width: 88rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #E8E2D8;
  margin: 0 auto 20rpx;
}
.drawer__scroll {
  flex: 1;
}
.drawer__note {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 14rpx;
  text-align: center;
}

