<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <text class="pagetitle">找回密码</text>

      <view class="formcard">
        <!-- 第一步：短信验证手机号 -->
        <view v-if="step === 'verify'">
          <view class="field">
            <text class="field__label">手机号</text>
            <input class="field__input" v-model="phone" type="number" maxlength="11" placeholder="注册时使用的手机号" />
          </view>
          <view class="field">
            <text class="field__label">验证码</text>
            <view class="coderow">
              <input class="coderow__input" v-model="smsCode" type="number" maxlength="6" placeholder="6 位验证码" @confirm="doVerify" />
              <view :class="countdown > 0 ? 'coderow__send coderow__send--dis' : 'coderow__send'" @click="sendCode">
                <text class="coderow__send-text">{{ countdown > 0 ? countdown + 's' : '获取验证码' }}</text>
              </view>
            </view>
          </view>
          <text v-if="errMsg.length > 0" class="formcard__err">{{ errMsg }}</text>
          <view class="btnpad">
            <view class="primarybtn" @click="doVerify">
              <text class="primarybtn__text">{{ busy ? '验证中…' : '下一步' }}</text>
            </view>
          </view>
        </view>

        <!-- 第二步：手机号验证通过，设置新密码（免旧密码） -->
        <view v-else>
          <text class="formcard__tip">手机号已验证，请设置新密码</text>
          <view class="field">
            <text class="field__label">新密码</text>
            <input class="field__input" v-model="newPw" :password="true" placeholder="至少 6 位" />
          </view>
          <view class="field">
            <text class="field__label">确认新密码</text>
            <input class="field__input" v-model="confirmPw" :password="true" placeholder="再输入一次新密码" @confirm="doReset" />
          </view>
          <text v-if="errMsg.length > 0" class="formcard__err">{{ errMsg }}</text>
          <view class="btnpad">
            <view class="primarybtn" @click="doReset">
              <text class="primarybtn__text">{{ busy ? '提交中…' : '重置密码' }}</text>
            </view>
          </view>
        </view>
      </view>

      <text class="hint">重置后请用新密码登录；验证码登录依然可用</text>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import navbar from '../../components/navbar/navbar.uvue'
import { sendSmsCode, verifyResetCode, resetPassword } from '../../utils/auth'

const step = ref('verify')
const phone = ref('')
const smsCode = ref('')
const newPw = ref('')
const confirmPw = ref('')
const errMsg = ref('')
const busy = ref(false)
const countdown = ref(0)
let timer = 0
let resetToken = ''

function startCountdown() {
  countdown.value = 60
  timer = setInterval(() => {
    countdown.value = countdown.value - 1
    if (countdown.value <= 0 && timer > 0) {
      clearInterval(timer)
      timer = 0
    }
  }, 1000)
}

function sendCode() {
  if (countdown.value > 0) return
  const p = phone.value.trim()
  if (p.length !== 11) {
    errMsg.value = '请输入 11 位手机号'
    return
  }
  errMsg.value = ''
  sendSmsCode(p, (r) => {
    if (r.error.length > 0) {
      errMsg.value = r.error
      return
    }
    uni.showToast({ title: '验证码已发送', icon: 'none' })
    startCountdown()
  })
}

/** 第一步：验证通过换取重置票据，再进入设密步骤 */
function doVerify() {
  if (busy.value) return
  const p = phone.value.trim()
  if (p.length !== 11 || smsCode.value.length !== 6) {
    errMsg.value = '请输入手机号和 6 位验证码'
    return
  }
  errMsg.value = ''
  busy.value = true
  verifyResetCode(p, smsCode.value, (r) => {
    busy.value = false
    if (r.error.length > 0) {
      errMsg.value = r.error
      return
    }
    resetToken = r.resetToken
    step.value = 'reset'
  })
}

/** 第二步：凭票据免旧密码设新密码，成功后返回登录页 */
function doReset() {
  if (busy.value) return
  if (newPw.value.length < 6) {
    uni.showToast({ title: '新密码至少 6 位', icon: 'none' })
    return
  }
  if (newPw.value !== confirmPw.value) {
    uni.showToast({ title: '两次输入的新密码不一致', icon: 'none' })
    return
  }
  errMsg.value = ''
  busy.value = true
  resetPassword(resetToken, newPw.value, (r) => {
    busy.value = false
    if (r.error.length > 0) {
      errMsg.value = r.error
      // 票据失效（超时）：回到第一步重新验证
      if (r.error.indexOf('重新验证') >= 0) step.value = 'verify'
      return
    }
    uni.showToast({ title: '密码已重置，请用新密码登录', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 800)
  })
}
</script>

<style>
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.content {
  padding-top: 112rpx;
  padding-bottom: 60rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
}
.pagetitle {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 24rpx;
}
.formcard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #EFE5D6;
}
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.field__label {
  font-size: 23rpx;
  font-weight: bold;
  color: #7A7290;
  margin-bottom: 10rpx;
}
.field__input {
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.coderow {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.coderow__input {
  flex: 1;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.coderow__send {
  margin-left: 14rpx;
  background-color: #FFF1E7;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}
.coderow__send--dis {
  opacity: 0.5;
}
.coderow__send-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF8A5C;
}
.formcard__tip {
  font-size: 22rpx;
  color: #7A7290;
  margin-bottom: 18rpx;
}
.formcard__err {
  font-size: 22rpx;
  color: #E86A6A;
  margin-top: 4rpx;
}
/* 硬边阴影缓冲：按钮贴卡片底，容器必须留出阴影高度 */
.btnpad {
  padding-bottom: 8rpx;
  margin-top: 16rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  border-bottom-width: 8rpx; border-bottom-style: solid; border-bottom-color: #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.hint {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 18rpx;
  text-align: center;
  line-height: 32rpx;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
