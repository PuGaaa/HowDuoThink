<template>
  <view class="page">
    <view class="content">
      <view class="head">
        <text class="head__title">我的投稿</text>
        <text class="head__sub">被采纳的投稿将转化为正式关卡并署名</text>
      </view>

      <view v-if="items.length === 0" class="empty">
        <text class="empty__text">{{ loggedIn ? '还没有投稿——你的第一坑值得被所有人踩一遍' : '登录后查看我的投稿' }}</text>
        <view class="empty__btn" @click="goAction">
          <text class="empty__btn-text">{{ loggedIn ? '去投稿' : '去登录' }}</text>
        </view>
      </view>

      <view v-for="(it, i) in items" :key="'s' + i" class="card">
        <view class="card__toprow">
          <text class="card__title">{{ it.title }}</text>
          <text :class="'card__status card__status--' + it.status">{{ statusLabel(it.status) }}</text>
        </view>
        <text v-if="it.reviewNote.length > 0" class="card__note">编辑备注：{{ it.reviewNote }}</text>
        <text class="card__date">{{ it.createdAt }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { isLoggedIn, getToken } from '../../utils/auth'
import { API_BASE } from '../../config'

interface SubVM {
  id: string
  title: string
  status: string
  reviewNote: string
  createdAt: string
}
const items = ref<SubVM[]>([])
const loggedIn = ref(isLoggedIn())

function statusLabel(s: string): string {
  if (s === 'pending') return '审核中'
  if (s === 'accepted') return '已采纳'
  if (s === 'rejected') return '未采纳'
  if (s === 'archived') return '已归档'
  return s
}

function goAction() {
  if (loggedIn.value) {
    uni.navigateTo({ url: '/pages/submit/submit' })
    return
  }
  uni.navigateTo({ url: '/pages/login/login' })
}

function refresh() {
  loggedIn.value = isLoggedIn()
  if (!loggedIn.value) {
    items.value = []
    return
  }
  uni.request({
    url: API_BASE + '/api/me/submissions',
    method: 'GET',
    header: { Authorization: 'Bearer ' + getToken() } as any,
    timeout: 8000,
    success: (res) => {
      if (res.statusCode !== 200) return
      const arr = res.data as any[]
      const out: SubVM[] = []
      for (let i = 0; i < arr.length; i++) {
        const it = arr[i]
        const vm = new SubVM()
        vm.id = it.id
        vm.title = it.title
        vm.status = it.status
        vm.reviewNote = it.reviewNote ?? ''
        vm.createdAt = it.createdAt ?? ''
        out.push(vm)
      }
      items.value = out
    },
  })
}

onShow(() => refresh())
</script>

<style>
.page {
  background-color: #FAF6F0;
  min-height: 100vh;
}
.content {
  padding: 24rpx 28rpx 60rpx 28rpx;
}
.head {
  margin-bottom: 24rpx;
}
.head__title {
  font-size: 40rpx;
  font-weight: bold;
  color: #332C4E;
}
.head__sub {
  display: block;
  font-size: 22rpx;
  color: #8F87A3;
  margin-top: 8rpx;
}
.empty {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty__text {
  font-size: 24rpx;
  color: #8F87A3;
  text-align: center;
}
.empty__btn {
  margin-top: 24rpx;
  background-color: #FF7A50;
  border-radius: 32rpx;
  padding: 16rpx 48rpx;
}
.empty__btn-text {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
}
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}
.card__toprow {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.card__title {
  font-size: 28rpx;
  font-weight: bold;
  color: #332C4E;
}
.card__status {
  font-size: 20rpx;
  font-weight: bold;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}
.card__status--pending {
  color: #B7791F;
  background-color: #FDF3DC;
}
.card__status--accepted {
  color: #1F7A4D;
  background-color: #DFF3E7;
}
.card__status--rejected {
  color: #B04A3A;
  background-color: #F9E2DC;
}
.card__status--archived {
  color: #8F87A3;
  background-color: #EFEAF4;
}
.card__note {
  font-size: 22rpx;
  color: #8F87A3;
  margin-top: 12rpx;
}
.card__date {
  font-size: 20rpx;
  color: #C3BDD2;
  margin-top: 10rpx;
}
</style>
