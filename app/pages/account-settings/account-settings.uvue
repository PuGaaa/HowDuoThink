<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <text class="pagetitle">账号设置</text>

      <!-- 账号 -->
      <text class="sec">账号</text>
      <view class="row" @click="goPassword">
        <text class="row__label">账号密码</text>
        <text class="row__value">设置 / 修改密码</text>
        <image class="row__chevron" src="/static/icons/arrowr-coral.png" mode="aspectFit"></image>
      </view>

      <!-- 危险区：注销账号（仅登录态显示；Apple 5.1.1(v) 要求的账号自删入口） -->
      <text v-if="loggedIn" class="sec">危险操作</text>
      <view v-if="loggedIn" class="dangerrow" @click="onDelete">
        <view class="dangerrow__main">
          <text class="dangerrow__label">注销账号</text>
          <text class="dangerrow__hint">删除本账号并清除云端数据，手机号匿名化，不可恢复</text>
        </view>
        <image class="row__chevron" src="/static/icons/arrowr-coral.png" mode="aspectFit"></image>
      </view>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import navbar from '../../components/navbar/navbar.uvue'
import { deleteAccount, deleteAccountLocal, isLoggedIn } from '../../utils/auth'
import { openConfirmDialog, ConfirmDialogOptions } from '../../utils/confirm-dialog'

const busy = ref(false)
const loggedIn = ref(isLoggedIn())

function goPassword() {
  uni.navigateTo({ url: '/pages/password/password' })
}

function onDelete() {
  if (busy.value) return
  // 二次确认必须写清后果：账号不可恢复 / 本机与云端进度清除不可用 / 手机号匿名化
  const opt = {
    title: '注销账号',
    message: '注销后账号将不可恢复：手机号将被匿名化，本机与云端的学习进度将被清除且不再可用。确定要注销吗？',
    confirmText: '确认注销',
    cancelText: '再想想',
    danger: true,
  } as ConfirmDialogOptions
  openConfirmDialog(opt, (confirm: boolean) => {
    if (!confirm) return
    busy.value = true
    deleteAccount((r) => {
      busy.value = false
      if (r.error.length > 0) {
        uni.showToast({ title: r.error, icon: 'none' })
        return
      }
      loggedIn.value = false
      deleteAccountLocal()
      uni.showToast({ title: '账号已注销', icon: 'none' })
      // 回「我的」页：onShow 会刷新为未登录态展示
      setTimeout(() => {
        uni.navigateBack({})
      }, 600)
    })
  })
}
</script>

<style>
