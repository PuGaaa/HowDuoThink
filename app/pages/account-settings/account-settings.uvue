  font-size: 44rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 24rpx;
}
.sec {
  font-size: 26rpx;
  font-weight: bold;
  color: #7A7290;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F5E6DA;
  padding: 26rpx;
  margin-bottom: 16rpx;
  border-bottom-width: 5rpx; border-bottom-style: solid; border-bottom-color: #EFE5D6;;
}
.row__label {
  font-size: 25rpx;
  font-weight: 500;
  color: #4A4458;
  flex: 1;
}
.row__value {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-right: 12rpx;
}
.row__chevron {
  width: 24rpx;
  height: 24rpx;
}
/* 危险行：白底红边红字，与普通行区分（对齐我的页退出登录按钮的 danger 配色） */
.dangerrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F5D5D5;
  padding: 26rpx;
  margin-bottom: 16rpx;
  border-bottom-width: 5rpx; border-bottom-style: solid; border-bottom-color: #F5D5D5;
}
.dangerrow__main {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 12rpx;
}
.dangerrow__label {
  font-size: 25rpx;
  font-weight: bold;
  color: #E86A6A;
}
.dangerrow__hint {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 6rpx;
  line-height: 30rpx;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
