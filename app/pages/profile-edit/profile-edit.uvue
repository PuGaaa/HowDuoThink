<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <text class="pagetitle">编辑资料</text>

      <view class="formcard">
        <text class="formcard__label">头像</text>
        <view class="avgrid">
          <view
            v-for="(it, i) in presets"
            :key="'a' + i"
            class="avgrid__item"
            @click="selIdx = i"
          >
            <image :class="selIdx === i ? 'avgrid__img avgrid__img--on' : 'avgrid__img'" :src="it.path" mode="aspectFill"></image>
            <view v-if="selIdx === i" class="avgrid__check">
              <image class="avgrid__check-img" src="/static/icons/check-white.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>

        <text class="formcard__label formcard__label--gap">昵称</text>
        <input class="field__input" v-model="nickname" maxlength="16" placeholder="16 字以内" />
        <text class="formcard__tip">{{ nameHint }}</text>

        <view class="btnpad">
          <view class="primarybtn" @click="save">
            <text class="primarybtn__text">{{ busy ? '保存中…' : '保存' }}</text>
          </view>
        </view>
      </view>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import navbar from '../../components/navbar/navbar.uvue'
import { getAvatar, getDisplayName, setLocalAvatar, updateName, updateAvatar, isLoggedIn } from '../../utils/auth'
import { getAvatarPresets } from '../../utils/remote-assets'

class PresetVM {
  path: string = ''
}

// 头像池来自后端派发（/api/app-resources），包内不再带预设头像
const presets = ref<PresetVM[]>([])
const remotePresets = getAvatarPresets()
for (let i = 0; i < remotePresets.length; i++) {
  const vm = new PresetVM()
  vm.path = remotePresets[i]
  presets.value.push(vm)
}
const cur = getAvatar()
let initIdx = 0
for (let i = 0; i < presets.value.length; i++) {
  if (presets.value[i].path === cur) { initIdx = i; break }
}
const selIdx = ref(initIdx)
const nickname = ref(getDisplayName())
const busy = ref(false)
const nameHint = isLoggedIn() ? '保存后同步到社区账号' : '未登录：仅保存在本机'

function save() {
  const name = nickname.value.trim()
  if (name.length === 0) {
    uni.showToast({ title: '昵称不能为空', icon: 'none' })
    return
  }
  if (presets.value.length === 0) {
    uni.showToast({ title: '头像池未就绪，请稍后重试', icon: 'none' })
    return
  }
  if (busy.value) return
  busy.value = true
  const presetPath = presets.value[selIdx.value].path
  if (isLoggedIn()) {
    updateName(name, (nameResult) => {
      if (nameResult.error.length > 0) {
        busy.value = false
        uni.showToast({ title: nameResult.error, icon: 'none' })
        return
      }
      updateAvatar(presetPath, (avatarResult) => {
        busy.value = false
        if (avatarResult.error.length > 0) {
          uni.showToast({ title: avatarResult.error, icon: 'none' })
          return
        }
        uni.navigateBack({})
      })
    })
    return
  }
  setLocalAvatar(presetPath)
  updateName(name, (r) => {
    busy.value = false
    if (r.error.length > 0) {
      uni.showToast({ title: r.error, icon: 'none' })
      return
    }
    uni.showToast({ title: '已保存', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 600)
  })
}
</script>

<style>
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.content {
  padding-top: 112rpx;
  padding-bottom: 60rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
}
.pagetitle {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 24rpx;
}
.formcard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #EFE5D6;
}
.formcard__label {
  font-size: 23rpx;
  font-weight: bold;
  color: #7A7290;
  margin-bottom: 16rpx;
}
.formcard__label--gap {
  margin-top: 26rpx;
}
/* 网格宽 630rpx（750-64-56）：4 列 × 144rpx + space-between 3 × 18rpx 正好铺满 */
.avgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
/* item 是无圆角方形透明盒：原生端圆角容器会裁切子元素（选中勾曾只剩月牙） */
.avgrid__item {
  width: 144rpx;
  height: 144rpx;
  margin-bottom: 18rpx;
  position: relative;
}
.avgrid__img {
  width: 136rpx;
  height: 136rpx;
  border-radius: 72rpx;
  background-color: #FBF3EB;
  border-width: 4rpx;
  border-style: solid;
  border-color: rgba(0, 0, 0, 0);
}
.avgrid__img--on {
  border-color: #FF8A5C;
}
.avgrid__check {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background-color: #5FC9A5;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.avgrid__check-img {
  width: 24rpx;
  height: 24rpx;
}
.field__input {
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.formcard__tip {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 12rpx;
}
/* 硬边阴影缓冲 */
.btnpad {
  padding-bottom: 8rpx;
  margin-top: 26rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  border-bottom-width: 8rpx; border-bottom-style: solid; border-bottom-color: #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
