<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <!-- 章头（Figma：胶囊章号与章名同行 + 层契约 + 进度行） -->
      <view class="hero">
        <view class="hero__titlerow">
          <view class="hero__no">
            <text class="hero__no-text">{{ ch.no }}</text>
          </view>
          <text class="hero__name">{{ ch.name }}</text>
        </view>
        <text class="hero__pact" max-lines="1">层契约：{{ ch.pact }}</text>
        <text class="hero__meta">主线进度 {{ solvedInChapter }}/{{ totalInChapter }} · 检查单 {{ lessonCount }} 条</text>
      </view>

      <!-- 关卡路径 -->
      <view v-for="(node, i) in nodes" :key="node.id" class="nodewrap">
        <text v-if="i === 0 || node.section !== nodes[i - 1].section" class="section-title">{{ node.section }}</text>
        <view v-else class="conn"></view>
        <view :class="node.playable ? 'node node--live' : 'node'" @click="openCase(node)">
          <view :class="node.playable ? 'node__icon node__icon--live' : 'node__icon'">
            <image v-if="node.playable" class="node__bolt" src="/static/icons/bolt-white.png" mode="aspectFit"></image>
            <image v-else class="node__bolt" src="/static/icons/lock-ink3.png" mode="aspectFit"></image>
          </view>
          <view class="node__body">
            <text :class="node.playable ? 'node__title' : 'node__title node__title--locked'" max-lines="2">{{ node.title }}</text>
          </view>
          <text v-if="node.failed" class="node__fail">未破</text>
          <view v-else-if="node.playable && !node.challenged" class="node__go">
            <text class="node__go-text">去挑战</text>
            <image class="node__go-arrow" src="/static/icons/v4/arrow-right-white.png" mode="aspectFit"></image>
          </view>
          <text v-else-if="node.playable" class="node__stars">{{ node.stars }}</text>
          <view v-else class="node__offchip">
            <text class="node__offchip-text">{{ node.challenge ? '跳级挑战' : '未解锁' }}</text>
          </view>
        </view>
        <view v-if="i === nodes.length - 1" class="node__tailpad"></view>
      </view>
      <text class="footer">通关本章，解锁「{{ ch.name }}」层契约拼图</text>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { CHAPTERS, casesInChapter, isChapterUnlocked, isCasePlayable, chapterChallengeCaseId, chapterUnlockHint } from '../../data/chapters'
import { CASE_CATALOG, MAINLINE_CASE_IDS } from '../../data/cases'
import { getCaseProgress } from '../../utils/storage'
import { starsLabel } from '../../utils/scoring'
import { isLoggedIn } from '../../utils/auth'
import { openGuestLoginDialog } from '../../utils/login-guide'
import navbar from '../../components/navbar/navbar.uvue'

class NodeVM {
  id: string = ''
  title: string = ''
  stars: string = ''
  live: boolean = false
  playable: boolean = false
  challenge: boolean = false
  /** 是否已挑战过（有最佳成绩）：右侧显示星级而非"去挑战"胶囊 */
  challenged: boolean = false
  /** 玩过未破（失败留痕：地图"未破"标 + 重练引导） */
  failed: boolean = false
  fails: number = 0
  section: string = ''
}

const ch = ref(CHAPTERS[0])
const nodes = ref<NodeVM[]>([])
const solvedInChapter = ref(0)
const totalInChapter = ref(0)
const lessonCount = ref(0)

onLoad((query : OnLoadOptions) => {
  const cid = query['id']
  let idx = 0
  if (cid != null) {
    for (let i = 0; i < CHAPTERS.length; i++) {
      if (CHAPTERS[i].id === (cid as string)) { idx = i; break }
    }
  }
  ch.value = CHAPTERS[idx]
  const chapterOpen = isChapterUnlocked(ch.value.id)
  const challengeId = chapterChallengeCaseId(ch.value.id)
  const list: NodeVM[] = []
  let solved = 0
  const list_cases = casesInChapter(ch.value.id)
  for (let i = 0; i < list_cases.length; i++) {
    const c = list_cases[i]
    const vm = new NodeVM()
    vm.id = c.id
    vm.title = c.title
    const mainline = MAINLINE_CASE_IDS.indexOf(c.id) >= 0
    const official = CASE_CATALOG[c.id] != null || c.sourceType === 'official'
    vm.section = mainline ? '主线训练' : official ? '更多练习 · 选做' : '社区实战 · 选做'
    vm.live = true
    vm.playable = isCasePlayable(c.id)
    vm.challenge = !chapterOpen && isLoggedIn() && c.id === challengeId
    const p = getCaseProgress(c.id)
    const best = p != null && p.bestGrade.length > 0 ? p.bestGrade : ''
    vm.stars = starsLabel(best)
    vm.challenged = best.length > 0
    if (p != null && !p.solved && p.fails > 0) {
      vm.failed = true
      vm.fails = p.fails
    }
    if (mainline && p != null && p.solved) solved++
    list.push(vm)
  }
  nodes.value = list
  solvedInChapter.value = solved
  totalInChapter.value = list_cases.filter((c) => MAINLINE_CASE_IDS.indexOf(c.id) >= 0).length
  // 章内检查单总数（Figma hero 进度行）
  let lessons = 0
  for (let i = 0; i < list_cases.length; i++) {
    lessons += list_cases[i].lessons.length
  }
  lessonCount.value = lessons
})

function openCase(node: NodeVM) {
  if (!node.live) {
    uni.showToast({ title: '本题即将上线', icon: 'none' })
    return
  }
  // 实时判可玩（登录返回等场景下 vm.playable 可能是旧快照）
  if (!isCasePlayable(node.id)) {
    if (!isLoggedIn()) {
      openGuestLoginDialog(node.id)
      return
    }
    uni.showToast({ title: chapterUnlockHint(ch.value.id), icon: 'none' })
    return
  }
  uni.navigateTo({ url: '/pages/play/play?id=' + node.id + '&source=chapter' })
}
</script>

<style>
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.content {
  padding-top: 120rpx;
  padding-bottom: 32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
}
.hero {
  display: flex;
  flex-direction: column;
  background-color: #FFF1E7;
  border-radius: 20rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F3CFA9;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  border-bottom-width: 8rpx; border-bottom-style: solid; border-bottom-color: #F3CFA9;
}
.hero__titlerow {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.hero__no {
  background-color: #FF8A5C;
  border-radius: 22rpx;
  padding: 8rpx 20rpx;
}
.hero__no-text {
  font-size: 18rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.hero__name {
  font-size: 34rpx;
  font-weight: bold;
  color: #4A4458;
  margin-left: 16rpx;
  flex: 1;
}
.hero__pact {
  font-size: 20rpx;
  color: #8A8499;
  margin-top: 10rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}
.hero__meta {
  font-size: 20rpx;
  font-weight: bold;
  color: #FF8A5C;
  margin-top: 12rpx;
}
.conn {
  width: 4rpx;
  height: 20rpx;
  margin-left: 88rpx;
  border-left-width: 3rpx;
  border-left-style: dashed;
  border-left-color: #FFB5C8;
}
.section-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #8A8499;
  margin-top: 16rpx;
  margin-bottom: 18rpx;
}
.node__tailpad {
  height: 6rpx;
}
/* 硬边阴影缓冲：v-for 包裹层默认 overflow:hidden，node 卡贴层底会裁阴影 */
.nodewrap {
  padding-bottom: 6rpx;
}
/* uvue 不支持后代选择器：conn 仅在 nodewrap 内使用，高度并入基类 */
.node {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border-width: 2rpx;
  border-style: dashed;
  border-color: #F5E6DA;
  padding: 20rpx;
  border-bottom-width: 5rpx; border-bottom-style: solid; border-bottom-color: #EFE5D6;;
}
.node--live {
  border-style: solid;
  border-color: #FF8A5C;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #F3CFA9;;
}
.node__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background-color: #FBF3EB;
  margin-right: 18rpx;
}
.node__icon--live {
  background-color: #FF8A5C;
}
.node__bolt {
  width: 34rpx;
  height: 34rpx;
  margin: 17rpx;
}
/* 清单版：标题单行占满，状态由右侧徽章表达 */
.node__body {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}
.node__title {
  flex: 1;
  font-size: 27rpx;
  font-weight: bold;
  color: #4A4458;
  text-overflow: ellipsis;
  overflow: hidden;
}
.node__title--locked {
  color: #7A7290;
}
.node__stars {
  font-size: 24rpx;
  color: #FFC94D;
  font-weight: bold;
}
/* 未挑战 = 迷你实心 CTA（与首页 hero 卡同款渐变），与已挑战的金色星级区分 */
.node__go {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* iOS 对 90deg 角度形式兼容不稳：用 to right 关键字形式 + 纯色兜底（渐变失效时仍有橙底） */
  background-color: #FF7047;
  background-image: linear-gradient(to right, #FF8A5C, #FF5A3D);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}
.node__go-text {
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.node__go-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
}
.node__fail {
  font-size: 18rpx;
  font-weight: bold;
  color: #E06B38;
  background-color: #FFF1E7;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F3CFA9;
  border-radius: 26rpx;
  padding: 8rpx 20rpx;
}
.node__offchip {
  border-width: 1.5rpx;
  border-style: dashed;
  border-color: #F5E6DA;
  border-radius: 26rpx;
  padding: 8rpx 20rpx;
}
.node__offchip-text {
  font-size: 18rpx;
  color: #AFA8BD;
}
.footer {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 26rpx;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
