  font-size: 20rpx;
  font-weight: bold;
  color: #FF8A5C;
  margin-top: 14rpx;
}
.conn {
  width: 4rpx;
  height: 26rpx;
  margin-left: 108rpx;
  border-left-width: 3rpx;
  border-left-style: dashed;
  border-left-color: #FFB5C8;
}
.node {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border-width: 2rpx;
  border-style: dashed;
  border-color: #F5E6DA;
  padding: 22rpx;
  box-shadow: 0 5rpx 0 0 #EFE5D6;;
}
