<template>
  <view class="page">
    <navbar></navbar>
    <view class="content">
      <!-- 章头（Figma：胶囊章号与章名同行 + 层契约 + 进度行） -->
      <view class="hero">
        <view class="hero__titlerow">
          <view class="hero__no">
            <text class="hero__no-text">{{ ch.no }}</text>
          </view>
          <text class="hero__name">{{ ch.name }}</text>
        </view>
        <text class="hero__pact">层契约：{{ ch.pact }}</text>
        <text class="hero__meta">进度 {{ solvedInChapter }}/{{ totalInChapter }} · 收集检查单 {{ lessonCount }} 条</text>
      </view>

      <!-- 关卡路径 -->
      <view v-for="(node, i) in nodes" :key="node.id" class="nodewrap">
        <view v-if="i > 0" class="conn"></view>
        <view :class="node.playable ? 'node node--live' : 'node'" @click="openCase(node)">
          <view :class="node.playable ? 'node__icon node__icon--live' : 'node__icon'">
            <image v-if="node.playable" class="node__bolt" src="/static/icons/bolt-white.png" mode="aspectFit"></image>
            <image v-else class="node__bolt" src="/static/icons/lock-ink3.png" mode="aspectFit"></image>
          </view>
          <view class="node__body">
            <text :class="node.playable ? 'node__title' : 'node__title node__title--locked'">{{ node.title }}</text>
            <text class="node__meta">{{ node.meta }}</text>
          </view>
          <text v-if="node.playable" class="node__stars">{{ node.stars }}</text>
          <view v-else class="node__offchip">
            <text class="node__offchip-text">{{ node.challenge ? '跳级挑战' : '未解锁' }}</text>
          </view>
        </view>
        <view v-if="i === nodes.length - 1" class="node__tailpad"></view>
      </view>
      <text class="footer">通关本章，解锁「{{ ch.name }}」层契约拼图</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { CHAPTERS, casesInChapter, isChapterUnlocked, isCasePlayable, chapterChallengeCaseId, chapterUnlockHint } from '../../data/chapters'
import { ALL_CASES, getCaseById } from '../../data/cases'
import { getCaseProgress } from '../../utils/storage'
import { starsLabel } from '../../utils/scoring'
import navbar from '../../components/navbar/navbar.uvue'

class NodeVM {
  id: string = ''
  title: string = ''
  meta: string = ''
  stars: string = ''
  live: boolean = false
  playable: boolean = false
  challenge: boolean = false
}

const ch = ref(CHAPTERS[0])
const nodes = ref<NodeVM[]>([])
const solvedInChapter = ref(0)
const totalInChapter = ref(0)
const lessonCount = ref(0)

onLoad((query : OnLoadOptions) => {
  const cid = query['id']
  let idx = 0
  if (cid != null) {
    for (let i = 0; i < CHAPTERS.length; i++) {
      if (CHAPTERS[i].id === (cid as string)) { idx = i; break }
    }
  }
  ch.value = CHAPTERS[idx]
  const chapterOpen = isChapterUnlocked(ch.value.id)
  const challengeId = chapterChallengeCaseId(ch.value.id)
  const list: NodeVM[] = []
  let solved = 0
  const list_cases = casesInChapter(ch.value.id)
  for (let i = 0; i < list_cases.length; i++) {
    const c = list_cases[i]
    const vm = new NodeVM()
    vm.id = c.id
    vm.title = c.title
    vm.live = true
    vm.playable = chapterOpen || c.id === challengeId
    vm.challenge = !chapterOpen && c.id === challengeId
    const p = getCaseProgress(c.id)
    const best = p != null && p.bestGrade.length > 0 ? p.bestGrade : ''
    vm.stars = starsLabel(best)
    if (vm.challenge) {
      vm.meta = '跳级挑战 · 赢了立即解锁本章 · ' + (best.length > 0 ? '最佳 ' + p!.bestCost + '⚡︎' : '未挑战')
    } else {
      vm.meta = '★★ 标准 · ' + (best.length > 0 ? '最佳 ' + p!.bestCost + '⚡︎' : '未挑战')
    }
    if (p != null && p.solved) solved++
    list.push(vm)
  }
  nodes.value = list
  solvedInChapter.value = solved
  totalInChapter.value = list_cases.length
  // 章内检查单总数（Figma hero 进度行）
  let lessons = 0
  for (let i = 0; i < list_cases.length; i++) {
    lessons += list_cases[i].lessons.length
  }
  lessonCount.value = lessons
})

function openCase(node: NodeVM) {
  if (!node.live) {
    uni.showToast({ title: '本题即将上线', icon: 'none' })
    return
  }
  if (!node.playable) {
    uni.showToast({ title: chapterUnlockHint(ch.value.id), icon: 'none' })
    return
  }
  uni.navigateTo({ url: '/pages/play/play?id=' + node.id })
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  padding: 32rpx;
}
.content {
  display: flex;
  flex-direction: column;
  padding-top: 120rpx;
}
.hero {
  display: flex;
  flex-direction: column;
  background-color: #FFF1E7;
  border-radius: 20rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #F3CFA9;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 0 0 #F3CFA9;
}
.hero__titlerow {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.hero__no {
  background-color: #FF8A5C;
  border-radius: 22rpx;
  padding: 8rpx 20rpx;
}
.hero__no-text {
  font-size: 18rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.hero__name {
  font-size: 34rpx;
  font-weight: bold;
  color: #4A4458;
  margin-left: 16rpx;
  flex: 1;
}
.hero__pact {
  font-size: 22rpx;
  color: #7A7290;
  margin-top: 12rpx;
  line-height: 34rpx;
}
.hero__meta {
  font-size: 21rpx;
  font-weight: bold;
  color: #FF8A5C;
  margin-top: 14rpx;
}
.conn {
  width: 4rpx;
  height: 26rpx;
  margin-left: 108rpx;
  border-left-width: 3rpx;
  border-left-style: dashed;
  border-left-color: #FFB5C8;
}
.node__tailpad {
  height: 6rpx;
}
/* 硬边阴影缓冲：v-for 包裹层默认 overflow:hidden，node 卡贴层底会裁阴影 */
.nodewrap {
  padding-bottom: 6rpx;
}
.nodewrap .conn {
  height: 20rpx;
}
.node {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border-width: 2rpx;
  border-style: dashed;
  border-color: #F5E6DA;
  padding: 22rpx;
  box-shadow: 0 5rpx 0 0 #EFE5D6;;
}
.node--live {
  border-style: solid;
  border-color: #FF8A5C;
  box-shadow: 0 6rpx 0 0 #F3CFA9;;
}
.node__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background-color: #FBF3EB;
  margin-right: 22rpx;
}
.node__icon--live {
  background-color: #FF8A5C;
}
.node__bolt {
  width: 44rpx;
  height: 44rpx;
  margin: 22rpx;
}
.node__body {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.node__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A4458;
}
.node__title--locked {
  color: #7A7290;
}
.node__meta {
  font-size: 22rpx;
  color: #AFA8BD;
  margin-top: 8rpx;
}
.node__stars {
  font-size: 30rpx;
  color: #FFC94D;
  font-weight: bold;
}
.node__offchip {
  border-width: 1.5rpx;
  border-style: dashed;
  border-color: #F5E6DA;
  border-radius: 26rpx;
  padding: 8rpx 20rpx;
}
.node__offchip-text {
  font-size: 18rpx;
  color: #AFA8BD;
}
.footer {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 26rpx;
}
</style>
