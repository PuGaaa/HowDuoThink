  font-size: 20rpx;
  color: #FFC94D;
}
.ringcard__ring {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  position: relative;
}
.ringcard__ring-bg {
  position: absolute;
  top: 0; left: 0; width: 110rpx; height: 110rpx;
  border-radius: 55rpx;
  background-color: #5E5770;
}
.ringcard__ring-fill {
  position: absolute;
  top: 0; left: 0; width: 110rpx; height: 110rpx;
  border-radius: 55rpx;
}
