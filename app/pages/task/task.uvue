<template>
  <view class="page">
    <view class="content">
      <text class="title">任务</text>

      <!-- 今日进度环 -->
      <view class="ringcard">
        <view class="ringcard__left">
          <text class="ringcard__label">今日任务</text>
          <text class="ringcard__name">{{ doneDaily }} / {{ totalDaily }}</text>
          <view class="ringcard__streakrow">
          <image class="ringcard__flame" src="/static/icons/flame-lemon.png" mode="aspectFit"></image>
          <text class="ringcard__streak">连续 {{ streakCount }} 天</text>
        </view>
        </view>
        <view class="ringcard__ring">
          <view class="ringcard__ring-bg"></view>
          <view class="ringcard__ring-fill" :style="'background: conic-gradient(#FF8A5C ' + ringPct + '%, rgba(255,255,255,0.25) 0)'"></view>
          <view class="ringcard__hole"></view>
        </view>
      </view>

      <!-- 每日任务 -->
      <text class="sec">每日任务</text>
      <view v-for="(t, i) in dailyList" :key="t.id" class="task">
        <image class="task__icon" :src="t.iconImg" mode="aspectFit"></image>
        <view class="task__body">
          <text class="task__title">{{ t.title }}</text>
          <view class="task__track">
            <view class="task__fill" :style="'width:' + t.pct + '%'"></view>
          </view>
        </view>
        <text v-if="t.done" class="task__done">✓</text>
        <text v-else class="task__prog">{{ t.cur }}/{{ t.goal }}</text>
      </view>

      <!-- 每周任务 -->
      <text class="sec">每周任务</text>
      <view v-for="(t, i) in weeklyList" :key="'w' + i" class="task">
        <image class="task__icon" :src="t.iconImg" mode="aspectFit"></image>
        <view class="task__body">
          <text class="task__title">{{ t.title }}</text>
          <view class="task__track">
            <view class="task__fill" :style="'width:' + t.pct + '%'"></view>
          </view>
        </view>
        <text v-if="t.done" class="task__done">✓</text>
        <text v-else class="task__prog">{{ t.cur }}/{{ t.goal }}</text>
      </view>

      <!-- 成长任务 -->
      <text class="sec">成长任务</text>
      <view v-for="(t, i) in growthList" :key="'g' + i" class="task">
        <image class="task__icon" :src="t.iconImg" mode="aspectFit"></image>
        <view class="task__body">
          <text class="task__title">{{ t.title }}</text>
          <view class="task__track">
            <view class="task__fill" :style="'width:' + t.pct + '%'"></view>
          </view>
        </view>
        <text v-if="t.done" class="task__done">✓</text>
        <text v-else class="task__prog">{{ t.cur }}/{{ t.goal }}</text>
      </view>

      <!-- 分享海报 -->
      <view class="postbtn" @click="goPoster">
        <image class="postbtn__icon" src="/static/icons/clipboard-coral.png" mode="aspectFit"></image>
        <text class="postbtn__text">生成我的侦探档案海报</text>
      </view>
    </view>
    <tabbar active="task"></tabbar>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { DAILY_TASKS, WEEKLY_TASKS, GROWTH_TASKS, TaskDef } from '../../data/tasks'
import { getTaskDaily, getTaskWeekly, getCaseProgress, getChecklistUse, getStreak } from '../../utils/storage'
import { rankOf, starsOf } from '../../utils/scoring'
import { ALL_CASES } from '../../data/cases'
import tabbar from '../../components/tabbar/tabbar.uvue'

class TaskVM {
  id: string = ''
  icon: string = ''
  iconImg: string = ''
  title: string = ''
  goal: number = 0
  cur: number = 0
  pct: number = 0
  done: boolean = false
}

const streakCount = ref(getStreak().count)
const doneDaily = ref(0)
const totalDaily = ref(DAILY_TASKS.length)
const ringPct = ref(0)
const dailyList = ref<TaskVM[]>([])
const weeklyList = ref<TaskVM[]>([])
const growthList = ref<TaskVM[]>([])

function buildLists() {
  const dl: TaskVM[] = []
  let done = 0
  for (let i = 0; i < DAILY_TASKS.length; i++) {
    const t = DAILY_TASKS[i]
    const cur = t.metric === 'checkuse' ? getChecklistUse() : getTaskDaily(t.metric)
    const d = cur >= t.goal
    if (d) done++
    var v = new TaskVM()
    v.id = t.id
    v.iconImg = '/static/icons/' + t.icon + '.png'
    v.title = t.title
    v.goal = t.goal
    v.cur = cur > t.goal ? t.goal : cur
    v.pct = t.goal > 0 ? Math.min(100, Math.round((v.cur * 100) / t.goal)) : 0
    v.done = d
    dl.push(v)
  }
  dailyList.value = dl
  doneDaily.value = done
  ringPct.value = Math.round((done * 100) / DAILY_TASKS.length)

  const wl: TaskVM[] = []
  for (let i = 0; i < WEEKLY_TASKS.length; i++) {
    const t = WEEKLY_TASKS[i]
    const cur = getTaskWeekly(t.metric)
    var w2 = new TaskVM()
    w2.id = t.id
    w2.iconImg = '/static/icons/' + t.icon + '.png'
    w2.title = t.title
    w2.goal = t.goal
    var c2 = cur > t.goal ? t.goal : cur
    w2.cur = c2
    w2.pct = t.goal > 0 ? Math.min(100, Math.round((c2 * 100) / t.goal)) : 0
    w2.done = cur >= t.goal
    wl.push(w2)
  }
  weeklyList.value = wl

  const gl: TaskVM[] = []
  let solved = 0
  for (let i = 0; i < ALL_CASES.length; i++) {
    const p = getCaseProgress(ALL_CASES[i].id)
    if (p != null && p.solved) solved++
  }
  const rk = rankOf(solved)
  var g1 = new TaskVM()
  g1.id = 'g-rank'
  g1.iconImg = '/static/icons/medal-coral.png'
  g1.title = '晋升「主治工程师」'
  g1.goal = 3
  g1.cur = solved >= 3 ? 3 : solved
  g1.pct = Math.min(100, Math.round((g1.cur * 100) / 3))
  g1.done = solved >= 3
  gl.push(g1)
  var g2 = new TaskVM()
  g2.id = 'g-all'
  g2.iconImg = '/static/icons/map-sky.png'
  g2.title = '全部章节通关'
  g2.goal = ALL_CASES.length
  g2.cur = solved
  g2.pct = Math.min(100, Math.round((solved * 100) / ALL_CASES.length))
  g2.done = solved >= ALL_CASES.length
  gl.push(g2)
  growthList.value = gl
}


buildLists()

function goPoster() {
  uni.navigateTo({ url: '/pages/post/post' })
}
</script>

