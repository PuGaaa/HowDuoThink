  background-color: #FFFFFF;
  border-width: 2rpx;
  border-style: solid;
  border-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 22rpx;
  margin-top: 20rpx;
}
.postbtn__icon {
  width: 30rpx;
