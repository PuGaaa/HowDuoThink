<template>
  <view class="page">
    <safe-top></safe-top>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <!-- 今日进度环 -->
      <view class="ringcard">
        <view class="ringcard__left">
          <text class="ringcard__label">今日任务</text>
          <text class="ringcard__name">{{ doneDaily }} / {{ totalDaily }}</text>
          <view class="ringcard__streakrow">
          <image class="ringcard__flame" src="/static/icons/flame-lemon.png" mode="aspectFit"></image>
          <text class="ringcard__streak">连续 {{ streakCount }} 天</text>
        </view>
        </view>
        <view class="ringcard__ring">
          <view class="ringcard__ring-bg"></view>
          <view class="ringcard__ring-fill" :style="'background: conic-gradient(#FF8A5C ' + ringPct + '%, rgba(255,255,255,0.25) 0)'"></view>
          <view class="ringcard__hole"></view>
        </view>
      </view>

      <!-- 每日任务 -->
      <view class="secrow">
        <view class="secrow__dot secrow__dot--coral"></view>
        <text class="secrow__label">每日任务</text>
        <text class="secrow__count">{{ doneDaily }}/{{ totalDaily }}</text>
      </view>
      <view v-for="(t, i) in dailyList" :key="t.id" :class="taskClass(t)" @click="goTask(t)" @touchstart="pressTask(t.id)" @touchend="releaseTask" @touchcancel="releaseTask">
        <view :class="t.done ? 'task__iconbox task__iconbox--done' : 'task__iconbox'">
          <image class="task__icon" :src="t.iconImg" mode="aspectFit"></image>
        </view>
        <view class="task__body">
          <text :class="t.done ? 'task__title task__title--done' : 'task__title'">{{ t.title }}</text>
          <view :class="t.done ? 'task__track task__track--done' : 'task__track'">
            <view :class="t.done ? 'task__fill task__fill--done' : 'task__fill'" :style="'width:' + t.pct + '%'"></view>
          </view>
        </view>
        <view v-if="t.done" class="task__badge">
          <image class="task__badge-img" src="/static/icons/check-white.png" mode="aspectFit"></image>
        </view>
        <view v-else class="task__right">
          <text class="task__count">{{ t.cur }}/{{ t.goal }}</text>
          <view class="task__go">
            <text class="task__go-text">去完成 ›</text>
          </view>
        </view>
      </view>

      <!-- 每周任务 -->
      <view class="secrow">
        <view class="secrow__dot secrow__dot--sky"></view>
        <text class="secrow__label">每周任务</text>
        <text class="secrow__count">{{ weeklyDone }}/{{ weeklyTotal }}</text>
      </view>
      <view v-for="(t, i) in weeklyList" :key="'w' + i" :class="taskClass(t)" @click="goTask(t)" @touchstart="pressTask(t.id)" @touchend="releaseTask" @touchcancel="releaseTask">
        <view :class="t.done ? 'task__iconbox task__iconbox--done' : 'task__iconbox'">
          <image class="task__icon" :src="t.iconImg" mode="aspectFit"></image>
        </view>
        <view class="task__body">
          <text :class="t.done ? 'task__title task__title--done' : 'task__title'">{{ t.title }}</text>
          <view :class="t.done ? 'task__track task__track--done' : 'task__track'">
            <view :class="t.done ? 'task__fill task__fill--done' : 'task__fill'" :style="'width:' + t.pct + '%'"></view>
          </view>
        </view>
        <view v-if="t.done" class="task__badge">
          <image class="task__badge-img" src="/static/icons/check-white.png" mode="aspectFit"></image>
        </view>
        <view v-else class="task__right">
          <text class="task__count">{{ t.cur }}/{{ t.goal }}</text>
          <view class="task__go">
            <text class="task__go-text">去完成 ›</text>
          </view>
        </view>
      </view>

      <!-- 成长任务 -->
      <view class="secrow">
        <view class="secrow__dot secrow__dot--lemon"></view>
        <text class="secrow__label">成长任务</text>
        <text class="secrow__count">{{ growthDone }}/{{ growthTotal }}</text>
      </view>
      <view v-for="(t, i) in growthList" :key="'g' + i" :class="taskClass(t)" @click="goTask(t)" @touchstart="pressTask(t.id)" @touchend="releaseTask" @touchcancel="releaseTask">
        <view :class="t.done ? 'task__iconbox task__iconbox--done' : 'task__iconbox'">
          <image class="task__icon" :src="t.iconImg" mode="aspectFit"></image>
        </view>
        <view class="task__body">
          <text :class="t.done ? 'task__title task__title--done' : 'task__title'">{{ t.title }}</text>
          <view :class="t.done ? 'task__track task__track--done' : 'task__track'">
            <view :class="t.done ? 'task__fill task__fill--done' : 'task__fill'" :style="'width:' + t.pct + '%'"></view>
          </view>
        </view>
        <view v-if="t.done" class="task__badge">
          <image class="task__badge-img" src="/static/icons/check-white.png" mode="aspectFit"></image>
        </view>
        <view v-else class="task__right">
          <text class="task__count">{{ t.cur }}/{{ t.goal }}</text>
          <view class="task__go">
            <text class="task__go-text">去完成 ›</text>
          </view>
        </view>
      </view>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { DAILY_TASKS, WEEKLY_TASKS, GROWTH_TASKS } from '../../data/tasks'
import { getTaskDaily, getTaskWeekly, getCaseProgress, getStreak } from '../../utils/storage'
import { getEffectiveCases } from '../../data/cases'
import { CHAPTERS, chapterCompleted } from '../../data/chapters'

class TaskVM {
  id: string = ''
  icon: string = ''
  iconImg: string = ''
  title: string = ''
  goal: number = 0
  cur: number = 0
  pct: number = 0
  done: boolean = false
  to: string = ''
  toTab: boolean = false
}

const streakCount = ref(getStreak().count)
const doneDaily = ref(0)
const totalDaily = ref(DAILY_TASKS.length)
const weeklyDone = ref(0)
const weeklyTotal = ref(WEEKLY_TASKS.length)
const growthDone = ref(0)
const growthTotal = ref(GROWTH_TASKS.length)
const ringPct = ref(0)
const dailyList = ref<TaskVM[]>([])
const weeklyList = ref<TaskVM[]>([])
const growthList = ref<TaskVM[]>([])
const pressedId = ref('')

function buildLists() {
  const dl: TaskVM[] = []
  let done = 0
  for (let i = 0; i < DAILY_TASKS.length; i++) {
    const t = DAILY_TASKS[i]
    // 每日任务一律读每日计数：checkuse 此前误读终身累计，跨天不重置
    const cur = getTaskDaily(t.metric)
    const d = cur >= t.goal
    if (d) done++
    var v = new TaskVM()
    v.id = t.id
    v.iconImg = '/static/icons/' + t.icon + '.png'
    v.title = t.title
    v.goal = t.goal
    v.cur = cur > t.goal ? t.goal : cur
    v.pct = t.goal > 0 ? Math.min(100, Math.round((v.cur * 100) / t.goal)) : 0
    v.done = d
    v.to = t.to
    v.toTab = t.toTab
    dl.push(v)
  }
  dailyList.value = dl
  doneDaily.value = done
  ringPct.value = Math.round((done * 100) / DAILY_TASKS.length)

  const wl: TaskVM[] = []
  let wdone = 0
  for (let i = 0; i < WEEKLY_TASKS.length; i++) {
    const t = WEEKLY_TASKS[i]
    const cur = getTaskWeekly(t.metric)
    var w2 = new TaskVM()
    w2.id = t.id
    w2.iconImg = '/static/icons/' + t.icon + '.png'
    w2.title = t.title
    w2.goal = t.goal
    var c2 = cur > t.goal ? t.goal : cur
    w2.cur = c2
    w2.pct = t.goal > 0 ? Math.min(100, Math.round((c2 * 100) / t.goal)) : 0
    w2.done = cur >= t.goal
    if (w2.done) wdone++
    w2.to = t.to
    w2.toTab = t.toTab
    wl.push(w2)
  }
  weeklyList.value = wl
  weeklyDone.value = wdone

  // 成长任务：由 data/tasks.ts 的 GROWTH_TASKS 驱动；allcases 的目标随案例注册表动态取
  const gl: TaskVM[] = []
  let gdone = 0
  const cases = getEffectiveCases()
  let solved = 0
  for (let i = 0; i < cases.length; i++) {
    const p = getCaseProgress(cases[i].id)
    if (p != null && p.solved) solved++
  }
  let completedChapters = 0
  for (let i = 0; i < CHAPTERS.length; i++) {
    if (chapterCompleted(CHAPTERS[i].id)) completedChapters++
  }
  for (let i = 0; i < GROWTH_TASKS.length; i++) {
    const t = GROWTH_TASKS[i]
    const current = t.metric === 'chapters' ? completedChapters : solved
    const goal = t.goal
    const cur = current > goal ? goal : current
    var g = new TaskVM()
    g.id = t.id
    g.iconImg = '/static/icons/' + t.icon + '.png'
    g.title = t.title
    g.goal = goal
    g.cur = cur
    g.pct = goal > 0 ? Math.min(100, Math.round((cur * 100) / goal)) : 0
    g.done = current >= goal
    if (g.done) gdone++
    g.to = t.to
    g.toTab = t.toTab
    gl.push(g)
  }
  growthList.value = gl
  growthDone.value = gdone
}

// onShow 首次显示也会触发：破案/核对检查单后回到任务页进度即时更新
onShow(() => buildLists())

// —— 任务卡跳转：进度来源页 = 完成入口 ——
function goTask(t: TaskVM) {
  if (t.to.length === 0) return
  if (t.toTab) {
    uni.switchTab({ url: t.to })
  } else {
    uni.navigateTo({ url: t.to })
  }
}

function pressTask(id: string) {
  pressedId.value = id
}

function releaseTask() {
  pressedId.value = ''
}

function taskClass(t: TaskVM): string {
  let cls = t.done ? 'task task--done' : 'task'
  if (pressedId.value === t.id) cls += ' task--press'
  return cls
}
</script>

<style>
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.content {
  padding-top: 112rpx;
  padding-bottom: 200rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
}
.ringcard {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #4A4458;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 28rpx;
}
.ringcard__left {
  display: flex;
  flex-direction: column;
}
.ringcard__label {
  font-size: 20rpx;
  color: #C9C2DA;
}
.ringcard__name {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-top: 8rpx;
}
.ringcard__streakrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
}
.ringcard__flame {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}
.ringcard__streak {
  font-size: 20rpx;
  color: #FFC94D;
}
.ringcard__ring {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  position: relative;
}
.ringcard__ring-bg {
  position: absolute;
  top: 0; left: 0; width: 110rpx; height: 110rpx;
  border-radius: 55rpx;
  background-color: #5E5770;
}
.ringcard__ring-fill {
  position: absolute;
  top: 0; left: 0; width: 110rpx; height: 110rpx;
  border-radius: 55rpx;
}
.ringcard__hole {
  position: absolute;
  top: 18rpx; left: 18rpx;
  width: 74rpx; height: 74rpx;
  border-radius: 37rpx;
  background-color: #4A4458;
}

/* 分区头：彩色圆点 + 标题 + 完成计数 */
.secrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
  margin-bottom: 18rpx;
}
.secrow__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 12rpx;
}
.secrow__dot--coral {
  background-color: #FF8A5C;
}
.secrow__dot--sky {
  background-color: #6FB8E8;
}
.secrow__dot--lemon {
  background-color: #FFC94D;
}
.secrow__label {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #4A4458;
}
.secrow__count {
  font-size: 21rpx;
  font-weight: bold;
  color: #AFA8BD;
}

/* 任务卡：硬底边卡片（同 rankcard/verdict 的既有语言）+ 图标徽章盒 */
.task {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 26rpx;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-bottom-width: 7rpx;
  border-bottom-color: #F0E2D2;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 18rpx;
  /* 按压反馈：transform 过渡在 App 端可用（同 play.uvue 抽屉既有用法） */
  transition-property: transform;
  transition-duration: 90ms;
  transition-timing-function: ease-out;
}
.task--done {
  background-color: #F0FAF5;
  border-color: #D9F0E5;
  border-bottom-color: #BFE5D4;
}
.task--press {
  transform: scale(0.98);
}
.task__iconbox {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background-color: #FFF7EF;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F8EADA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.task__iconbox--done {
  background-color: #E4F5EC;
  border-color: #D2EDE0;
}
.task__icon {
  width: 56rpx;
  height: 56rpx;
}
.task__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 16rpx;
}
.task__title {
  font-size: 26rpx;
  font-weight: bold;
  color: #4A4458;
  line-height: 36rpx;
}
.task__title--done {
  color: #86A296;
}
.task__track {
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #F6EDE3;
  margin-top: 14rpx;
  overflow: hidden;
}
.task__track--done {
  background-color: #DFF3EA;
}
.task__fill {
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #FF8A5C;
}
.task__fill--done {
  background-color: #5FC9A5;
}
.task__badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: #5FC9A5;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-width: 4rpx; border-bottom-style: solid; border-bottom-color: #3FA885;
}
.task__badge-img {
  width: 28rpx;
  height: 28rpx;
}
.task__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.task__count {
  font-size: 24rpx;
  font-weight: bold;
  color: #AFA8BD;
}
.task__go {
  background-color: #FFF1E7;
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  margin-top: 10rpx;
}
.task__go-text {
  font-size: 20rpx;
  font-weight: bold;
  color: #FF8A5C;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
