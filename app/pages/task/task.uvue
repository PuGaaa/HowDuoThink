}
.task__track {
  height: 10rpx;
  border-radius: 5rpx;
  background-color: #FBF3EB;
  margin-top: 10rpx;
}
.task__fill {
  height: 10rpx;
  border-radius: 5rpx;
  background-color: #FF8A5C;
}
.task__fill--done {
  background-color: #5FC9A5;
}
.task__badge {
  width: 46rpx;
  height: 46rpx;
  border-radius: 23rpx;
  background-color: #5FC9A5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 0 0 #3FA885;
}
.task__badge-img {
  width: 26rpx;
