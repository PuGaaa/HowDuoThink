<template>
  <view class="page">
    <safe-top></safe-top>
    <navbar></navbar>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <text class="pagetitle">账号密码</text>

      <view class="formcard">
        <view class="field">
          <text class="field__label">当前密码（选填）</text>
          <input class="field__input" v-model="oldPw" :password="true" placeholder="未设置过密码可留空" />
        </view>
        <view class="field">
          <text class="field__label">新密码</text>
          <input class="field__input" v-model="newPw" :password="true" placeholder="至少 6 位" />
        </view>
        <view class="field">
          <text class="field__label">确认新密码</text>
          <input class="field__input" v-model="confirmPw" :password="true" placeholder="再输入一次新密码" @confirm="save" />
        </view>
        <text class="formcard__tip">{{ tipText }}</text>

        <view class="btnpad">
          <view class="primarybtn" @click="save">
            <text class="primarybtn__text">{{ busy ? '保存中…' : '保存' }}</text>
          </view>
        </view>
      </view>
    </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref } from 'vue'
import navbar from '../../components/navbar/navbar.uvue'
import { getStoredUser, changePassword } from '../../utils/auth'

const oldPw = ref('')
const newPw = ref('')
const confirmPw = ref('')
const busy = ref(false)

// 提示文案按账号是否已设密码区分（资料未刷新到 hasPassword 时走中性文案）
const hasPw = getStoredUser()?.hasPassword == true
const tipText = hasPw ? '修改后请使用新密码登录' : '当前账号未设置过密码，直接输入新密码即可'

function save() {
  if (busy.value) return
  if (newPw.value.length < 6) {
    uni.showToast({ title: '新密码至少 6 位', icon: 'none' })
    return
  }
  if (newPw.value !== confirmPw.value) {
    uni.showToast({ title: '两次输入的新密码不一致', icon: 'none' })
    return
  }
  busy.value = true
  changePassword(oldPw.value, newPw.value, (r) => {
    busy.value = false
    if (r.error.length > 0) {
      uni.showToast({ title: r.error, icon: 'none' })
      return
    }
    uni.showToast({ title: '密码已保存', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 600)
  })
}
</script>

<style>
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.content {
  padding-top: 112rpx;
  padding-bottom: 60rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
}
.pagetitle {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A4458;
  margin-bottom: 24rpx;
}
.formcard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  border-bottom-width: 6rpx; border-bottom-style: solid; border-bottom-color: #EFE5D6;
}
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.field__label {
  font-size: 23rpx;
  font-weight: bold;
  color: #7A7290;
  margin-bottom: 10rpx;
}
.field__input {
  border-width: 2rpx;
  border-style: solid;
  border-color: #F5E6DA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #4A4458;
  background-color: #FBF3EB;
}
.formcard__tip {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 4rpx;
  line-height: 32rpx;
}
/* 硬边阴影缓冲：按钮贴卡片底，容器必须留出阴影高度 */
.btnpad {
  padding-bottom: 8rpx;
  margin-top: 26rpx;
}
.primarybtn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
  border-bottom-width: 8rpx; border-bottom-style: solid; border-bottom-color: #E06B38;
}
.primarybtn__text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
</style>
