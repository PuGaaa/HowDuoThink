  margin-bottom: 16rpx;
}
.revent {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  border-left-width: 4rpx;
  border-left-style: solid;
  border-left-color: #F0E7DC;
  padding: 10rpx 0 10rpx 16rpx;
}
.revent__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
