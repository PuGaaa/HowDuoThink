}

/* 专家链 */
.chain {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 0 0 #EFE5D6;;
}
.chain__title {
  font-size: 29rpx;
  font-weight: bold;
  color: #4A4458;
}
.chain__sub {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 6rpx;
  margin-bottom: 16rpx;
}
.step {
  display: flex;
  flex-direction: column;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F5E6DA;
