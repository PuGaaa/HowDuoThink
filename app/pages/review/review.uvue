  width: 32rpx;
  height: 32rpx;
}
.replaybtn {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  background-color: #FFFFFF;
  border-width: 3rpx;
  border-style: solid;
  border-color: #FF8A5C;
  border-radius: 46rpx;
  padding: 24rpx;
}
.replaybtn__text {
  font-size: 27rpx;
  color: #FF8A5C;
