<template>
  <view class="page">
    <navbar></navbar>
    <view v-if="loaded" class="content">
      <text class="pagetitle">复盘室</text>
      <!-- 仪式卡 -->
      <view :class="grade === 'F' ? 'verdict verdict--f' : 'verdict'">
        <text class="verdict__grade">{{ grade }}</text>
        <text class="verdict__title">{{ gradeText }}</text>
        <view class="verdict__stars">
          <image v-for="(st, i) in starImages" :key="'st' + i" class="verdict__star" :src="st" mode="aspectFit"></image>
        </view>
        <text class="verdict__tip">★ 破案 · ★★ 预算 ≤ 1.2× · ★★★ 零错误指认</text>
        <view class="verdict__marks">
          <image v-for="(m, i) in markNames" :key="'m' + i" class="verdict__mark" :src="'/static/mascots/' + m + '.png'" mode="aspectFit"></image>
        </view>
        <view class="cmp">
          <text class="cmp__label">你</text>
          <view class="cmp__track">
            <view class="cmp__fill cmp__fill--you" :style="'width:' + youPct + '%'"></view>
          </view>
          <text class="cmp__val">{{ playerCost }}⚡︎</text>
        </view>
        <view class="cmp">
          <text class="cmp__label">专家</text>
          <view class="cmp__track">
            <view class="cmp__fill cmp__fill--expert" style="width: 100%"></view>
          </view>
          <text class="cmp__val">{{ expertCost }}⚡︎</text>
        </view>
      </view>

      <!-- 手册收获 + 动机出口 -->
      <view v-if="solved" class="gain">
        <image class="gain__icon" src="/static/icons/book-mintdeep.png" mode="aspectFit"></image>
        <text class="gain__text">手册新增 {{ lessonCount }} 条诊断检查单</text>
      </view>
      <view class="btnrow">
        <view class="nextbtn" @click="goNext">
          <text class="nextbtn__text">{{ hasNext ? '下一关' : '返回地图' }}</text>
          <image class="nextbtn__arrow" src="/static/icons/arrowr-white.png" mode="aspectFit"></image>
        </view>
        <view class="replaybtn" @click="replay">
          <text class="replaybtn__text">再玩一次</text>
        </view>
      </view>

      <!-- 心理回放 -->
      <view class="replay">
        <text class="replay__title">本局心理回放</text>
        <view v-for="(item, i) in replayItems" :key="'r' + i" :class="item.isMascot ? 'rmascot' : 'revent'">
          <view v-if="item.isMascot" class="rmascot__row">
            <image class="rmascot__avatar" :src="'/static/mascots/' + item.who + '.png'" mode="aspectFit"></image>
            <view class="rmascot__body">
              <text class="rmascot__line">{{ item.text }}</text>
              <text class="rmascot__note">{{ item.note }}</text>
            </view>
          </view>
          <view v-else class="revent">
            <image v-if="item.icon.length > 0" class="revent__icon" :src="item.icon" mode="aspectFit"></image>
            <text class="revent__text">{{ item.text }}</text>
          </view>
        </view>
      </view>

      <!-- 假设板终局 vs 真相 -->
      <view v-if="hBoard.length > 0" class="hboard">
        <text class="hboard__title">假设板 · 终局</text>
        <view v-for="(h, i) in hBoard" :key="'hb' + i" class="hrow">
          <text :class="h.status === 'confirmed' ? 'hrow__text hrow__text--hit' : h.status === 'excluded' ? 'hrow__text hrow__text--excluded' : 'hrow__text'">{{ h.label }}</text>
          <text :class="h.status === 'confirmed' ? 'hrow__badge hrow__badge--hit' : h.status === 'excluded' ? 'hrow__badge hrow__badge--out' : 'hrow__badge'">{{ h.statusLabel }}</text>
        </view>
        <view class="hboard__truth">
          <text class="hboard__truth-text">真相：{{ truthText }}</text>
        </view>
      </view>

      <!-- 专家推理链 -->
      <view class="chain">
        <text class="chain__title">专家推理链</text>
        <text class="chain__sub">点击逐步展开</text>
        <view v-for="(st, i) in chainShown" :key="'c' + i" class="step">
          <view class="step__head">
            <view class="step__no">
              <text class="step__no-text">{{ i + 1 }}</text>
            </view>
            <view v-if="st.actionId.length === 0" class="step__stop">
              <text class="step__stop-text">停止规则</text>
            </view>
          </view>
          <text class="step__thought">观察：{{ st.thought }}</text>
          <text class="step__update">判断：{{ st.update }}</text>
          <text v-if="st.actionId.length > 0" class="step__action">动作：{{ actionName(st.actionId) }}</text>
          <view class="step__whybox">
            <text class="step__why">为什么：{{ st.why }}</text>
          </view>
          <text class="step__conclusion">结论：{{ st.conclusion }}</text>
        </view>
        <!-- 推理链进度 + 展开控制 -->
        <view v-if="chainShown.length < chainTotal" class="reveal">
          <view class="reveal__progress">
            <view class="reveal__track">
              <view class="reveal__fill" :style="'width:' + Math.floor(chainShown.length * 100 / chainTotal) + '%'"></view>
            </view>
            <text class="reveal__count">{{ chainShown.length }}/{{ chainTotal }} 步</text>
          </view>
          <view class="reveal__btn" @click="revealNext">
            <text class="reveal__btn-text">展开下一步</text>
            <image class="reveal__btn-arrow" src="/static/icons/arrowr-white.png" mode="aspectFit"></image>
          </view>
        </view>
        <view v-else class="reveal">
          <view class="reveal__chip">
            <image class="reveal__chip-img" src="/static/icons/check-white.png" mode="aspectFit"></image>
            <text class="reveal__chip-text">推理链已完整 · {{ chainTotal }} 步</text>
          </view>
        </view>
      </view>

      <!-- 检查单 -->
      <view class="lessons">
        <text class="lessons__title">带走的诊断检查单</text>
        <text class="lessons__layer">本题的层契约：{{ layer }}</text>
        <view v-for="(l, i) in lessons" :key="'l' + i" class="lesson">
          <text class="lesson__text">✓ {{ l.text }}</text>
          <text class="lesson__principle">{{ l.principle }}</text>
        </view>
      </view>
    </view>

    <view v-else class="loading">
      <text class="loading__text">正在生成复盘……</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { getCaseById, ALL_CASES } from '../../data/cases'
import { ExpertStep, Lesson } from '../../types/case'
import { SessionRecord, SessionEvent, MascotEventRec, getLastSession } from '../../utils/storage'
import { gradeTitle, starsOf } from '../../utils/scoring'
import { reviewNote } from '../../utils/mascot'
import navbar from '../../components/navbar/navbar.uvue'

class HBoardVM {
  label: string = ''
  status: string = ''
  statusLabel: string = ''
}

interface ReplayItem {
  isMascot: boolean
  icon: string
  text: string
  who: string
  note: string
}

const loaded = ref(false)
const grade = ref('')
const gradeText = ref('')
const playerCost = ref(0)
const expertCost = ref(1)
const wrongIdentifies = ref(0)
const layer = ref('')
const replayItems = ref<ReplayItem[]>([])
const chainAll = ref<ExpertStep[]>([])
const chainShown = ref<ExpertStep[]>([])
const chainTotal = ref(0)
const lessons = ref<Lesson[]>([])
const lessonCount = ref(0)
const caseId = ref('')
const solved = ref(false)
const hasNext = ref(false)
const nextId = ref('')
const markNames = ref(['frog', 'otter', 'snail', 'rabbit', 'dino'])
const hBoard = ref<HBoardVM[]>([])
const truthText = ref('')

const starImages = ref(['/static/icons/star-lemon.png', '/static/icons/star-lemon.png', '/static/icons/star-lemon.png'])
const youPct = ref(100)

onLoad(() => {
  const session : SessionRecord | null = getLastSession()
  if (session == null) {
    uni.showToast({ title: '没有可复盘的对局', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 800)
    return
  }
  const c = getCaseById(session.caseId)
  if (c == null) {
    uni.showToast({ title: '案例数据缺失', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 800)
    return
  }

  caseId.value = c.id
  solved.value = session.solved
  grade.value = session.grade
  gradeText.value = gradeTitle(session.grade)
  playerCost.value = session.playerCost
  expertCost.value = session.expertCost
  wrongIdentifies.value = session.wrongIdentifies
  layer.value = c.layer
  chainAll.value = c.expertChain
  chainTotal.value = c.expertChain.length
  chainShown.value = takeSteps(c.expertChain, 1)
  lessons.value = c.lessons
  lessonCount.value = c.lessons.length

  const stars = starsOf(session.grade)
  const imgs: string[] = []
  for (let i = 0; i < 3; i++) {
    imgs.push(i < stars ? '/static/icons/star-lemon.png' : '/static/icons/star-empty.png')
  }
  starImages.value = imgs
  const base = session.expertCost > 0 ? session.expertCost : 1
  youPct.value = Math.min(100, Math.round((session.playerCost / base) * 100))

  // 下一关：ALL_CASES 顺序中的下一个已实现案例
  hasNext.value = false
  for (let i = 0; i < ALL_CASES.length; i++) {
    if (ALL_CASES[i].id === session.caseId && i + 1 < ALL_CASES.length) {
      hasNext.value = true
      nextId.value = ALL_CASES[i + 1].id
      break
    }
  }

  // 假设板终局（旧会话无 hStates 则跳过）
  const board: HBoardVM[] = []
  if (session.hStates != null) {
    for (let i = 0; i < session.hStates.length; i++) {
      const hs = session.hStates[i]
      let label = hs.id
      for (let j = 0; j < c.hypotheses.length; j++) {
        if (c.hypotheses[j].id === hs.id) label = c.hypotheses[j].text
      }
      const vm = new HBoardVM()
      vm.label = label
      vm.status = hs.status
      vm.statusLabel = hs.status === 'confirmed' ? '实锤 ✓' : hs.status === 'excluded' ? '已排除' : hs.status === 'up' ? '升权' : hs.status === 'down' ? '降权' : '未动'
      board.push(vm)
    }
    hBoard.value = board
  }
  for (let i = 0; i < c.rootCauses.length; i++) {
    if (c.rootCauses[i].correct) truthText.value = c.rootCauses[i].text
  }

  buildReplay(session.events, session.mascotEvents)
  loaded.value = true
})

function takeSteps(all: ExpertStep[], n: number): ExpertStep[] {
  const arr: ExpertStep[] = []
  const count = n < all.length ? n : all.length
  for (let i = 0; i < count; i++) {
    arr.push(all[i])
  }
  return arr
}

function revealNext() {
  if (chainShown.value.length >= chainTotal.value) return
  chainShown.value = takeSteps(chainAll.value, chainShown.value.length + 1)
}

function actionName(actionId: string): string {
  const c = getCaseById(caseId.value)
  if (c == null) return actionId
  for (let i = 0; i < c.actions.length; i++) {
    if (c.actions[i].id === actionId) return c.actions[i].name + '（-' + c.actions[i].cost + ' ⚡︎）'
  }
  return actionId
}

function buildReplay(events: SessionEvent[], mascots: MascotEventRec[]) {
  const items: ReplayItem[] = []
  for (let i = 0; i < mascots.length; i++) {
    if (mascots[i].afterEventIndex < 0) {
      items.push(mascotItem(mascots[i]))
    }
  }
  for (let i = 0; i < events.length; i++) {
    const item: ReplayItem = { isMascot: false, icon: eventIcon(events[i].kind), text: events[i].text, who: '', note: '' }
    items.push(item)
    for (let j = 0; j < mascots.length; j++) {
      if (mascots[j].afterEventIndex === i) {
        items.push(mascotItem(mascots[j]))
      }
    }
  }
  replayItems.value = items
}

function mascotItem(m: MascotEventRec): ReplayItem {
  const item: ReplayItem = {
    isMascot: true,
    icon: '',
    text: m.line,
    who: m.id,
    note: reviewNote(m.id),
  }
  return item
}

function eventIcon(kind: string): string {
  if (kind === 'hypothesis') return '/static/icons/bulb-sky.png'
  if (kind === 'action') return '/static/icons/search-ink.png'
  return '/static/icons/target-coral.png'
}

function goNext() {
  if (hasNext.value) {
    uni.redirectTo({ url: '/pages/play/play?id=' + nextId.value })
  } else {
    uni.redirectTo({ url: '/pages/index/index' })
  }
}

function replay() {
  uni.redirectTo({ url: '/pages/play/play?id=' + caseId.value })
}
</script>

<style>
