  flex: 1;
}
.rmascot__note {
  font-size: 20rpx;
  color: #B08F4A;
  margin-top: 8rpx;
  line-height: 32rpx;
}

/* 假设板终局 */
.hboard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
}
