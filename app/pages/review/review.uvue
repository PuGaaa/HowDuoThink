  text-align: center;
}
.verdict__marks {
  display: flex;
  flex-direction: row;
  margin-top: 18rpx;
}
.verdict__mark {
  width: 52rpx;
  height: 52rpx;
  margin: 0 8rpx;
}
.cmp {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-top: 16rpx;
}
.cmp__label {
  font-size: 21rpx;
