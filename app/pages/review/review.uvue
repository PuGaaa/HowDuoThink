  justify-content: center;
}
.step__no-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.step__stop {
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #5FC9A5;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  margin-left: 14rpx;
}
.step__stop-text {
