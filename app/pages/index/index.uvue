  display: flex;
  flex-direction: column;
  background-color: #FFF9F4;
  width: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  padding: 24rpx 32rpx 200rpx;
  padding-top: 100rpx;
}
