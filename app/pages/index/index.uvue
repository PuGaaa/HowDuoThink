<template>
  <view class="page">
    <view class="content">
      <!-- 头部：档案 + streak -->
      <view class="header">
        <view class="header__avatar-wrap">
          <image class="header__avatar" src="/static/mascots/frog-96.png" mode="aspectFit"></image>
        </view>
        <view class="header__who">
          <text class="header__rank">{{ rankName }}</text>
          <text class="header__sub">{{ rankNext }}</text>
        </view>
        <view class="header__streak">
          <image class="header__flame" src="/static/icons/flame-lemon.png" mode="aspectFit"></image>
          <text class="header__streak-num">{{ streakCount }} 天</text>
        </view>
      </view>
      <view v-if="packSynced" class="packchip" @click="onPackTap">
        <text class="packchip__text">☁ 社区关卡已同步 · {{ packCount }} 个待上线</text>
      </view>

      <!-- 继续闯关 -->
      <view v-if="continueCase" class="continue" @click="openPlay(continueCaseId)">
        <text class="continue__tag">继续闯关 · {{ continueChapterLabel }}</text>
        <text class="continue__title">{{ continueTitle }}</text>
        <text class="continue__meta">{{ continueMeta }}</text>
        <view class="continue__circle">
          <image class="continue__arrow" src="/static/icons/arrowr-white.png" mode="aspectFit"></image>
        </view>
        <text class="continue__hint">最近的故障现场，就差一步收网</text>
      </view>
      <view v-else class="continue continue--done">
        <text class="continue__title">全部破案！</text>
        <text class="continue__meta">新的章节正在路上，敬请期待</text>
      </view>

      <!-- 章节地图：篇-章两级 -->
      <view class="secrow">
        <text class="secrow__title">章节地图</text>
        <text class="secrow__sub">按层闯关，拼出全栈地图</text>
      </view>
      <view v-for="(part, pi) in parts" :key="part.id" class="part">
        <view class="part__head" @click="togglePart(part.id)">
          <view class="part__headrow">
            <text class="part__name">{{ part.name }}</text>
            <text class="part__chev">{{ openParts[part.id] ? '⌃' : '⌄' }}</text>
          </view>
          <text class="part__desc">{{ part.desc }}</text>
        </view>
        <view v-if="openParts[part.id]">
          <view v-for="(ch, ci) in chaptersOfPart(part.id)" :key="ch.id" class="chapter" @click="openChapter(ch.id)">
            <view class="chapter__no">
              <text class="chapter__no-text">{{ ch.no }}</text>
            </view>
            <text class="chapter__name">{{ ch.name }}</text>
            <text class="chapter__pact">{{ ch.pact }}</text>
            <view class="chapter__track">
              <view class="chapter__fill" :style="'width:' + partProgress(ch.id).pct + 'rpx'"></view>
            </view>
            <text class="chapter__count">{{ partProgress(ch.id).solved }}/{{ partProgress(ch.id).total }}</text>
          </view>
        </view>
      </view>
      <text class="footer">全部 10 关 · 每关一朵层契约拼图</text>
    </view>
    <tabbar active="adventure"></tabbar>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { CHAPTERS, PARTS, casesInChapter } from '../../data/chapters'
import tabbar from '../../components/tabbar/tabbar.uvue'
import { ALL_CASES, getCaseById } from '../../data/cases'
import { getCaseProgress, getStreak, CaseProgress } from '../../utils/storage'
import { getTotals } from '../../utils/storage'
import { rankOf, starsOf } from '../../utils/scoring'
import { fetchCasepack, getPackCount } from '../../utils/sync'

const rankName = ref('')
const continueCaseId = ref('')
const continueTitle = ref('')
const continueMeta = ref('')
const continueChapterLabel = ref('')
const hasContinue = ref(false)
const rankNext = ref('')
const streakCount = ref(0)
const parts = ref<PartVM[]>(PARTS)
const openParts = ref<{ [key: string]: boolean }>({ apprentice: true, engineer: false, master: false })

class PartVM {
  id: string = ''
  name: string = ''
  desc: string = ''
}
class ChapterVM {
  id: string = ''
  no: string = ''
  name: string = ''
  pact: string = ''
}
function togglePart(id: string) {
  openParts.value[id] = !openParts.value[id]
}
function chaptersOfPart(partId: string): ChapterVM[] {
  const out: ChapterVM[] = []
  for (let i = 0; i < CHAPTERS.length; i++) {
    const ch = CHAPTERS[i]
    if (ch.part !== partId) continue
    const vm = new ChapterVM()
    vm.id = ch.id
    vm.no = ch.no
    vm.name = ch.name
    vm.pact = ch.pact
    out.push(vm)
  }
  return out
}
function partProgress(chapterId: string) {
  const list = casesInChapter(chapterId)
  let solved = 0
  for (let i = 0; i < list.length; i++) {
    const p = getCaseProgress(list[i].id)
    if (p != null && p.solved) solved++
  }
  const pct = list.length > 0 ? Math.floor((260 * solved) / list.length) : 0
  return { solved: solved, total: list.length, pct: pct }
}
function openChapter(chapterId: string) {
  uni.navigateTo({ url: '/pages/chapter/chapter?id=' + chapterId })
}
const packCount = ref(0)
const packSynced = ref(false)

// 竖版内容骨架在 mounted 前就需要空数组占位
const totals = getTotals(
  ALL_CASES.map((c) => c.id),
  ALL_CASES.map((c) => c.lessons.length)
)
const rk = rankOf(totals.solved)
rankName.value = rk.name
rankNext.value = rk.remain > 0 ? '再破案 ' + rk.remain + ' 关晋升「' + rk.nextName + '」' : '已是最高称号'
streakCount.value = getStreak().count
packCount.value = getPackCount()
fetchCasepack((r) => {
  if (r.error.length === 0 && r.count > 0) {
    packCount.value = getPackCount()
    packSynced.value = true
  }
})

function starsLabel(g: string): string {
  const n = starsOf(g)
  let s = ''
  for (let i = 0; i < 3; i++) {
    s += i < n ? '★' : '☆'
  }
  return s
}

// 组装继续闯关：找第一个未破案的已上线关（章内动态聚合）
let continueFound = false
for (let i = 0; i < ALL_CASES.length; i++) {
  const c = ALL_CASES[i]
  const p = getCaseProgress(c.id)
  const isSolved = p != null && p.solved
  if (!isSolved) {
    continueFound = true
    continueCaseId.value = c.id
    continueTitle.value = c.title
    const ch = CHAPTERS.find((x) => x.id === c.chapterId)
    continueChapterLabel.value = ch ? ch.no + ' ' + ch.name : ''
    const stars = starsOf(p != null && p.bestGrade.length > 0 ? p.bestGrade : '')
    let sl = ''
    for (let k = 0; k < 3; k++) sl += k < stars ? '★' : '☆'
    const best = p != null && p.bestGrade.length > 0 ? '最佳 ' + p.bestCost + '⚡' : '未挑战'
    continueMeta.value = sl + ' 标准 · ' + best
    break
  }
}
hasContinue.value = continueFound

const continueCase = computed((): boolean => hasContinue.value)

function openPlay(id: string) {
  uni.navigateTo({ url: '/pages/play/play?id=' + id })
}

function onPackTap() {
  uni.showToast({ title: '社区关卡将在下个版本开放游玩', icon: 'none' })
}
</script>

