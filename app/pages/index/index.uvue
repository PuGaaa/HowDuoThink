<template>
  <view class="page">
    <view class="content">
      <!-- 头部：档案 + streak -->
      <view class="header">
        <view class="header__avatar-wrap">
          <image class="header__avatar" src="/static/mascots/frog.png" mode="aspectFit"></image>
        </view>
        <view class="header__who">
          <text class="header__rank">{{ rankName }}</text>
          <text class="header__sub">{{ rankNext }}</text>
        </view>
        <view class="header__streak">
          <image class="header__flame" src="/static/icons/flame-lemon.png" mode="aspectFit"></image>
          <text class="header__streak-num">{{ streakCount }} 天</text>
        </view>
      </view>
      <view v-if="packSynced" class="packchip" @click="onPackTap">
        <image class="packchip__icon" src="/static/icons/cloud-sky.png" mode="aspectFit"></image>
        <text class="packchip__text">社区关卡已同步 · {{ packCount }} 关可玩</text>
      </view>

      <!-- 继续闯关 -->
      <view v-if="continueCase" class="continue" @click="openPlay(continueCaseId)">
        <text class="continue__tag">继续闯关 · {{ continueChapterLabel }}</text>
        <text class="continue__title">{{ continueTitle }}</text>
        <text class="continue__meta">{{ continueMeta }}</text>
        <view class="continue__circle">
          <image class="continue__arrow" src="/static/icons/arrowr-white.png" mode="aspectFit"></image>
        </view>
        <text class="continue__hint">最近的故障现场，就差一步收网</text>
      </view>
      <view v-else class="continue continue--done">
        <text class="continue__title">全部破案！</text>
        <text class="continue__meta">新的章节正在路上，敬请期待</text>
      </view>

      <!-- 章节地图：篇-章两级 -->
      <view class="secrow">
        <text class="secrow__title">章节地图</text>
        <text class="secrow__sub">按层闯关，拼出全栈地图</text>
      </view>
      <view v-for="(part, pi) in parts" :key="part.id" class="part">
        <view class="part__head" @click="togglePart(part.id)">
          <view class="part__left">
            <view class="part__titlerow">
              <text class="part__name">{{ part.name }}</text>
              <text class="part__chcount">{{ partChCount(part.id) }} 章</text>
            </view>
            <text class="part__desc">{{ part.desc }}</text>
          </view>
          <view :class="openParts[part.id] ? 'part__chev part__chev--open' : 'part__chev'">
            <image class="part__chev-img" :src="openParts[part.id] ? '/static/icons/arrowr-white.png' : '/static/icons/arrowr-coral.png'" :style="openParts[part.id] ? 'transform: rotate(-90deg)' : 'transform: rotate(90deg)'" mode="aspectFit"></image>
          </view>
        </view>
        <view v-if="openParts[part.id]" class="part__body">
          <chapter-cube
            v-for="(ch, ci) in chaptersOfPart(part.id)"
            :key="ch.id"
            :chapter-no="ch.no"
            :name="ch.name"
            :pact="ch.pact"
            :solved="partProgress(ch.id).solved"
            :total="partProgress(ch.id).total"
            :accent="part.id"
            :locked="!isChapterUnlocked(ch.id)"
            @tap="openChapter(ch.id)"
          ></chapter-cube>
        </view>
      </view>
      <text class="footer">全部 {{ totalLevels }} 关 · 每关一朵层契约拼图</text>
    </view>
    <tabbar active="adventure"></tabbar>
    <confirm-dialog
      :show="challengeShow"
      :title="challengeTitle"
      message="通关上一章任意 1 关解锁本章；也可以直接挑战本章首关，赢了立即解锁。"
      confirm-text="去挑战"
      @confirm="goChallenge"
      @cancel="challengeShow = false"
    ></confirm-dialog>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { CHAPTERS, PARTS, casesInChapter, isChapterUnlocked, isCasePlayable, chapterChallengeCaseId } from '../../data/chapters'
import tabbar from '../../components/tabbar/tabbar.uvue'
import chapterCube from '../../components/chapter-cube/chapter-cube.uvue'
import confirmDialog from '../../components/confirm-dialog/confirm-dialog.uvue'
import { ALL_CASES, getCaseById } from '../../data/cases'
import { getCaseProgress, getStreak, CaseProgress } from '../../utils/storage'
import { getTotals } from '../../utils/storage'
import { rankOf, starsLabel } from '../../utils/scoring'
import { fetchCasepack, getPackCount } from '../../utils/sync'

const rankName = ref('')
const continueCaseId = ref('')
const continueTitle = ref('')
const continueMeta = ref('')
const continueChapterLabel = ref('')
const hasContinue = ref(false)
const rankNext = ref('')
const streakCount = ref(0)
const parts = ref<PartVM[]>(PARTS)
const openParts = ref<{ [key: string]: boolean }>({ apprentice: true, engineer: false, master: false })

class PartVM {
  id: string = ''
  name: string = ''
  desc: string = ''
}
class ChapterVM {
  id: string = ''
  no: string = ''
  name: string = ''
  pact: string = ''
}
function togglePart(id: string) {
  openParts.value[id] = !openParts.value[id]
}
function chaptersOfPart(partId: string): ChapterVM[] {
  const out: ChapterVM[] = []
  for (let i = 0; i < CHAPTERS.length; i++) {
    const ch = CHAPTERS[i]
    if (ch.part !== partId) continue
    const vm = new ChapterVM()
    vm.id = ch.id
    vm.no = ch.no
    vm.name = ch.name
    vm.pact = ch.pact
    out.push(vm)
  }
  return out
}
function partChCount(partId: string): number {
  return chaptersOfPart(partId).length
}

function partProgress(chapterId: string) {
  const list = casesInChapter(chapterId)
  let solved = 0
  for (let i = 0; i < list.length; i++) {
    const p = getCaseProgress(list[i].id)
    if (p != null && p.solved) solved++
  }
  const pct = list.length > 0 ? Math.floor((260 * solved) / list.length) : 0
  return { solved: solved, total: list.length, pct: pct }
}
const challengeShow = ref(false)
const challengeCaseId = ref('')
const challengeTitle = ref('')

function openChapter(chapterId: string) {
  if (isChapterUnlocked(chapterId)) {
    uni.navigateTo({ url: '/pages/chapter/chapter?id=' + chapterId })
    return
  }
  // 锁定章：确认后发起跳级挑战（本章首关恒可玩，通关解锁整章）
  const challengeId = chapterChallengeCaseId(chapterId)
  if (challengeId.length === 0) {
    uni.showToast({ title: '本章内容准备中', icon: 'none' })
    return
  }
  const ch = CHAPTERS.find((x) => x.id === chapterId)
  challengeTitle.value = (ch != null ? ch.name : '本章') + ' · 跳级挑战'
  challengeCaseId.value = challengeId
  challengeShow.value = true
}

function goChallenge() {
  challengeShow.value = false
  uni.navigateTo({ url: '/pages/play/play?id=' + challengeCaseId.value })
}
const packCount = ref(0)
const packSynced = ref(false)
const totalLevels = ref(ALL_CASES.length)

// 数据装配（onShow 触发，首次显示也会执行）：破案/同步后回到首页保持最新
function refreshHome() {
  const totals = getTotals(
    ALL_CASES.map((c) => c.id),
    ALL_CASES.map((c) => c.lessons.length)
  )
  const rk = rankOf(totals.solved)
  rankName.value = rk.name
  rankNext.value = rk.remain > 0 ? '再破案 ' + rk.remain + ' 关晋升「' + rk.nextName + '」' : '已是最高称号'
  streakCount.value = getStreak().count
  packCount.value = getPackCount()
  // 关卡总数：本地注册表与已同步关卡包取大者（包内含社区关）
  totalLevels.value = packCount.value > ALL_CASES.length ? packCount.value : ALL_CASES.length
  fetchCasepack((r) => {
    if (r.error.length === 0 && r.count > 0) {
      packCount.value = getPackCount()
      packSynced.value = true
      totalLevels.value = packCount.value > ALL_CASES.length ? packCount.value : ALL_CASES.length
    }
  })

  // 组装继续闯关：第一个"可玩且未破案"的关（锁定章的非挑战关会被跳过；挑战关未破时天然命中）
  let continueFound = false
  for (let i = 0; i < ALL_CASES.length; i++) {
    const c = ALL_CASES[i]
    const p = getCaseProgress(c.id)
    const isSolved = p != null && p.solved
    if (!isSolved && isCasePlayable(c.id)) {
      continueFound = true
      continueCaseId.value = c.id
      continueTitle.value = c.title
      const ch = CHAPTERS.find((x) => x.id === c.chapterId)
      continueChapterLabel.value = ch ? ch.no + ' ' + ch.name : ''
      const sl = starsLabel(p != null && p.bestGrade.length > 0 ? p.bestGrade : '')
      const best = p != null && p.bestGrade.length > 0 ? '最佳 ' + p.bestCost + '⚡︎' : '未挑战'
      continueMeta.value = sl + ' 标准 · ' + best
      break
    }
  }
  hasContinue.value = continueFound
}
onShow(() => refreshHome())

const continueCase = computed((): boolean => hasContinue.value)

function openPlay(id: string) {
  uni.navigateTo({ url: '/pages/play/play?id=' + id })
}

function onPackTap() {
  uni.showToast({ title: '社区关卡已在各章节中可玩', icon: 'none' })
}
</script>

<style>
