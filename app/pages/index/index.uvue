<template>
  <view class="page">
    <view class="content">
      <!-- 头部：档案 + streak -->
      <view class="header">
        <view class="header__avatar-wrap">
          <image class="header__avatar" src="/static/mascots/frog-96.png" mode="aspectFit"></image>
        </view>
        <view class="header__who">
          <text class="header__rank">{{ rankName }}</text>
          <text class="header__sub">{{ rankNext }}</text>
        </view>
        <view class="header__streak">
          <image class="header__flame" src="/static/icons/flame-lemon.png" mode="aspectFit"></image>
          <text class="header__streak-num">{{ streakCount }} 天</text>
        </view>
      </view>

      <!-- 继续闯关 -->
      <view v-if="continueCase" class="continue" @click="openPlay(continueCaseId)">
        <text class="continue__tag">继续闯关 · {{ continueChapterLabel }}</text>
        <text class="continue__title">{{ continueTitle }}</text>
        <text class="continue__meta">{{ continueMeta }}</text>
        <view class="continue__circle">
          <image class="continue__arrow" src="/static/icons/arrowr-white.png" mode="aspectFit"></image>
        </view>
        <text class="continue__hint">最近的故障现场，就差一步收网</text>
      </view>
      <view v-else class="continue continue--done">
        <text class="continue__title">全部破案！</text>
        <text class="continue__meta">新的章节正在路上，敬请期待</text>
      </view>

      <!-- 章节地图 -->
      <view class="secrow">
        <text class="secrow__title">章节地图</text>
        <text class="secrow__sub">按层闯关，拼出全栈地图</text>
      </view>
      <view class="grid">
        <view
          v-for="(ch, i) in chapters"
          :key="ch.name"
          :class="ch.unlocked ? 'chapter chapter--live' : 'chapter'"
          @click="openChapter(i)"
        >
          <view :class="ch.unlocked ? 'chapter__no chapter__no--live' : 'chapter__no'">
            <text :class="ch.unlocked ? 'chapter__no-text chapter__no-text--live' : 'chapter__no-text'">{{ ch.no }}</text>
          </view>
          <image v-if="ch.unlocked" class="chapter__star" src="/static/icons/star-lemon.png" mode="aspectFit"></image>
          <image v-else class="chapter__lock" src="/static/icons/lock-ink3.png" mode="aspectFit"></image>
          <text :class="ch.unlocked ? 'chapter__name' : 'chapter__name chapter__name--locked'">{{ ch.name }}</text>
          <text class="chapter__pact">{{ ch.pactShort }}</text>
          <view :class="ch.unlocked ? 'chapter__track chapter__track--live' : 'chapter__track'">
            <view v-if="ch.solved > 0" :style="'width:' + ch.progressPct + 'rpx'" :class="ch.unlocked ? 'chapter__fill chapter__fill--live' : 'chapter__fill'"></view>
          </view>
          <text :class="ch.unlocked ? 'chapter__count chapter__count--live' : 'chapter__count'">{{ ch.solved }}/{{ ch.total }}</text>
        </view>
      </view>
      <text class="footer">全部 10 关 · 每关一朵层契约拼图</text>
    </view>
    <tabbar active="adventure"></tabbar>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { CHAPTERS } from '../../data/chapters'
import tabbar from '../../components/tabbar/tabbar.uvue'
import { ALL_CASES, getCaseById } from '../../data/cases'
import { getCaseProgress, getStreak, CaseProgress } from '../../utils/storage'
import { getTotals } from '../../utils/storage'
import { rankOf, starsOf } from '../../utils/scoring'

const rankName = ref('')
const rankNext = ref('')
const streakCount = ref(0)
const chapters = ref<ChapterVM[]>([])
const continueCaseId = ref('')
const continueTitle = ref('')
const continueMeta = ref('')
const continueChapterLabel = ref('')
const hasContinue = ref(false)

class ChapterVM {
  no: string = ''
  name: string = ''
  pactShort: string = ''
  unlocked: boolean = false
  solved: number = 0
  total: number = 0
  progressPct: number = 0
}

// 竖版内容骨架在 mounted 前就需要空数组占位
chapters.value = []
const totals = getTotals(
  ALL_CASES.map((c) => c.id),
  ALL_CASES.map((c) => c.lessons.length)
)
const rk = rankOf(totals.solved)
rankName.value = rk.name
rankNext.value = rk.remain > 0 ? '再破案 ' + rk.remain + ' 关晋升「' + rk.nextName + '」' : '已是最高称号'
streakCount.value = getStreak().count

function starsLabel(g: string): string {
  const n = starsOf(g)
  let s = ''
  for (let i = 0; i < 3; i++) {
    s += i < n ? '★' : '☆'
  }
  return s
}

// 组装章节数据 + 找继续闯关的关卡
let continueFound = false
for (let ci = 0; ci < CHAPTERS.length; ci++) {
  const ch = CHAPTERS[ci]
  const vm = new ChapterVM()
  vm.no = ch.no
  vm.name = ch.name
  const cut = ch.pact.indexOf('，')
  vm.pactShort = cut > 0 ? ch.pact.slice(0, cut) : ch.pact
  let solved = 0
  let liveCount = 0
  for (let ki = 0; ki < ch.cases.length; ki++) {
    const c = getCaseById(ch.cases[ki])
    if (c == null) continue
    liveCount++
    const p = getCaseProgress(c.id)
    const isSolved = p != null && p.solved
    if (isSolved) solved++
    if (!continueFound && !isSolved) {
      continueFound = true
      continueCaseId.value = c.id
      continueTitle.value = c.title
      continueChapterLabel.value = ch.no + ' ' + ch.name
      const best = p != null && p.bestGrade.length > 0 ? '最佳 ' + p.bestCost + '⚡' : '未挑战'
      continueMeta.value = '★★ 标准 · ' + best
    }
  }
  vm.solved = solved
  vm.total = ch.cases.length
  vm.unlocked = liveCount > 0
  vm.progressPct = Math.floor((96 * solved) / vm.total)
  chapters.value.push(vm)
}
hasContinue.value = continueFound

const continueCase = computed((): boolean => hasContinue.value)

function openPlay(id: string) {
  uni.navigateTo({ url: '/pages/play/play?id=' + id })
}

function openChapter(i: number) {
  const vm = chapters.value[i]
  if (!vm.unlocked) {
    uni.showToast({ title: '本章即将上线', icon: 'none' })
    return
  }
  uni.navigateTo({ url: '/pages/chapter/chapter?i=' + i })
}
</script>

