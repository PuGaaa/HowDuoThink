<template>
  <view class="page">
    <safe-top></safe-top>
    <scroll-view class="pagesv" direction="vertical" :show-scrollbar="false">
      <view class="content">
      <!-- 头部：档案 + streak -->
      <view class="header">
        <view class="header__avatar-wrap">
          <image class="header__avatar" :src="headerAvatar" mode="aspectFill"></image>
        </view>
        <view class="header__who">
          <text class="header__rank">{{ rankName }}</text>
          <text class="header__sub">{{ rankNext }}</text>
        </view>
        <view class="header__streak">
          <image class="header__flame" src="/static/icons/v4/flame-orange.png" mode="aspectFit"></image>
          <text class="header__streak-num">{{ streakCount }} 天</text>
        </view>
      </view>

      <!-- 继续闯关：hero 背景每次进入随机抽一张，吉祥物烤在背景图里，左侧文案由前端渲染 -->
      <view v-if="continueCase" class="hero" @click="openPlay(continueCaseId)">
        <image class="hero__bg" :src="heroBg" mode="aspectFill"></image>
        <view class="hero__copy">
          <text class="hero__tag">继续闯关</text>
          <text class="hero__title" max-lines="1">{{ continueTitle }}</text>
          <text class="hero__meta">{{ continueMeta }}</text>
          <view class="hero__cta">
            <text class="hero__cta-text">继续挑战</text>
            <image class="hero__cta-arrow" src="/static/icons/v4/arrow-right-white.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>
      <view v-else class="idlecard" @click="onContinueIdleTap">
        <text class="idlecard__title">{{ guestWall ? '试玩关卡已通关' : '全部破案！' }}</text>
        <text class="idlecard__meta">{{ guestWall ? '登录解锁全部章节，进度云同步' : '新的章节正在路上，敬请期待' }}</text>
      </view>

      <!-- 今日一题：完成后整卡隐藏（任务页仍有入口） -->
      <view v-if="!dailyDoneToday" class="dailycard" @click="openDaily">
        <view class="dailycard__badge">
          <image class="dailycard__badge-img" src="/static/icons/v4/lightbulb-orange.png" mode="aspectFit"></image>
        </view>
        <view class="dailycard__body">
          <text class="dailycard__tag">今日一题</text>
          <text class="dailycard__title" max-lines="1">{{ dailyTitle }}</text>
        </view>
        <image class="dailycard__mascot" src="/static/illustrations/daily-otter-peek.png" mode="aspectFit"></image>
        <image class="dailycard__arrow" src="/static/icons/v4/arrow-right-orange.png" mode="aspectFit"></image>
      </view>

      <!-- 章节地图：篇-章两级 -->
      <view class="secrow">
        <view class="secrow__left">
          <text class="secrow__title">章节地图</text>
          <image class="secrow__spark" src="/static/icons/v4/magic-sparkles.png" mode="aspectFit"></image>
        </view>
        <text class="secrow__count">{{ parts.length }} 篇</text>
      </view>
      <view v-for="(part, pi) in parts" :key="part.id" class="part">
        <view class="part__head" @click="togglePart(part.id)">
          <text class="part__name">{{ part.name }}</text>
          <image class="part__flag" src="/static/icons/v4/bookmark-orange.png" mode="aspectFit"></image>
          <view class="part__pill">
            <text class="part__pill-text">{{ partChDone(part.id) }}/{{ partChCount(part.id) }} 章</text>
          </view>
          <view class="part__spacer"></view>
          <image class="part__chev" :src="openParts[part.id] ? '/static/icons/v4/circle-chevron-up-orange.png' : '/static/icons/v4/circle-chevron-down-pale.png'" mode="aspectFit"></image>
        </view>
        <view v-if="openParts[part.id]" class="part__body">
          <chapter-cube
            v-for="(ch, ci) in chaptersOfPart(part.id)"
            :key="ch.id"
            :chapter-no="ch.no"
            :name="ch.name"
            :solved="partProgress(ch.id).solved"
            :total="partProgress(ch.id).total"
            :accent="part.id"
            :locked="!isChapterUnlocked(ch.id)"
            @tap="openChapter(ch.id)"
          ></chapter-cube>
        </view>
      </view>
      <text class="footer">全部 {{ totalLevels }} 关 · 每关一朵层契约拼图</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import safeTop from '../../components/safe-top/safe-top.uvue'
import { ref, computed } from 'vue'
import { onShow, onLoad } from '@dcloudio/uni-app'
import { CHAPTERS, PARTS, casesInChapter, isChapterUnlocked, isCasePlayable, chapterChallengeCaseId, chapterUnlockHint, chapterCompleted } from '../../data/chapters'
import chapterCube from '../../components/chapter-cube/chapter-cube.uvue'
import { openConfirmDialog, ConfirmDialogOptions } from '../../utils/confirm-dialog'
import { getEffectiveCases, getCaseById } from '../../data/cases'
import { getCaseProgress, getStreak, CaseProgress } from '../../utils/storage'
import { pullServerProgress } from '../../utils/sync-progress'
import { getTotals } from '../../utils/storage'
import { rankOf, starsLabel } from '../../utils/scoring'
import { getAvatar, isLoggedIn } from '../../utils/auth'
import { openGuestLoginDialog } from '../../utils/login-guide'
import { dailyCase, dailyDone } from '../../utils/daily'
import { fetchCasepack, getPackCount } from '../../utils/sync'
import { fetchAppConfig } from '../../utils/app-config'
import { fetchAppResources } from '../../utils/remote-assets'

/** 继续闯关卡背景：素材包 4 张 9:4 hero，冷启动随机抽一张。
 *  只在 onLoad 换图：onShow 每次换图会触发大图重解码，切 tab 回首页顿一下。 */
const HERO_BGS: string[] = [
  '/static/hero/continue-01-bunny-900x400.png',
  '/static/hero/continue-02-snail-900x400.png',
  '/static/hero/continue-03-otter-900x400.png',
  '/static/hero/continue-04-triceratops-900x400.png',
]
const heroBg = ref(HERO_BGS[0])
function rollHero() {
  heroBg.value = HERO_BGS[Math.floor(Math.random() * HERO_BGS.length)]
}

const rankName = ref('')
const continueCaseId = ref('')
const continueTitle = ref('')
const continueMeta = ref('')
const hasContinue = ref(false)
/** 游客已通关全部免费关：继续闯关位变成登录引导 */
const guestWall = ref(false)
const rankNext = ref('')
const streakCount = ref(0)
const parts = ref<PartVM[]>(PARTS)
const openParts = ref<{ [key: string]: boolean }>({ apprentice: true, engineer: false, master: false })

class PartVM {
  id: string = ''
  name: string = ''
  desc: string = ''
}
class ChapterVM {
  id: string = ''
  no: string = ''
  name: string = ''
}
function togglePart(id: string) {
  openParts.value[id] = !openParts.value[id]
}
function chaptersOfPart(partId: string): ChapterVM[] {
  const out: ChapterVM[] = []
  for (let i = 0; i < CHAPTERS.length; i++) {
    const ch = CHAPTERS[i]
    if (ch.part !== partId) continue
    const vm = new ChapterVM()
    vm.id = ch.id
    vm.no = ch.no
    vm.name = ch.name
    out.push(vm)
  }
  return out
}
function partChCount(partId: string): number {
  return chaptersOfPart(partId).length
}
function partChDone(partId: string): number {
  const list = chaptersOfPart(partId)
  let done = 0
  for (let i = 0; i < list.length; i++) {
    if (chapterCompleted(list[i].id)) done++
  }
  return done
}

function partProgress(chapterId: string) {
  const list = casesInChapter(chapterId)
  let solved = 0
  for (let i = 0; i < list.length; i++) {
    const p = getCaseProgress(list[i].id)
    if (p != null && p.solved) solved++
  }
  const pct = list.length > 0 ? Math.floor((260 * solved) / list.length) : 0
  return { solved: solved, total: list.length, pct: pct }
}
function openChapter(chapterId: string) {
  if (isChapterUnlocked(chapterId)) {
    uni.navigateTo({ url: '/pages/chapter/chapter?id=' + chapterId })
    return
  }
  // 游客门禁：锁定章先引导登录，不进跳级挑战
  if (!isLoggedIn()) {
    openGuestLoginDialog()
    return
  }
  // 锁定章：确认后发起跳级挑战（本章首关恒可玩，通关解锁整章）
  const challengeId = chapterChallengeCaseId(chapterId)
  if (challengeId.length === 0) {
    uni.showToast({ title: '本章内容准备中', icon: 'none' })
    return
  }
  const ch = CHAPTERS.find((x) => x.id === chapterId)
  const opt = {
    title: (ch != null ? ch.name : '本章') + ' · 跳级挑战',
    message: chapterUnlockHint(chapterId) + '；也可以直接挑战本章首关，赢了立即解锁。',
    confirmText: '去挑战',
    cancelText: '取消',
    danger: false,
  } as ConfirmDialogOptions
  openConfirmDialog(opt, (confirm: boolean) => {
    if (confirm) {
      uni.navigateTo({ url: '/pages/play/play?id=' + challengeId + '&source=challenge' })
    }
  })
}
const headerAvatar = ref('')
const dailyTitle = ref('')
const dailyDoneToday = ref(false)
const packCount = ref(0)
const totalLevels = ref(getEffectiveCases().length)

/** 默认头像：未登录且远程头像预设未就绪时兜底，首次进入也有头像 */
const DEFAULT_AVATAR = '/static/illustrations/triceratops-alone.png'
function refreshAvatar() {
  const av = getAvatar()
  headerAvatar.value = av.length > 0 ? av : DEFAULT_AVATAR
}

// 数据装配（onShow 触发，首次显示也会执行）：破案/同步后回到首页保持最新
function refreshHome() {
  const cases = getEffectiveCases()
  refreshAvatar()
  const dc = dailyCase()
  dailyTitle.value = dc.title
  dailyDoneToday.value = dailyDone()
  const totals = getTotals(
    cases.map((c) => c.id),
    cases.map((c) => c.lessons.length)
  )
  const rk = rankOf(totals.solved)
  rankName.value = rk.name
  rankNext.value = rk.remain > 0 ? '再闯 ' + rk.remain + ' 关，晋升' + rk.nextName : '已是最高称号'
  streakCount.value = getStreak().count
  packCount.value = getPackCount()
  // 关卡总数：本地注册表与已同步关卡包取大者（包内含社区关）
  totalLevels.value = packCount.value > cases.length ? packCount.value : cases.length
  fetchAppConfig((_ok) => {})  // 运行时配置（游客门禁等）：失败退内置默认，不阻塞首页
  // 吉祥物/头像资源预取：拉到预设后若头像仍是兜底图，立即回填真实预设
  fetchAppResources((_ok) => {
    if (headerAvatar.value === DEFAULT_AVATAR) {
      refreshAvatar()
    }
  })
  fetchCasepack((r) => {
    if (r.error.length === 0 && r.count > 0) {
      packCount.value = getPackCount()
      totalLevels.value = packCount.value > getEffectiveCases().length ? packCount.value : getEffectiveCases().length
    }
  })

  // 组装继续闯关：第一个"可玩且未破案"的关（锁定章的非挑战关会被跳过；挑战关未破时天然命中）
  let continueFound = false
  for (let i = 0; i < cases.length; i++) {
    const c = cases[i]
    const p = getCaseProgress(c.id)
    const isSolved = p != null && p.solved
    if (!isSolved && isCasePlayable(c.id)) {
      continueFound = true
      continueCaseId.value = c.id
      continueTitle.value = c.title
      const sl = starsLabel(p != null && p.bestGrade.length > 0 ? p.bestGrade : '')
      const best = p != null && p.bestGrade.length > 0 ? '最佳 ' + p.bestCost + '⚡︎' : '未挑战'
      continueMeta.value = sl + ' 标准 · ' + best
      break
    }
  }
  hasContinue.value = continueFound
  guestWall.value = !isLoggedIn() && !continueFound
}

/** 继续闯关空位点击：游客命中登录引导，已登录无动作 */
function onContinueIdleTap() {
  if (guestWall.value) {
    openGuestLoginDialog()
  }
}
onLoad(() => {
  rollHero()
})
onShow(() => {
  refreshHome()
  // 登录态：后端为唯一事实源，回首页即拉取覆盖本地，再刷新显示
  pullServerProgress(() => refreshHome())
})

const continueCase = computed((): boolean => hasContinue.value)

function openDaily() {
  const id = dailyCase().id
  if (!isCasePlayable(id)) {
    if (!isLoggedIn()) {
      openGuestLoginDialog(id)
    } else {
      uni.showToast({ title: '今日题暂未解锁，请先完成当前主线', icon: 'none' })
    }
    return
  }
  uni.navigateTo({ url: '/pages/play/play?id=' + id + '&source=daily' })
}

function openPlay(id: string) {
  uni.navigateTo({ url: '/pages/play/play?id=' + id + '&source=home_continue' })
}
</script>

<style>
.page {
  display: flex;
  flex-direction: column;
  background-color: #FFF8F4;
  width: 100%;
  height: 100%;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
/* 页面滚动区：包住内容滚动，页面本体不再滚（iOS 指示条由 show-scrollbar 关闭） */
.pagesv {
  flex: 1;
}
.content {
  display: flex;
  flex-direction: column;
  padding-top: 88rpx;
  padding-bottom: 200rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 28rpx;
}
.header__avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background-color: #FFFFFF;
  border-width: 1.5rpx;
  border-style: solid;
  border-color: #F0E1D6;
}
.header__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
}
.header__who {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 20rpx;
}
.header__rank {
  font-size: 32rpx;
  font-weight: bold;
  color: #303343;
}
.header__sub {
  font-size: 20rpx;
  color: #A09DAD;
  margin-top: 6rpx;
}
.header__streak {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFF0EA;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.header__flame {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}
.header__streak-num {
  font-size: 24rpx;
  font-weight: bold;
  color: #C25E38;
}

/* 继续闯关 hero 卡：9:4 背景图 + 左侧文案（素材图左侧留白） */
.hero {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 310rpx;
  border-radius: 42rpx;
  overflow: hidden;
  background-color: #FFF0EA;
  margin-bottom: 24rpx;
}
.hero__bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 42rpx;
}
.hero__copy {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 62%;
  padding-left: 36rpx;
}
.hero__tag {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF7047;
}
.hero__title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #303343;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}
.hero__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #858397;
}
.hero__cta {
  align-self: flex-start;
  display: flex;
  flex-direction: row;
  align-items: center;
  /* iOS 对 90deg 角度形式兼容不稳：用 to right 关键字形式 + 纯色兜底（渐变失效时仍有橙底） */
  background-color: #FF7047;
  background-image: linear-gradient(to right, #FF8A5C, #FF5A3D);
  border-radius: 999rpx;
  padding: 14rpx 34rpx;
  margin-top: 22rpx;
}
.hero__cta-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.hero__cta-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}

/* 继续闯关空态 */
.idlecard {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx 0 #F6E4D8;
}
.idlecard__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #303343;
}
.idlecard__meta {
  font-size: 20rpx;
  color: #858397;
  margin-top: 8rpx;
}

/* 今日一题 */
.dailycard {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx 0 #F6E4D8;
}
.dailycard__badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #FFF2DC;
  margin-right: 16rpx;
}
.dailycard__badge-img {
  width: 34rpx;
  height: 34rpx;
  margin: 15rpx;
}
.dailycard__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  /* 让出右侧水獭插画区（水獭绝对定位占 padding 缘 60~180rpx），标题不压图 */
  margin-right: 140rpx;
}
.dailycard__tag {
  font-size: 26rpx;
  font-weight: bold;
  color: #303343;
}
.dailycard__title {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #858397;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}
.dailycard__mascot {
  position: absolute;
  right: 60rpx;
  bottom: 0;
  width: 120rpx;
  height: 84rpx;
}
.dailycard__arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.secrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.secrow__left {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.secrow__title {
  font-size: 36rpx;
  font-weight: bold;
  color: #303343;
}
.secrow__spark {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}
.secrow__count {
  font-size: 24rpx;
  color: #858397;
}

/* 篇 = 白卡容器（头 + 章网格一体） */
.part {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx 0 #F6E4D8;
}
.part__head {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.part__name {
  font-size: 32rpx;
  font-weight: bold;
  color: #303343;
}
.part__flag {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}
.part__pill {
  background-color: #FFF0EA;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-left: 14rpx;
}
.part__pill-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF7047;
}
.part__spacer {
  flex: 1;
}
.part__chev {
  width: 36rpx;
  height: 36rpx;
}
.part__body {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-top: 24rpx;
}
.footer {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 8rpx;
}
</style>
