  border-color: #BFE0F5;
  padding: 16rpx 22rpx;
  margin-bottom: 22rpx;
}
.packchip__icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
}
.packchip__text {
  font-size: 22rpx;
  color: #4A7FB5;
  font-weight: bold;
}
.continue {
  position: relative;
  display: flex;
  flex-direction: column;
  background-color: #FFF1E7;
  border-radius: 24rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #FFD3BC;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 0 0 #F3CFA9;;
}
.continue--done {
  background-color: #E9F7F1;
  border-color: #BFE3CD;
}
.continue__tag {
  font-size: 20rpx;
  font-weight: bold;
  color: #FF8A5C;
}
.continue__title {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A4458;
  margin-top: 12rpx;
}
.continue__meta {
  font-size: 22rpx;
  color: #7A7290;
  margin-top: 10rpx;
}
.continue__circle {
  position: absolute;
  right: 40rpx;
  top: 88rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #FF8A5C;
}
.continue__arrow {
  width: 40rpx;
  height: 40rpx;
  margin: 16rpx;
}
.continue__hint {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 14rpx;
}
.secrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.secrow__title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A4458;
}
.secrow__sub {
  font-size: 20rpx;
  color: #AFA8BD;
}

/* 篇-章两级导航 */
/* 篇 = 白色大立方体容器（头盖 + 章体一体） */
.part {
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 0 0 #EFE5D6;
  overflow: hidden;
}
.part__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}
.part__titlerow {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.part__chcount {
  font-size: 20rpx;
  font-weight: bold;
  color: #AFA8BD;
  background-color: #FBF3EB;
  border-radius: 18rpx;
  padding: 4rpx 16rpx;
  margin-left: 14rpx;
}
.part__head--open {
  border-bottom-width: 2rpx;
  border-bottom-style: dashed;
  border-bottom-color: #F5E6DA;
}
.part__left {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.part__name {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A4458;
}
.part__desc {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 6rpx;
}
.part__chev {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #FFF1E7;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  transition-property: transform;
  transition-duration: 200ms;
}
.part__chev--open {
  background-color: #FF8A5C;
}
.part__chev-img {
  width: 30rpx;
  height: 30rpx;
}
.part__body {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 24rpx 26rpx;
}
/* 章 = 各篇专属色的小立方体（2 列网格） */

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.chapter--live {
  background-color: #FFF1E7;
  border-style: solid;
  border-color: #FFD3BC;
}
.chapter__no {
  background-color: #FBF3EB;
  border-radius: 22rpx;
  padding: 8rpx 20rpx;
  align-self: flex-start;
}
.chapter__no--live {
  background-color: #FF8A5C;
}
.chapter__no-text {
  font-size: 18rpx;
  color: #AFA8BD;
  font-weight: bold;
}
.chapter__no-text--live {
  color: #FFFFFF;
}
.chapter__star {
  position: absolute;
  right: 24rpx;
  top: 26rpx;
  width: 40rpx;
  height: 40rpx;
}
.chapter__lock {
  position: absolute;
  right: 24rpx;
  top: 26rpx;
  width: 40rpx;
  height: 40rpx;
}
.chapter__name {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A4458;
  margin-top: 22rpx;
}
.chapter__name--locked {
  color: #7A7290;
}
.chapter__pact {
  font-size: 20rpx;
  color: #AFA8BD;
  margin-top: 10rpx;
  lines: 1;
  text-overflow: ellipsis;
}
.chapter__track {
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #FBF3EB;
  margin-top: 24rpx;
}
.chapter__track--live {
  background-color: #FFFFFF;
}
.chapter__fill {
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #AFA8BD;
}
.chapter__fill--live {
  background-color: #FF8A5C;
}
.chapter__count {
  font-size: 22rpx;
  font-weight: bold;
  color: #AFA8BD;
  align-self: flex-end;
  margin-top: -30rpx;
}
.chapter__count--live {
  color: #FF8A5C;
}
.footer {
  font-size: 20rpx;
  color: #AFA8BD;
  text-align: center;
  margin-top: 8rpx;
}
</style>
