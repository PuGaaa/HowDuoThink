  display: flex;
  flex-direction: column;
}
.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 28rpx;
}
.header__avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #E9F7F1;
  border-width: 2rpx;
  border-style: solid;
  border-color: #5FC9A5;
}
.header__avatar {
  width: 96rpx;
  height: 96rpx;
}
