# 好多星 server 配置模板 —— 唯一允许进 git 的 env 文件
# 用法：cp .env.example .env 然后填真实值；真实 .env / .env.* 一律 gitignore
# 环境约定（三套环境共用这份键名，只有值不同）：
#   dev     本地开发   文件名 .env.dev.local，由 dev.sh 自动 source
#   staging 测试/预发  测试机部署目录里的 .env
#   prod    生产       生产机部署目录里的 .env

# —— 环境标识（测试/生产绝不填 dev：dev 会打开 /api/dev/login 提权后门）——
ENV=staging

# —— 会话与管理员 ——
JWT_SECRET=           # 每个环境独立随机值，绝不复用：openssl rand -hex 32
ADMIN_PASSWORD=       # 首次启动自动建管理员；生产环境只在库里无管理员时生效
COOKIE_SECURE=1       # 走 HTTPS 设 1，会话 cookie 仅经 HTTPS 传输

# —— 数据库（MySQL 五项）——
DB_PROVIDER=mysql
MYSQL_HOST=mysql      # compose 部署固定填服务名；本地 dev 填 127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hdx
MYSQL_PASSWORD=
MYSQL_DATABASE=hdx    # 测试环境建议 hdt_staging，与生产库物理分开

# —— AI：对话/起草 = DeepSeek ——
DEEPSEEK_API_KEY=     # 测试环境可用独立的小额 key，便于限额与作废轮换
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-chat

# —— 向量化：默认本地 fastembed，可切 zhipu ——
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# FASTEMBED_CACHE_DIR 由 Dockerfile 固化，无需在此设置
# ZHIPU_API_KEY=      # 仅 EMBED_PROVIDER=zhipu 时需要

# —— Web 端与部署 ——
WEB_ORIGIN=           # 测试填预发域名，生产填正式域名，如 https://hdx.com
API_PORT=8001         # 宿主机侧端口：同机跑两套时错开（测试 8002 / 生产 8001）
