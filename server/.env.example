# 好多星 server 配置模板 —— 唯一允许进 git 的 env 文件
# 用法：cp .env.example .env 然后填真实值；真实 .env / .env.* 一律 gitignore
# 环境约定（三套环境共用这份键名，只有值不同）：
#   dev     本地开发   文件名 .env.dev.local，由 dev.sh 自动 source
#   staging 测试/预发  测试机部署目录里的 .env
#   prod    生产       生产机部署目录里的 .env

# —— 环境标识（测试/生产绝不填 dev：dev 会打开 /api/dev/login 提权后门）——
ENV=staging

# —— 会话与来源 ——
JWT_SECRET=           # 每个环境独立随机值，绝不复用：openssl rand -hex 32
COOKIE_SECURE=1       # 走 HTTPS 设 1，会话 cookie 仅经 HTTPS 传输
WEB_ORIGIN=           # 测试填预发域名，生产填正式域名，如 https://hdx.com
ADMIN_WEB_ORIGIN=     # 仅管理端独立域名部署时需要（CORS 白名单）；随 api 同域托管则留空
API_PORT=8001         # 宿主机侧端口：同机跑两套时错开（测试 8002 / 生产 8001）

# —— 管理员 ——
# 自带初始账号 admin / HaoDuo@2026（库中无管理员时自动创建，上线前务必改密）。
# ADMIN_PASSWORD 可覆盖初始密码。
ADMIN_PASSWORD=       # 留空=用默认密码 HaoDuo@2026
# 登录防爆破：窗口内失败次数达上限即封窗（账密与短信验码共用，429）
# 运行时可在管理端「系统设置」调整（settings 表，DB 值优先于这里的环境变量默认值）
LOGIN_MAX_FAILURES=5  # 窗口内最大失败次数
LOGIN_LOCK_SECONDS=300  # 失败计数滑动的窗口（秒）

# —— 短信验证码通道 ——
# 所有环境统一使用阿里云短信 SDK；配置缺失时请求返回 503，不回显验证码
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=

# —— 数据库（MySQL 五项）——
DB_PROVIDER=mysql
MYSQL_HOST=mysql      # compose 部署固定填服务名；本地 dev 填 127.0.0.1
# 旧语义 MYSQL_PORT=3306（"连容器内 MySQL 的端口"）已变更：api 容器内由 compose 注入固定 3306（api.environment 覆盖本键），容器内不经此键
# MYSQL_PORT=3306
MYSQL_PORT=13306  # 宿主机侧映射（仅 127.0.0.1，供演练/手工备份用）
MYSQL_USER=hdx
MYSQL_PASSWORD=
MYSQL_DATABASE=hdx    # 测试环境建议 hdt_staging，与生产库物理分开

# —— AI：对话/起草 = DeepSeek ——
DEEPSEEK_API_KEY=     # 测试环境可用独立的小额 key，便于限额与作废轮换；缺省时功能降级可用
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-chat
DEEPSEEK_PRICE_IN=2   # 成本估算单价（元/百万 tokens），管理端 AI 用量页用；运行时可在管理端「系统设置」调整
DEEPSEEK_PRICE_OUT=8

# —— 向量化：默认本地 fastembed，可切 zhipu ——
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# FASTEMBED_CACHE_DIR 由 Dockerfile 固化，无需在此设置
# ZHIPU_API_KEY=      # 仅 EMBED_PROVIDER=zhipu 时需要

# —— 对象存储 OSS（素材管理，阿里云）：四项配齐素材功能才可用，缺任一 = 素材路由 503 降级 ——
OSS_ENDPOINT=         # 区域端点，如 https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=           # 建议各环境分桶物理隔离（staging 用独立测试桶），与数据库隔离同思路
OSS_ACCESS_KEY_ID=    # 用 RAM 子账号的 AK，只授予该 bucket 读写，不用主账号 AK
OSS_ACCESS_KEY_SECRET=
# OSS_KEY_PREFIX=assets        # 对象 key 前缀；同桶分环境时用它隔离（如 assets-staging）
# OSS_MAX_UPLOAD_MB=10         # 单文件上传上限（MB）

# —— 错误追踪与监控（可留空：空=关闭，运行时降级）——
SENTRY_DSN=
SENTRY_ENV=           # 缺省取 ENV 值
OPS_SNAPSHOT_INTERVAL=300   # 服务健康快照间隔（秒）
OPS_RETENTION_DAYS=30       # 快照保留天数
